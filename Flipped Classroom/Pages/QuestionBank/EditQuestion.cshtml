@page
@model Flipped_Classroom.Pages.QuestionBank.EditQuestionModel
@{
    ViewData["Title"] = "Cập nhật câu hỏi";
    var isMcq = string.Equals(Model.EditQuestion?.QuestionType, "MCQ", StringComparison.OrdinalIgnoreCase);
}

<div class="mb-4">
    <a href="/QuestionBank/QuestionList" class="text-decoration-none text-muted d-inline-flex align-items-center gap-1 small fw-medium">
        <i class="bi bi-arrow-left"></i> Quay lại danh sách
    </a>
    <h2 class="fw-bold mt-2 text-dark">Cập Nhật Câu Hỏi</h2>
    <p class="text-muted">Sửa đổi nội dung hoặc cập nhật lại đáp án chính xác cho câu hỏi này.</p>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card card-flat rounded-4 p-4">
            <form method="post" autocomplete="off" id="editQuestionForm">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <input type="hidden" asp-for="EditQuestion.Id" />

                <div class="mb-3">
                    <label asp-for="EditQuestion.NodeId" class="form-label fw-semibold text-dark">Chủ đề / Node <span class="text-danger">*</span></label>
                    <select asp-for="EditQuestion.NodeId" asp-items="Model.NodeSelectList" class="form-select" required data-val="true" data-val-required="Vui lòng chọn chủ đề.">
                        <option value="">-- Chọn chủ đề --</option>
                    </select>
                    <span asp-validation-for="EditQuestion.NodeId" class="text-danger small mt-1 d-block"></span>
                    <small class="text-muted d-block mt-1">Chọn chủ đề nơi câu hỏi này sẽ được lưu trong ngân hàng câu hỏi</small>
                </div>

                <div class="mb-3">
                    <label asp-for="EditQuestion.Content" class="form-label fw-semibold text-dark">Nội dung câu hỏi <span class="text-danger">*</span></label>
                    <textarea asp-for="EditQuestion.Content" class="form-control" rows="3" required data-val="true" data-val-required="Vui lòng nhập nội dung câu hỏi."></textarea>
                    <span asp-validation-for="EditQuestion.Content" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="EditQuestion.Category" class="form-label fw-semibold text-dark">Phân loại (Category) <span class="text-danger">*</span></label>
                        <select asp-for="EditQuestion.Category" class="form-select" required data-val="true" data-val-required="Vui lòng chọn phân loại.">
                            <option value="">-- Chọn phân loại --</option>
                            <option value="Vocabulary">Từ vựng (Vocabulary)</option>
                            <option value="Grammar">Ngữ pháp (Grammar)</option>
                            <option value="Kanji">Chữ Hán (Kanji)</option>
                            <option value="Keigo">Kính ngữ (Keigo)</option>
                            <option value="Reading">Đọc hiểu (Reading)</option>
                        </select>
                        <span asp-validation-for="EditQuestion.Category" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="EditQuestion.QuestionType" class="form-label fw-semibold text-dark">Loại câu hỏi (Type) <span class="text-danger">*</span></label>
                        <select asp-for="EditQuestion.QuestionType" class="form-select" required id="questionType" data-val="true" data-val-required="Vui lòng chọn loại câu hỏi.">
                            <option value="MCQ">Trắc nghiệm (MCQ)</option>
                            <option value="Writing">Viết (Writing)</option>
                        </select>
                        <span asp-validation-for="EditQuestion.QuestionType" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>

                <hr class="my-4 text-muted" />
                <h5 class="fw-bold mb-3 text-dark">Cập nhật Đáp án</h5>

                <div id="mcqAnswers" class="row g-3 mb-4" style="@(isMcq ? "" : "display:none")">
                    @for (int i = 0; i < Model.Options.Count; i++)
                    {
                        <div class="col-md-6">
                            <div class="card bg-light border-0 p-3 h-100">
                                <input type="hidden" asp-for="Options[i].Id" />

                                <label class="form-label fw-semibold text-dark">Đáp án @(char.ConvertFromUtf32(65 + i)) <span class="text-danger">*</span></label>
                                <input asp-for="Options[i].OptionContent" class="form-control mb-2" required data-val="true" data-val-required="Vui lòng nhập nội dung đáp án." />
                                <span asp-validation-for="Options[i].OptionContent" class="text-danger small mb-2 d-block"></span>

                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" asp-for="Options[i].IsCorrect" id="check_@i">
                                    <label class="form-check-label text-success fw-medium" for="check_@i">
                                        Đây là đáp án đúng
                                    </label>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div id="nonMcqAnswer" class="mb-4" style="@(isMcq ? "display:none" : "")">
                    <label asp-for="EditQuestion.CorrectAnswer" class="form-label fw-semibold text-dark">Đáp án tham khảo <span class="text-danger">*</span></label>
                    <textarea asp-for="EditQuestion.CorrectAnswer" class="form-control" rows="3" placeholder="Nhập đáp án mẫu / đáp án tham khảo..." data-val="true" data-val-required="Vui lòng nhập đáp án tham khảo."></textarea>
                    <span asp-validation-for="EditQuestion.CorrectAnswer" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="d-flex gap-2 justify-content-end mt-4">
                    <a href="/QuestionBank/QuestionList" class="btn btn-outline-secondary px-4">Hủy bỏ</a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-save"></i> Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card card-flat rounded-4 p-4 bg-light border-0">
            <h5 class="fw-bold mb-3 text-dark"><i class="bi bi-exclamation-triangle-fill text-warning me-1"></i> Lưu ý khi sửa</h5>
            <ul class="text-muted ps-3 mb-0" style="font-size: 0.9rem; line-height: 1.6;">
                <li class="mb-2"><strong>Trắc nghiệm (MCQ):</strong> Nhập đủ 4 đáp án A–D và chọn ít nhất một đáp án đúng.</li>
                <li class="mb-2"><strong>Viết (Writing):</strong> Chỉ cần một đáp án tham khảo, lưu vào trường CorrectAnswer.</li>
                <li class="mb-2"><strong>Dữ liệu lịch sử:</strong> Nếu câu hỏi đã được học sinh làm, việc sửa đáp án có thể ảnh hưởng báo cáo điểm cũ.</li>
                <li class="mb-2"><strong>Chủ đề:</strong> Thay đổi chủ đề sẽ di chuyển câu hỏi đến ngân hàng câu hỏi của chủ đề mới.</li>
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const typeSelect = document.getElementById('questionType');
            const mcqSection = document.getElementById('mcqAnswers');
            const nonMcqSection = document.getElementById('nonMcqAnswer');

            function toggleAnswerSections() {
                const isMcq = typeSelect.value === 'MCQ';
                mcqSection.style.display = isMcq ? '' : 'none';
                nonMcqSection.style.display = isMcq ? 'none' : '';

                mcqSection.querySelectorAll('input, textarea').forEach(el => {
                    el.disabled = !isMcq;
                    if (el.tagName === 'INPUT' && el.type !== 'hidden') {
                        el.required = isMcq && el.name.includes('OptionContent');
                    }
                });
                const correctAnswer = document.getElementById('EditQuestion_CorrectAnswer');
                if (correctAnswer) {
                    correctAnswer.disabled = isMcq;
                    correctAnswer.required = !isMcq;
                }
            }

            typeSelect.addEventListener('change', toggleAnswerSections);
            toggleAnswerSections();
        })();
    </script>
}
