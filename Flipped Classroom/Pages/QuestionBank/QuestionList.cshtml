@page
@model Flipped_Classroom.Pages.QuestionBank.QuestionListModel
@{
    ViewData["Title"] = "Ngân hàng câu hỏi";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-0 text-dark">Ngân Hàng Câu Hỏi</h2>
        <p class="text-muted mb-0">Quản lý, tìm kiếm và cập nhật câu hỏi cho các bài kiểm tra.</p>
    </div>
    <div>
        <a href="/QuestionBank/AddQuestion" class="btn btn-primary d-flex align-items-center gap-2">
            <i class="bi bi-plus-circle-fill"></i> Thêm câu hỏi mới
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-check-circle-fill text-success fs-5"></i>
        <div>@TempData["SuccessMessage"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
        <div>@TempData["ErrorMessage"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card card-flat rounded-4 p-4 mb-4">
    <form method="get" id="filterForm">
        <input type="hidden" name="CurrentPage" value="1" />

        <div class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label fw-semibold text-muted" style="font-size: 0.85rem;">Tìm kiếm nội dung</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" asp-for="SearchKeyword" class="form-control border-start-0 bg-light" placeholder="Nhập từ khóa câu hỏi..." />
                </div>
            </div>

            <div class="col-md-3">
                <label class="form-label fw-semibold text-muted" style="font-size: 0.85rem;">Loại câu hỏi (Type)</label>
                <select asp-for="QuestionType" class="form-select bg-light">
                    <option value="">Tất cả loại (All)</option>
                    <option value="MCQ">Trắc nghiệm (MCQ)</option>
                    <option value="Writing">Viết (Writing)</option>
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label fw-semibold text-muted" style="font-size: 0.85rem;">Phân loại (Category)</label>
                <select asp-for="Category" class="form-select bg-light">
                    <option value="">Tất cả (All)</option>
                    <option value="Vocabulary">Từ vựng (Vocabulary)</option>
                    <option value="Grammar">Ngữ pháp (Grammar)</option>
                    <option value="Kanji">Chữ Hán (Kanji)</option>
                    <option value="Keigo">Kính ngữ (Keigo)</option>
                    <option value="Reading">Đọc hiểu (Reading)</option>
                </select>
            </div>

            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-outline-primary w-100">
                    <i class="bi bi-filter"></i> Lọc
                </button>
                @if (!string.IsNullOrEmpty(Model.SearchKeyword) || !string.IsNullOrEmpty(Model.QuestionType) || !string.IsNullOrEmpty(Model.Category))
                {
                    <a href="/QuestionBank/QuestionList" class="btn btn-outline-secondary" title="Xóa bộ lọc">
                        <i class="bi bi-x-circle"></i>
                    </a>
                }
            </div>
        </div>
    </form>
</div>

<div class="card card-flat rounded-4 overflow-hidden mb-4">
    <div class="table-responsive">
        <table class="table align-middle table-hover mb-0">
            <thead class="table-light text-muted fw-semibold" style="font-size: 0.85rem;">
                <tr>
                    <th class="ps-4" style="width: 80px;">ID</th>
                    <th>Nội dung câu hỏi</th>
                    <th style="width: 150px;">Phân loại</th>
                    <th style="width: 150px;">Loại câu hỏi</th>
                    <th class="pe-4 text-end" style="width: 150px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Questions != null && Model.Questions.Any())
                {
                    foreach (var item in Model.Questions)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold text-dark">#@item.Id</td>
                            <td>
                                <div class="fw-semibold text-dark text-truncate" style="max-width: 400px;" title="@item.Content">
                                    @item.Content
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-info bg-opacity-10 text-info fw-semibold px-2 py-1">@item.Category</span>
                            </td>
                            <td>
                                <span class="badge bg-warning bg-opacity-10 text-dark fw-semibold px-2 py-1">@item.QuestionType</span>
                            </td>
                            <td class="pe-4 text-end">
                                <a href="/QuestionBank/EditQuestion?id=@item.Id" class="btn btn-sm btn-outline-primary px-2 rounded-2" title="Sửa">
                                    <i class="bi bi-pencil-square"></i>
                                </a>

                                <form asp-page-handler="Delete" method="post" class="d-inline">
                                    <input type="hidden" name="questionId" value="@item.Id" />
                                    <input type="hidden" name="SearchKeyword" value="@Model.SearchKeyword" />
                                    <input type="hidden" name="QuestionType" value="@Model.QuestionType" />
                                    <input type="hidden" name="Category" value="@Model.Category" />
                                    <input type="hidden" name="CurrentPage" value="@Model.CurrentPage" />

                                    <button type="submit" class="btn btn-sm btn-outline-danger px-2 rounded-2"
                                            onclick="return confirm('Bạn có chắc chắn muốn xóa câu hỏi #@item.Id không?');" title="Xóa">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="bi bi-inboxes fs-1 d-block mb-2 text-secondary opacity-50"></i>
                            Không tìm thấy câu hỏi nào phù hợp.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white border-top py-3 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
            <span class="text-muted" style="font-size: 0.9rem;">
                Hiển thị trang <strong>@Model.CurrentPage</strong> trên tổng số <strong>@Model.TotalPages</strong> trang
            </span>

            <nav aria-label="Page navigation">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-page="/QuestionBank/QuestionList"
                           asp-route-SearchKeyword="@Model.SearchKeyword"
                           asp-route-QuestionType="@Model.QuestionType"
                           asp-route-Category="@Model.Category"
                           asp-route-CurrentPage="@(Model.CurrentPage - 1)">Trước</a>
                    </li>

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-page="/QuestionBank/QuestionList"
                               asp-route-SearchKeyword="@Model.SearchKeyword"
                               asp-route-QuestionType="@Model.QuestionType"
                               asp-route-Category="@Model.Category"
                               asp-route-CurrentPage="@i">@i</a>
                        </li>
                    }

                    <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-page="/QuestionBank/QuestionList"
                           asp-route-SearchKeyword="@Model.SearchKeyword"
                           asp-route-QuestionType="@Model.QuestionType"
                           asp-route-Category="@Model.Category"
                           asp-route-CurrentPage="@(Model.CurrentPage + 1)">Sau</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>