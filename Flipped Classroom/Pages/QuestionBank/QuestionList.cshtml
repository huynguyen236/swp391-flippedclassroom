@page
@model Flipped_Classroom.Pages.QuestionBank.QuestionListModel
@{
    ViewData["Title"] = "Ngân hàng câu hỏi";
}

<style>
    .custom-curved-card {
        border-radius: 24px !important;
        border: 1px solid var(--color-outline-variant) !important;
    }
    .custom-curved-input, .custom-curved-select {
        border-radius: 14px !important;
    }
    .custom-input-group {
        border-radius: 14px !important;
        overflow: hidden;
    }
    .custom-input-group .input-group-text {
        border-top-left-radius: 14px !important;
        border-bottom-left-radius: 14px !important;
        border-right: 0 !important;
    }
    .custom-input-group .form-control {
        border-top-right-radius: 14px !important;
        border-bottom-right-radius: 14px !important;
        border-left: 0 !important;
    }
    .custom-curved-btn {
        border-radius: 14px !important;
    }
    .custom-action-btn {
        border-radius: 12px !important;
    }
</style>

<div class="container-fluid py-4">
    <!-- Hero/Header Section -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="fw-bold mb-1 text-dark" style="font-family: var(--font-heading);">Ngân hàng câu hỏi</h1>
            <p class="text-muted mb-0">Quản lý, tìm kiếm và cập nhật câu hỏi cho các bài kiểm tra và thi đánh giá.</p>
        </div>
        <div>
            <a href="/QuestionBank/AddQuestion" class="btn btn-premium-primary rounded-pill px-4 d-inline-flex align-items-center gap-2">
                <span class="material-symbols-outlined">add</span> Thêm câu hỏi mới
            </a>
        </div>
    </div>

    <!-- Alert Success/Error -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-2" role="alert">
            <span class="material-symbols-outlined text-success">check_circle</span>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-2" role="alert">
            <span class="material-symbols-outlined text-danger">warning</span>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filters Panel Card -->
    <div class="card card-flat custom-curved-card p-4 mb-4">
        <form method="get" id="filterForm">
            <input type="hidden" name="CurrentPage" value="1" />

            <div class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label fw-semibold text-muted mb-2" style="font-size: 0.85rem;">Tìm kiếm nội dung</label>
                    <div class="input-group custom-input-group" style="height: 45px;">
                        <span class="input-group-text bg-light border-end-0 text-muted" style="height: 45px;"><span class="material-symbols-outlined text-[20px]">search</span></span>
                        <input type="text" asp-for="SearchKeyword" class="form-control border-start-0 bg-light" placeholder="Nhập từ khóa câu hỏi..." style="height: 45px;" />
                    </div>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold text-muted mb-2" style="font-size: 0.85rem;">Loại câu hỏi</label>
                    <select asp-for="QuestionType" class="form-select bg-light custom-curved-select" style="height: 45px;">
                        <option value="">Tất cả loại (All)</option>
                        <option value="MCQ">Trắc nghiệm (MCQ)</option>
                        <option value="Writing">Viết (Writing)</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-semibold text-muted mb-2" style="font-size: 0.85rem;">Phân loại</label>
                    <select asp-for="Category" class="form-select bg-light custom-curved-select" style="height: 45px;">
                        <option value="">Tất cả (All)</option>
                        <option value="Vocabulary">Từ vựng (Vocabulary)</option>
                        <option value="Grammar">Ngữ pháp (Grammar)</option>
                        <option value="Kanji">Chữ Hán (Kanji)</option>
                        <option value="Keigo">Kính ngữ (Keigo)</option>
                        <option value="Reading">Đọc hiểu (Reading)</option>
                    </select>
                </div>

                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-premium-outline custom-curved-btn w-100" style="height: 45px; display: inline-flex; align-items: center; justify-content: center; gap: 0.25rem;">
                        <span class="material-symbols-outlined text-[20px]">filter_list</span> Lọc
                    </button>
                    @if (!string.IsNullOrEmpty(Model.SearchKeyword) || !string.IsNullOrEmpty(Model.QuestionType) || !string.IsNullOrEmpty(Model.Category))
                    {
                        <a href="/QuestionBank/QuestionList" class="btn btn-outline-secondary custom-curved-btn d-inline-flex align-items-center justify-content-center" title="Xóa bộ lọc" style="height: 45px; width: 45px; padding: 0;">
                            <span class="material-symbols-outlined text-[20px]">close</span>
                        </a>
                    }
                </div>
            </div>
        </form>
    </div>

    <!-- Data Display Table Card -->
    <div class="card card-flat custom-curved-card overflow-hidden mb-4">
        <div class="table-responsive">
            <table class="table align-middle table-hover mb-0">
                <thead class="bg-light text-muted uppercase">
                    <tr>
                        <th class="ps-4 py-3" style="width: 80px;">ID</th>
                        <th class="py-3">Nội dung câu hỏi</th>
                        <th class="text-center py-3" style="width: 150px;">Phân loại</th>
                        <th class="text-center py-3" style="width: 150px;">Loại</th>
                        <th class="pe-4 text-end py-3" style="width: 150px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y">
                    @if (Model.Questions != null && Model.Questions.Any())
                    {
                        foreach (var item in Model.Questions)
                        {
                            string typeBadgeClass = item.QuestionType switch
                            {
                                "MCQ" => "bg-warning bg-opacity-10 text-dark",
                                "Writing" => "bg-success bg-opacity-10 text-success",
                                _ => "bg-secondary bg-opacity-10 text-secondary"
                            };

                            string categoryBadgeClass = item.Category switch
                            {
                                "Vocabulary" => "bg-info bg-opacity-10 text-info",
                                "Grammar" => "bg-primary bg-opacity-10 text-primary",
                                "Kanji" => "bg-danger bg-opacity-10 text-danger",
                                _ => "bg-secondary bg-opacity-10 text-secondary"
                            };

                            <tr>
                                <td class="ps-4 fw-bold text-dark">#@item.Id</td>
                                <td>
                                    <div class="fw-semibold text-dark text-truncate" style="max-width: 550px;" title="@item.Content">
                                        @item.Content
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="badge @categoryBadgeClass fw-semibold px-2.5 py-1" style="font-size: 11px;">
                                        @item.Category
                                    </span>
                                </td>
                                <td class="text-center">
                                    <span class="badge @typeBadgeClass fw-semibold px-2.5 py-1" style="font-size: 11px;">
                                        @item.QuestionType
                                    </span>
                                </td>
                                <td class="pe-4 text-end">
                                    <div class="d-inline-flex gap-2">
                                        <a href="/QuestionBank/EditQuestion?id=@item.Id" class="p-2 custom-action-btn bg-primary-fixed text-primary hover:bg-primary/10 transition-colors d-inline-flex align-items-center justify-content-center border-0" title="Chỉnh sửa" style="text-decoration: none;">
                                            <span class="material-symbols-outlined text-[18px]">edit_square</span>
                                        </a>

                                        <form asp-page-handler="Delete" method="post" class="d-inline m-0">
                                            <input type="hidden" name="questionId" value="@item.Id" />
                                            <input type="hidden" name="SearchKeyword" value="@Model.SearchKeyword" />
                                            <input type="hidden" name="QuestionType" value="@Model.QuestionType" />
                                            <input type="hidden" name="Category" value="@Model.Category" />
                                            <input type="hidden" name="CurrentPage" value="@Model.CurrentPage" />

                                            <button type="submit" class="p-2 custom-action-btn bg-error-container text-error hover:bg-error/10 transition-colors d-inline-flex align-items-center justify-content-center border-0"
                                                    onclick="return confirm('Bạn có chắc chắn muốn xóa câu hỏi #@item.Id không?');" title="Xóa">
                                                <span class="material-symbols-outlined text-[18px]">delete</span>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <div class="d-flex flex-col flex-column align-items-center justify-content-center py-4">
                                    <div class="w-16 h-16 bg-light rounded-circle d-flex align-items-center justify-content-center text-muted mb-3" style="width: 64px; height: 64px; background-color: var(--color-surface-container-low) !important;">
                                        <span class="material-symbols-outlined text-[36px] opacity-40">inbox</span>
                                    </div>
                                    <h5 class="text-muted fw-bold mb-1">Không tìm thấy câu hỏi</h5>
                                    <p class="text-muted small mb-0">Không có câu hỏi nào khớp với bộ lọc tìm kiếm hiện tại.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination Controls -->
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white border-top py-3 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
                <span class="text-muted small">
                    Hiển thị trang <strong>@Model.CurrentPage</strong> trên tổng số <strong>@Model.TotalPages</strong> trang
                </span>

                <nav aria-label="Page navigation">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                            <a class="page-link" asp-page="/QuestionBank/QuestionList"
                               asp-route-SearchKeyword="@Model.SearchKeyword"
                               asp-route-QuestionType="@Model.QuestionType"
                               asp-route-Category="@Model.Category"
                               asp-route-CurrentPage="@(Model.CurrentPage - 1)">Trước</a>
                        </li>

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-page="/QuestionBank/QuestionList"
                                   asp-route-SearchKeyword="@Model.SearchKeyword"
                                   asp-route-QuestionType="@Model.QuestionType"
                                   asp-route-Category="@Model.Category"
                                   asp-route-CurrentPage="@i">@i</a>
                            </li>
                        }

                        <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" asp-page="/QuestionBank/QuestionList"
                               asp-route-SearchKeyword="@Model.SearchKeyword"
                               asp-route-QuestionType="@Model.QuestionType"
                               asp-route-Category="@Model.Category"
                               asp-route-CurrentPage="@(Model.CurrentPage + 1)">Sau</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>