@using System.Security.Claims
@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isAdmin = User.IsInRole("Admin");
    var showSidebar = isAuthenticated && (ViewData["HideSidebar"] is not bool hideSidebar || !hideSidebar);

    string displayName = string.Empty;
    string displayInitial = "?";
    string userRole = string.Empty;

    if (isAuthenticated)
    {
        displayName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? string.Empty;
        displayInitial = !string.IsNullOrWhiteSpace(displayName)
            ? displayName.Substring(0, 1).ToUpper()
            : "?";
        userRole = User.FindFirst(ClaimTypes.Role)?.Value ?? string.Empty;
    }

    var displayRole = userRole switch
    {
        "Admin" => "Quản trị viên",
        "Manager" => "Quản lý",
        "Teacher" => "Giảng viên",
        "Student" => "Học viên",
        "Support" => "Hỗ trợ",
        _ => userRole
    };
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Flipped Classroom</title>
    
    <!-- CSS Core & Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Premium Google Fonts (Outfit & Inter) & Material Symbols -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/japanese-analyzer.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FlippedClassroom.styles.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @if (showSidebar)
    {
        <!-- Sidebar Navigation -->
        <aside class="admin-sidebar" id="sidebar">
            <div class="sidebar-brand">
                <a href="/Index" class="text-decoration-none">
                    <span class="sidebar-brand-text">
                        <i class="bi bi-mortarboard-fill text-primary"></i>
                        <span class="brand-text-label"> Nihongo Portal</span>
                    </span>
                </a>
            </div>
            
            <div class="sidebar-menu">
                <!-- Shared Home Page -->
                <a href="/Index" class="sidebar-link @(Context.Request.Path == "/Index" || Context.Request.Path == "/" ? "active" : "")">
                    <i class="bi bi-house-door-fill"></i>
                    <span>Trang chủ</span>
                </a>

                @if (isAdmin)
                {
                    <div class="sidebar-section-title">Hệ thống</div>
                    
                    <a href="/Admin/Dashboard" class="sidebar-link @(Context.Request.Path.StartsWithSegments("/Admin/Dashboard") ? "active" : "")">
                        <i class="bi bi-grid-1x2-fill"></i>
                        <span>Dashboard</span>
                    </a>
                    <a href="/Admin/Users" class="sidebar-link @(Context.Request.Path.StartsWithSegments("/Admin/Users") ? "active" : "")">
                        <i class="bi bi-people-fill"></i>
                        <span>Quản lý tài khoản</span>
                    </a>
                }

                @if (User.IsInRole("Manager"))
                {
                    <div class="sidebar-section-title">Quản lý đào tạo</div>


                    <a href="/QuestionBank/QuestionList" class="sidebar-link @(Context.Request.Path.StartsWithSegments("/QuestionBank/QuestionList") ? "active" : "")">
                        <i class="bi bi-book-fill"></i>
                        <span>Ngân hàng câu hỏi</span>
                    </a>      
                    <a href="/Curriculum" class="sidebar-link @(Context.Request.Path.StartsWithSegments("/Curriculum") ? "active" : "")">
                        <i class="bi bi-diagram-3-fill"></i>
                        <span>Quản lý khung chương trình</span>
                    </a>
                    <a href="/Quizzes/Randomize" class="sidebar-link @(Context.Request.Path.StartsWithSegments("/Quizzes/Randomize") ? "active" : "")">
                        <i class="bi bi-shuffle"></i>
                        <span>Tạo quiz ngẫu nhiên</span>
                    </a>
                    <a href="/Quizzes/MistakeStats" class="sidebar-link @(Context.Request.Path.StartsWithSegments("/Quizzes/MistakeStats") ? "active" : "")">
                        <i class="bi bi-clipboard-data-fill"></i>
                        <span>Thống kê lỗi sai</span>
                    </a>
                    <a href="/Classrooms" class="sidebar-link @(Context.Request.Path.StartsWithSegments("/Classrooms") ? "active" : "")">

                        <i class="bi bi-journal-bookmark-fill"></i>
                        <span>Quản lý lớp học</span>
                    </a>
                    <a href="/Schedules" class="sidebar-link @(Context.Request.Path.StartsWithSegments("/Schedules") ? "active" : "")">
                        <i class="bi bi-calendar-week-fill"></i>
                        <span>Quản lý lịch học</span>
                    </a>
                }
                @if (User.IsInRole("Teacher"))
                {
                    <div class="sidebar-section-title">Quản lý đào tạo</div>

                    <a href="/TeacherClasses" class="sidebar-link @(Context.Request.Path.StartsWithSegments("/TeacherClasses") ? "active" : "")">
                        <i class="bi bi-journal-bookmark-fill"></i>
                        <span>Lớp học của tôi</span>
                    </a>
                    <a href="/Quizzes/Randomize" class="sidebar-link @(Context.Request.Path.StartsWithSegments("/Quizzes/Randomize") ? "active" : "")">
                        <i class="bi bi-shuffle"></i>
                        <span>Tạo quiz ngẫu nhiên</span>
                    </a>
                    <a href="/Quizzes/MistakeStats" class="sidebar-link @(Context.Request.Path.StartsWithSegments("/Quizzes/MistakeStats") ? "active" : "")">
                        <i class="bi bi-clipboard-data-fill"></i>
                        <span>Thống kê lỗi sai</span>
                    </a>
                }

                @if (User.IsInRole("Student"))
                {
                    <div class="sidebar-section-title">Học tập</div>
                    
                    <a href="/StudentClasses/Index" class="sidebar-link @(Context.Request.Path.StartsWithSegments("/StudentClasses/Index") ? "active" : "")">
                        <i class="bi bi-mortarboard-fill"></i>
                        <span>Lớp học của tôi</span>
                    </a>
                    <a href="/StudentClasses/Schedule" class="sidebar-link @(Context.Request.Path.StartsWithSegments("/StudentClasses/Schedule") ? "active" : "")">
                        <i class="bi bi-calendar-event-fill"></i>
                        <span>Lịch học</span>
                    </a>
                    <a href="/Quizzes/Available" class="sidebar-link @(Context.Request.Path.StartsWithSegments("/Quizzes/Available") ? "active" : "")">
                        <i class="bi bi-ui-checks-grid"></i>
                        <span>Bài test</span>
                    </a>
                    <a href="/Quizzes/DailyReview" class="sidebar-link @(Context.Request.Path.StartsWithSegments("/Quizzes/DailyReview") ? "active" : "")">
                        <i class="bi bi-calendar-check-fill"></i>
                        <span>Daily Review</span>
                    </a>
                }

                <div class="sidebar-section-title">Cá nhân</div>
                <a asp-page="/Users/Profile" class="sidebar-link @(Context.Request.Path.StartsWithSegments("/Users/Profile") ? "active" : "")">
                    <i class="bi bi-person-fill-gear"></i>
                    <span>Hồ sơ cá nhân</span>
                </a>
                <a href="javascript:void(0)" class="sidebar-link sidebar-collapse-btn" id="sidebarCollapse">
                    <i class="bi bi-chevron-bar-left sidebar-collapse-icon"></i>
                    <span>Thu gọn menu</span>
                </a>
            </div>

            <div class="sidebar-footer">
                <div class="d-flex align-items-center gap-2">
                    <div class="navbar-user-avatar bg-primary text-white">
                        @displayInitial
                    </div>
                    <div class="overflow-hidden">
                        <div class="fw-semibold sidebar-user-name text-truncate" style="font-size: 0.875rem;">@displayName</div>
                        <div class="sidebar-user-role text-truncate" style="font-size: 0.75rem;">@displayRole</div>
                    </div>
                </div>
            </div>
        </aside>

        <!-- Main Wrapper -->
        <div class="admin-wrapper">
            <!-- Top Navbar -->
            <header class="admin-navbar">
                <div class="d-flex align-items-center gap-3">
                    <button class="sidebar-toggle-btn" id="sidebarToggle">
                        <i class="bi bi-list"></i>
                    </button>
                    <h5 class="mb-0 fw-bold d-none d-sm-block text-dark">Hệ thống Flipped Classroom</h5>
                </div>
                
                <div class="d-flex align-items-center gap-3">
                    <span class="text-muted d-none d-md-inline" style="font-size: 0.875rem;">
                        Vai trò: <strong class="text-primary">@displayRole</strong>
                    </span>
                    <form asp-page="/Authentication/Logout" method="post" class="d-inline">
                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3 d-flex align-items-center gap-1">
                            <i class="bi bi-box-arrow-right"></i> Đăng xuất
                        </button>
                    </form>
                </div>
            </header>

            <!-- Main Content -->
            <main class="@(ViewData["IsFullWidth"] is bool isFullWidth && isFullWidth ? "" : "admin-content")">
                @RenderBody()
            </main>
        </div>
    }
    else
    {
        <!-- Standard Layout (No sidebar, used for Landing Page / Auth / Public) -->
        <header>
            <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom navbar-clean">
                <div class="container">
                    <a class="navbar-brand fw-bold" asp-area="" asp-page="/Index">
                        <span>Nihongo</span>
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/Index">Home</a>
                            </li>
                        </ul>
                        <ul class="navbar-nav ms-auto align-items-center">
                            @if (isAuthenticated)
                            {
                                <li class="nav-item dropdown me-1">
                                    <a class="nav-link dropdown-toggle d-flex align-items-center gap-2 text-dark"
                                       href="#" id="userDropdown" role="button"
                                       data-bs-toggle="dropdown" aria-expanded="false">
                                        <span class="navbar-avatar">
                                            @displayInitial
                                        </span>
                                        <span class="fw-medium d-none d-md-inline">@displayName</span>
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0" aria-labelledby="userDropdown">
                                        <li>
                                            <a class="dropdown-item py-2 d-flex align-items-center gap-2"
                                               href="/Index">
                                                🖥️ Portal Dashboard
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider my-1" /></li>
                                        <li>
                                            <a class="dropdown-item py-2 d-flex align-items-center gap-2"
                                               asp-page="/Users/Profile">
                                                👤 My Profile
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider my-1" /></li>
                                        <li>
                                            <form asp-page="/Authentication/Logout" method="post" class="d-inline w-100">
                                                <button type="submit" class="dropdown-item py-2 d-flex align-items-center gap-2 text-danger">
                                                    🚪 Logout
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="btn btn-primary btn-sm px-4 rounded-pill shadow-sm" asp-area="" asp-page="/Authentication/Login">Login</a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </nav>
        </header>

        <main role="main">
            @if (ViewData["IsFullWidth"] != null && ViewData["IsFullWidth"] is bool isFullWidth && isFullWidth)
            {
                @RenderBody()
            }
            else
            {
                <div class="container py-4">
                    @RenderBody()
                </div>
            }
        </main>

        <footer class="footer-clean bg-light border-top mt-5">
            <div class="container py-4">
                <div class="row">
                    <div class="col-md-6">
                        <p class="text-muted mb-0">&copy; 2026 - Flipped Classroom</p>
                    </div>
                    <div class="col-md-6 text-end">
                        <a asp-area="" asp-page="/Privacy" class="text-muted text-decoration-none">Privacy</a>
                    </div>
                </div>
            </div>
        </footer>
    }

    @* ── Japanese Language Analyzer Extension ── *@
    @if (isAuthenticated)
    {
        <button class="jp-analyzer-fab" id="jpAnalyzerFab" title="Công cụ phân tích ngữ pháp">
            <i class="bi bi-translate"></i>
        </button>

        <div class="jp-analyzer-overlay" id="jpAnalyzerOverlay"></div>

        <div class="jp-analyzer-panel" id="jpAnalyzerPanel">
            <div class="jp-analyzer-header">
                <h6 class="mb-0 fw-bold">
                    <i class="bi bi-translate me-2 text-primary"></i>Phân tích ngữ pháp
                </h6>
                <button class="jp-analyzer-close" title="Đóng">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="jp-analyzer-tabs">
                <button class="jp-analyzer-tab active" data-tab="tabSentence">
                    <i class="bi bi-scissors me-1"></i>Tách Câu
                </button>
                <button class="jp-analyzer-tab" data-tab="tabWord">
                    <i class="bi bi-diagram-3 me-1"></i>Phân Tích Từ
                </button>
            </div>

            <div class="jp-analyzer-body">
                @* ── Tab 1: Sentence Splitter ── *@
                <div class="jp-analyzer-tab-content active" id="tabSentence">
                    <div class="jp-analyzer-input">
                        <label class="form-label fw-semibold mb-2">
                            <i class="bi bi-chat-square-text me-1"></i>Nhập câu tiếng Nhật
                        </label>
                        <textarea id="jpInputSplit" rows="3"
                                  placeholder="例: 私は毎日学校に行きます"></textarea>
                    </div>
                    <button class="jp-analyzer-btn" id="jpBtnSplit">
                        <span class="jp-btn-text"><i class="bi bi-play-fill me-1"></i>Tách câu</span>
                    </button>
                    <div class="jp-analyzer-results" id="jpResultsSplit">
                        <div class="jp-analyzer-empty">
                            <div><i class="bi bi-scissors"></i></div>
                            <p>Nhập một câu tiếng Nhật và bấm "Tách câu"</p>
                        </div>
                    </div>
                </div>

                @* ── Tab 2: Word Analyzer ── *@
                <div class="jp-analyzer-tab-content" id="tabWord">
                    <div class="jp-analyzer-input">
                        <label class="form-label fw-semibold mb-2">
                            <i class="bi bi-journal-text me-1"></i>Nhập động từ / tính từ (thể nguyên thể)
                        </label>
                        <textarea id="jpInputWord" rows="2"
                                  placeholder="例: 食べる、書く、高い、静か"></textarea>
                    </div>
                    <button class="jp-analyzer-btn" id="jpBtnAnalyze">
                        <span class="jp-btn-text"><i class="bi bi-play-fill me-1"></i>Phân tích</span>
                    </button>
                    <div class="jp-analyzer-results" id="jpResultsWord">
                        <div class="jp-analyzer-empty">
                            <div><i class="bi bi-diagram-3"></i></div>
                            <p>Nhập động từ hoặc tính từ rồi bấm "Phân tích"</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @if (isAuthenticated)
    {
        <script src="~/js/japanese-analyzer.js" asp-append-version="true"></script>
    }

    @if (showSidebar)
    {
        <script>
            // Sidebar Toggle Script for Mobile
            const sidebar = document.getElementById('sidebar');
            const sidebarToggle = document.getElementById('sidebarToggle');
            const sidebarCollapse = document.getElementById('sidebarCollapse');
            
            if (sidebarToggle) {
                sidebarToggle.addEventListener('click', (e) => {
                    e.stopPropagation();
                    sidebar.classList.toggle('show');
                });
            }
            
            if (sidebarCollapse) {
                sidebarCollapse.addEventListener('click', (e) => {
                    e.stopPropagation();
                    sidebar.classList.toggle('collapsed');
                    
                    const label = sidebarCollapse.querySelector('span');
                    if (label) {
                        label.textContent = sidebar.classList.contains('collapsed') 
                            ? 'Mở rộng' 
                            : 'Thu gọn menu';
                    }
                });
            }
            
            // Click outside sidebar on mobile to close it
            document.addEventListener('click', (e) => {
                if (window.innerWidth < 992) {
                    if (!sidebar.contains(e.target) && e.target !== sidebarToggle && !sidebarToggle.contains(e.target)) {
                        sidebar.classList.remove('show');
                    }
                }
            });
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
