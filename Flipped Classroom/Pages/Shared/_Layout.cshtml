@using Flipped_Classroom.Data
@using Flipped_Classroom.Models
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@inject Swp391NihongoContext Db
@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    User? currentUser = null;
    string displayName = string.Empty;
    string displayInitial = "?";

    if (isAuthenticated)
    {
        var userIdValue = User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (int.TryParse(userIdValue, out var userId))
        {
            currentUser = await Db.Users.AsNoTracking().FirstOrDefaultAsync(u => u.Id == userId);
        }

        var fullName = string.Join(" ", new[] { currentUser?.FirstName, currentUser?.LastName }
            .Where(part => !string.IsNullOrWhiteSpace(part)));
        displayName = string.IsNullOrWhiteSpace(fullName) ? currentUser?.Username ?? string.Empty : fullName;
        displayInitial = !string.IsNullOrWhiteSpace(displayName)
            ? displayName.Substring(0, 1).ToUpper()
            : "?";
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Flipped Classroom</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Flipped_Classroom.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom navbar-clean">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-area="" asp-page="/Index">
                    <span>Nihongo</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Index">Home</a>
                        </li>
                        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/Classrooms/Index">Classrooms</a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav ms-auto align-items-center">
                        @if (isAuthenticated && currentUser != null)
                        {
                            <li class="nav-item dropdown me-1">
                                <a class="nav-link dropdown-toggle d-flex align-items-center gap-2 text-dark"
                                   href="#" id="userDropdown" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="navbar-avatar">
                                        @displayInitial
                                    </span>
                                    <span class="fw-medium d-none d-md-inline">@displayName</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0" aria-labelledby="userDropdown">
                                    <li>
                                        <a class="dropdown-item py-2 d-flex align-items-center gap-2"
                                           asp-page="/Profile/Index">
                                            👤 My Profile
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider my-1" /></li>
                                    <li>
                                        <form asp-page="/Authentication/Logout" method="post" class="d-inline w-100">
                                            <button type="submit" class="dropdown-item py-2 d-flex align-items-center gap-2 text-danger">
                                                🚪 Logout
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm px-4 rounded-pill shadow-sm" asp-area="" asp-page="/Authentication/Login">Login</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @if (ViewData["IsFullWidth"] != null && ViewData["IsFullWidth"] is bool isFullWidth && isFullWidth)
        {
            @RenderBody()
        }
        else
        {
            <div class="container-custom py-4">
                @RenderBody()
            </div>
        }
    </main>

    <footer class="footer-clean bg-light border-top mt-5">
        <div class="container py-4">
            <div class="row">
                <div class="col-md-6">
                    <p class="text-muted mb-0">&copy; 2026 - Flipped Classroom</p>
                </div>
                <div class="col-md-6 text-end">
                    <a asp-area="" asp-page="/Privacy" class="text-muted text-decoration-none">Privacy</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
