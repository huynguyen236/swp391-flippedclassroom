@page
@model Flipped_Classroom.Pages.StudentClasses.DetailsModel

@{
    ViewData["Title"] = "Classroom Details";
}



<div class="container py-5 student-details-container">
    <div class="row justify-content-center">
        <div class="col-lg-12">
            
            <!-- Breadcrumbs -->
            <div class="d-flex align-items-center gap-2 mb-3 text-secondary small">
                <a asp-page="./Index" class="text-secondary text-decoration-none hover-text-primary">Lớp học của tôi</a>
                <span class="material-symbols-outlined" style="font-size:16px;">chevron_right</span>
                <span class="text-dark fw-medium">Chi tiết lớp học</span>
            </div>

            <!-- Hero Class Header Section -->
            <div class="hero-header-banner p-4 p-md-5 mb-4 rounded-3 d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-4">
                <div class="hero-header-decor"></div>
                <div class="relative z-1">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge bg-white text-primary rounded-pill px-3 py-1.5 shadow-sm small fw-bold">@Html.DisplayFor(model => model.Class.Status)</span>
                    </div>
                    <h2 class="fw-bold mb-2 text-white" style="font-size: 2rem;">@Html.DisplayFor(model => model.Class.ClassName)</h2>
                    <p class="mb-0 text-white-50" style="max-width: 600px;">
                        @(string.IsNullOrEmpty(Model.Class.Description) ? "Chưa có mô tả cho lớp học này." : Model.Class.Description)
                    </p>
                </div>
                <div class="glass-card-premium shrink-0 relative z-1">
                    <span class="text-white-50 small text-uppercase tracking-wider">Hệ thống học tập</span>
                    <div class="d-flex align-items-center justify-content-center gap-2 bg-white text-dark px-3 py-2 rounded-2 mt-2 border">
                        <strong class="text-primary font-monospace" style="font-size: 1.1rem;">Nihongo Portal</strong>
                    </div>
                </div>
            </div>

            <!-- Date and Manager Info Card -->
            <div class="card card-premium p-4 mb-4">
                <div class="row g-3 align-items-center">
                    <div class="col-md-4">
                        <div class="d-flex align-items-center p-3 rounded" style="background-color: var(--color-surface-container-low);">
                            <span class="material-symbols-outlined text-primary fs-3 me-3">calendar_today</span>
                            <div>
                                <div class="text-muted small">Ngày Bắt Đầu</div>
                                <div class="fw-bold text-dark">@Model.Class.StartDate?.ToString("dd/MM/yyyy")</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="d-flex align-items-center p-3 rounded" style="background-color: var(--color-surface-container-low);">
                            <span class="material-symbols-outlined text-primary fs-3 me-3">event_available</span>
                            <div>
                                <div class="text-muted small">Ngày Kết Thúc</div>
                                <div class="fw-bold text-dark">@Model.Class.EndDate?.ToString("dd/MM/yyyy")</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="d-flex align-items-center p-3 rounded" style="background-color: var(--color-surface-container-low);">
                            <span class="material-symbols-outlined text-primary fs-3 me-3">person</span>
                            <div>
                                <div class="text-muted small">Người Quản Lý</div>
                                <div class="fw-bold text-dark">@Html.DisplayFor(model => model.Class.Manager.Username)</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sticky Menu Tabs Navigation -->
            <ul class="nav nav-tabs nav-tabs-premium mb-4" id="classroomTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="learning-path-tab" data-bs-toggle="tab" data-bs-target="#learning-path-content" type="button" role="tab" aria-controls="learning-path-content" aria-selected="true">
                        <span class="material-symbols-outlined">route</span> Lộ Trình Học
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="students-tab" data-bs-toggle="tab" data-bs-target="#students-content" type="button" role="tab" aria-controls="students-content" aria-selected="false">
                        <span class="material-symbols-outlined">group</span> Học Viên (@(Model.Class.ClassMembers?.Count ?? 0))
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="assignments-tab" data-bs-toggle="tab" data-bs-target="#assignments-content" type="button" role="tab" aria-controls="assignments-content" aria-selected="false">
                        <span class="material-symbols-outlined">assignment</span> Bài Tập
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="qa-tab" data-bs-toggle="tab" data-bs-target="#qa-content" type="button" role="tab" aria-controls="qa-content" aria-selected="false">
                        <span class="material-symbols-outlined">forum</span> Hỏi & Đáp (@(Model.QaThreads?.Count ?? 0))
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="schedule-tab" data-bs-toggle="tab" data-bs-target="#schedule-content" type="button" role="tab" aria-controls="schedule-content" aria-selected="false">
                        <span class="material-symbols-outlined">calendar_month</span> Lịch Học
                    </button>
                </li>
            </ul>

            <!-- Tab Content -->
            <div class="tab-content" id="classroomTabContent">
                <!-- Learning Path Tab -->
                <div class="tab-pane fade show active" id="learning-path-content" role="tabpanel" aria-labelledby="learning-path-tab">
                    <div class="card card-premium">
                        <div class="card-premium-header d-flex justify-content-between align-items-center flex-wrap gap-3">
                            <h4 class="fw-bold mb-0 text-primary d-flex align-items-center gap-2">
                                <span class="material-symbols-outlined">route</span> Lộ Trình Học
                            </h4>
                            @if (Model.Class.Curriculum != null)
                            {
                                <span class="badge bg-light text-primary rounded-pill px-3 py-2 border">@Model.Class.Curriculum.CurriculumName</span>
                            }
                        </div>
                        <div class="card-body p-4">
                            @if (Model.Class.Curriculum == null)
                            {
                                <div class="text-center text-muted py-5">
                                    <span class="material-symbols-outlined text-muted fs-1 mb-2 opacity-50">description</span>
                                    <h6 class="text-muted fw-bold">Lớp này chưa có khung chương trình.</h6>
                                </div>
                            }
                            else
                            {
                                var allNodes = Model.Class.Curriculum.Nodes;
                                var chapters = allNodes.Where(n => n.ParentNodeId == null).OrderBy(n => n.NodeOrder).ThenBy(n => n.Id).ToList();
 
                                if (!chapters.Any())
                                {
                                    <div class="text-center text-muted py-5">
                                        <span class="material-symbols-outlined text-muted fs-1 mb-2 opacity-50">description</span>
                                        <h6 class="text-muted fw-bold">Khung chương trình chưa có bài học nào.</h6>
                                    </div>
                                }
                                else
                                {
                                    <div class="accordion" id="learningPathAccordion">
                                        @for (int i = 0; i < chapters.Count; i++)
                                        {
                                            var chapter = chapters[i];
                                            var lessons = allNodes.Where(n => n.ParentNodeId == chapter.Id).OrderBy(n => n.NodeOrder).ThenBy(n => n.Id).ToList();
                                            var collapseId = $"lp-collapse-{chapter.Id}";
                                            var headingId = $"lp-heading-{chapter.Id}";
                                            var chapterUnlocked = Model.NodeUnlockStatus.TryGetValue(chapter.Id, out var cu) && cu;
 
                                            <div class="accordion-item border mb-3 shadow-sm" style="border-radius: var(--radius-sm); overflow: hidden; border-color: var(--color-outline-variant) !important;">
                                                <h2 class="accordion-header" id="@headingId">
                                                    <button class="accordion-button @(i == 0 ? "" : "collapsed") fw-bold bg-white text-dark py-3" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="@(i == 0 ? "true" : "false")" aria-controls="@collapseId">
                                                        <span class="material-symbols-outlined text-warning me-2" style="font-size: 22px;">folder</span> @chapter.Title
                                                    </button>
                                                </h2>
                                                <div id="@collapseId" class="accordion-collapse collapse @(i == 0 ? "show" : "")" aria-labelledby="@headingId" data-bs-parent="#learningPathAccordion">
                                                    <div class="accordion-body p-0 bg-white border-top">
                                                        @{
                                                            var chapterQuizzes = chapter.Quizzes.Where(q => q.ClassId == Model.Class.Id && q.Status == "Published" && !q.IsAlwaysOpen).ToList();
                                                        }
                                                        
                                                        @if (chapterQuizzes.Any())
                                                        {
                                                            <div class="px-4 py-3 bg-light border-bottom">
                                                                <span class="fs-8 fw-bold text-secondary text-uppercase d-block mb-2" style="font-size: 0.75rem; letter-spacing: 0.5px;">Bài test chương:</span>
                                                                <div class="d-flex flex-column gap-2">
                                                                    @foreach (var quiz in chapterQuizzes)
                                                                    {
                                                                        <div class="d-flex align-items-center justify-content-between py-2 border-bottom border-light">
                                                                            <div class="d-flex align-items-center gap-2">
                                                                                <span class="material-symbols-outlined text-warning" style="font-size: 20px;">assignment_turned_in</span>
                                                                                <div>
                                                                                    <span class="fw-semibold text-dark">@quiz.Title</span>
                                                                                    <span class="text-muted small d-block">@quiz.DurationMinutes phút | @quiz.QuizQuestions.Count câu</span>
                                                                                </div>
                                                                            </div>
                                                                            @if (chapterUnlocked)
                                                                            {
                                                                                <a asp-page="/Quizzes/Take" asp-route-id="@quiz.Id" class="btn btn-sm btn-outline-warning rounded-pill px-3 d-flex align-items-center gap-1">
                                                                                    Làm bài <span class="material-symbols-outlined" style="font-size: 14px;">play_arrow</span>
                                                                                </a>
                                                                            }
                                                                            else
                                                                            {
                                                                                <button type="button" class="btn btn-sm btn-secondary rounded-pill px-3 d-flex align-items-center gap-1" disabled>
                                                                                    <span class="material-symbols-outlined" style="font-size: 14px;">lock</span> Đang khóa
                                                                                </button>
                                                                            }
                                                                        </div>
                                                                    }
                                                                </div>
                                                            </div>
                                                        }

                                                        @if (!lessons.Any() && !chapterQuizzes.Any())
                                                        {
                                                            <p class="text-muted text-center py-4 mb-0 small">Chương này chưa có bài học hoặc bài test.</p>
                                                        }
                                                        else if (lessons.Any())
                                                        {
                                                            <ul class="list-group list-group-flush">
                                                                @foreach (var lesson in lessons)
                                                                {
                                                                    var isUnlocked = chapterUnlocked;
                                                                    var isCompleted = Model.NodeCompletionStatus.TryGetValue(lesson.Id, out var c) && c;
                                                                    var lessonQuizzes = lesson.Quizzes.Where(q => q.ClassId == Model.Class.Id && q.Status == "Published" && !q.IsAlwaysOpen).ToList();
                                                                    
                                                                    <li class="list-group-item d-flex flex-column py-3 px-4 @(isUnlocked ? "" : "bg-light text-muted opacity-75")">
                                                                        <div class="d-flex justify-content-between align-items-center w-100">
                                                                            <div class="d-flex align-items-center gap-2">
                                                                                @if (!isUnlocked)
                                                                                {
                                                                                    <span class="material-symbols-outlined text-muted" style="font-size: 20px;">lock</span>
                                                                                }
                                                                                else if (isCompleted)
                                                                                {
                                                                                    <span class="material-symbols-outlined text-success" style="font-size: 20px;">check_circle</span>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <span class="material-symbols-outlined text-primary" style="font-size: 20px;">description</span>
                                                                                }
                                                                                <span class="fw-semibold text-dark">@lesson.Title</span>
                                                                                @if (isCompleted)
                                                                                {
                                                                                    <span class="badge bg-success-subtle text-success rounded-pill px-2.5 py-1">Đã học</span>
                                                                                }
                                                                                @if (lesson.Materials.Any())
                                                                                {
                                                                                    <span class="badge bg-light text-secondary border rounded-pill px-2.5 py-1">@lesson.Materials.Count tài liệu</span>
                                                                                }
                                                                            </div>
                                                                            
                                                                            <div>
                                                                                @if (isUnlocked)
                                                                                {
                                                                                    <a asp-page="./Lesson" asp-route-classId="@Model.Class.Id" asp-route-nodeId="@lesson.Id"
                                                                                       class="btn btn-sm btn-primary rounded-pill px-3 py-1.5 d-flex align-items-center gap-1">
                                                                                        Vào học <span class="material-symbols-outlined" style="font-size: 16px;">arrow_forward</span>
                                                                                    </a>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <button type="button" class="btn btn-sm btn-secondary rounded-pill px-3 py-1.5 d-flex align-items-center gap-1" disabled title="Bài học chưa được giáo viên mở">
                                                                                        <span class="material-symbols-outlined" style="font-size: 16px;">lock</span> Đang khóa
                                                                                    </button>
                                                                                }
                                                                            </div>
                                                                        </div>

                                                                        @if (lessonQuizzes.Any())
                                                                        {
                                                                            <div class="mt-3 ps-4 d-flex flex-column gap-2 border-top pt-2">
                                                                                @foreach (var quiz in lessonQuizzes)
                                                                                {
                                                                                    <div class="d-flex align-items-center justify-content-between py-2 border-bottom border-light">
                                                                                        <div class="d-flex align-items-center gap-2">
                                                                                            <span class="material-symbols-outlined text-warning" style="font-size: 20px;">assignment_turned_in</span>
                                                                                            <div>
                                                                                                <span class="fw-semibold text-dark" style="font-size: 0.9rem;">@quiz.Title</span>
                                                                                                <span class="text-muted small d-block">@quiz.DurationMinutes phút | @quiz.QuizQuestions.Count câu</span>
                                                                                            </div>
                                                                                        </div>
                                                                                        <div>
                                                                                            @if (isUnlocked)
                                                                                            {
                                                                                                <a asp-page="/Quizzes/Take" asp-route-id="@quiz.Id" class="btn btn-sm btn-outline-warning rounded-pill px-3 py-1 d-flex align-items-center gap-1">
                                                                                                    Làm bài <span class="material-symbols-outlined" style="font-size: 14px;">play_arrow</span>
                                                                                                </a>
                                                                                            }
                                                                                            else
                                                                                            {
                                                                                                <button type="button" class="btn btn-sm btn-secondary rounded-pill px-3 py-1 d-flex align-items-center gap-1" disabled>
                                                                                                    <span class="material-symbols-outlined" style="font-size: 14px;">lock</span> Đang khóa
                                                                                                </button>
                                                                                            }
                                                                                        </div>
                                                                                    </div>
                                                                                }
                                                                            </div>
                                                                        }
                                                                    </li>
                                                                }
                                                            </ul>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>

                <!-- Assignments Tab -->
                <div class="tab-pane fade" id="assignments-content" role="tabpanel" aria-labelledby="assignments-tab">
                    <div class="card card-premium">
                        <div class="card-premium-header">
                            <h4 class="fw-bold mb-0 text-primary d-flex align-items-center gap-2">
                                <span class="material-symbols-outlined">assignment</span> Danh Sách Bài Tập
                            </h4>
                        </div>
                        <div class="card-body p-4">
                            @if (TempData["SuccessMessage"] != null)
                            {
                                <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
                                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                </div>
                            }

                            @if (!ViewData.ModelState.IsValid)
                            {
                                <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
                                    <div asp-validation-summary="All" class="text-danger small"></div>
                                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                </div>
                            }

                            @if (Model.Assignments != null && Model.Assignments.Any())
                            {
                                <div class="row g-4">
                                    @foreach (var assign in Model.Assignments)
                                    {
                                        var isOverdue = assign.DueDate.HasValue && DateTime.Now > assign.DueDate.Value;
                                        <div class="col-12">
                                            <div class="card card-premium border shadow-sm p-4 rounded-3">
                                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                                                    <div>
                                                        <h5 class="fw-bold text-dark mb-1">@assign.Title</h5>
                                                        <span class="text-muted small d-flex align-items-center gap-1">
                                                            <span class="material-symbols-outlined" style="font-size: 16px;">schedule</span> Hạn nộp: 
                                                            @(assign.DueDate.HasValue ? assign.DueDate.Value.ToString("dd/MM/yyyy HH:mm") : "Không giới hạn")
                                                        </span>
                                                    </div>
                                                    <div>
                                                        @if (assign.Status == "Graded")
                                                        {
                                                            <span class="badge bg-success-subtle text-success fs-6 rounded-pill px-3 py-1.5 d-inline-flex align-items-center gap-1"><span class="material-symbols-outlined" style="font-size: 16px;">grade</span> Đã chấm điểm</span>
                                                        }
                                                        else if (assign.Status == "Submitted")
                                                        {
                                                            <span class="badge bg-primary-subtle text-primary fs-6 rounded-pill px-3 py-1.5 d-inline-flex align-items-center gap-1"><span class="material-symbols-outlined" style="font-size: 16px;">task_alt</span> Đã nộp bài</span>
                                                        }
                                                        else
                                                        {
                                                            if (isOverdue)
                                                            {
                                                                <span class="badge bg-danger-subtle text-danger fs-6 rounded-pill px-3 py-1.5 d-inline-flex align-items-center gap-1"><span class="material-symbols-outlined" style="font-size: 16px;">warning</span> Quá hạn</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-warning-subtle text-warning-emphasis fs-6 rounded-pill px-3 py-1.5 d-inline-flex align-items-center gap-1"><span class="material-symbols-outlined" style="font-size: 16px;">hourglass_empty</span> Chưa nộp</span>
                                                            }
                                                        }
                                                    </div>
                                                </div>

                                                @if (!string.IsNullOrEmpty(assign.RequirementText))
                                                {
                                                    <div class="bg-light p-3 rounded mb-3 text-secondary text-start" style="font-size: 0.95rem;">
                                                        <strong>Yêu cầu bài tập:</strong>
                                                        <p class="mb-0 mt-1 text-dark">@assign.RequirementText</p>
                                                    </div>
                                                }

                                                @if (assign.Status == "Graded")
                                                {
                                                    <div class="card border-success bg-light mb-3" style="border-radius: 8px;">
                                                        <div class="card-body p-3">
                                                            <div class="d-flex align-items-center mb-2 text-success">
                                                                <span class="material-symbols-outlined me-2" style="font-size: 20px;">stars</span>
                                                                <h6 class="fw-bold mb-0">Kết Quả Chấm Điểm</h6>
                                                            </div>
                                                            <div class="fs-4 fw-bold text-dark mb-2">Điểm số: <span class="text-primary">@assign.Score?.ToString("0.0")</span> / 10.0</div>
                                                            @if (!string.IsNullOrEmpty(assign.Feedback))
                                                            {
                                                                <div class="text-secondary small mt-1">
                                                                    <strong>Nhận xét của giảng viên:</strong>
                                                                    <p class="mb-0 italic text-dark">"@assign.Feedback"</p>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                }

                                                @if (!isOverdue && assign.Status != "Graded")
                                                {
                                                    <div class="border-top pt-3 mt-2">
                                                        <form method="post" asp-page-handler="SubmitAssignment" asp-route-id="@Model.Class.Id" enctype="multipart/form-data">
                                                            <input type="hidden" name="AssignmentId" value="@assign.AssignmentId" />
                                                            
                                                            <div class="mb-3">
                                                                <label class="form-label fw-bold text-secondary" style="font-size: 0.9rem;">
                                                                    Tải lên bài nộp (Hỗ trợ `.docx` hoặc `.mp3`, tối đa 15MB)
                                                                </label>
                                                                <input type="file" name="UploadedFile" class="form-control bg-light" accept=".docx,.mp3" required onchange="validateStudentFile(this)" />
                                                                <div class="form-text">Tải lên file bài giải của bạn.</div>
                                                            </div>

                                                            <div class="mb-3">
                                                                <label class="form-label fw-bold text-secondary" style="font-size: 0.9rem;">Ghi chú (Tùy chọn)</label>
                                                                <textarea name="ContentText" class="form-control bg-light" rows="2" placeholder="Nhập ghi chú cho giáo viên..."></textarea>
                                                            </div>

                                                            <button type="submit" class="btn btn-primary px-4 py-2">
                                                                @(assign.Status == "Submitted" ? "Nộp lại bài tập" : "Nộp bài tập")
                                                            </button>
                                                        </form>
                                                    </div>
                                                }
                                                else if (isOverdue && assign.Status != "Graded" && assign.Status != "Submitted")
                                                {
                                                    <div class="text-danger small mt-2 d-flex align-items-center gap-1">
                                                        <span class="material-symbols-outlined" style="font-size: 16px;">info</span> Đã quá hạn nộp bài. Bạn không thể nộp hoặc chỉnh sửa bài tập này nữa.
                                                    </div>
                                                }

                                                @if (assign.Status == "Submitted" || assign.Status == "Graded")
                                                {
                                                    @if (!string.IsNullOrEmpty(assign.MediaUrl))
                                                    {
                                                        <div class="mt-2 text-muted small d-flex align-items-center gap-1">
                                                            <span class="material-symbols-outlined" style="font-size: 16px;">attachment</span> File đã nộp: 
                                                            <a href="@assign.MediaUrl" target="_blank" class="text-primary text-decoration-none fw-semibold">
                                                                Tải xuống tệp nộp bài
                                                            </a>
                                                        </div>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-5 text-muted">
                                    <span class="material-symbols-outlined text-muted fs-1 mb-2 opacity-50">assignment_late</span>
                                    <h6 class="text-muted fw-bold">Chưa có bài tập nào được tạo cho lớp học này.</h6>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Students Tab -->
                <div class="tab-pane fade" id="students-content" role="tabpanel" aria-labelledby="students-tab">
                    <div class="card card-premium">
                        <div class="card-premium-header">
                            <h4 class="fw-bold mb-0 text-primary d-flex align-items-center gap-2">
                                <span class="material-symbols-outlined">group</span> Danh Sách Học Viên
                            </h4>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead>
                                        <tr class="table-light text-muted fw-semibold" style="font-size: 0.85rem;">
                                            <th class="px-4 py-3 border-0">Học Viên</th>
                                            <th class="px-4 py-3 border-0">Nhóm</th>
                                            <th class="px-4 py-3 border-0 text-center">Support Team</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.Class.ClassMembers != null && Model.Class.ClassMembers.Any())
                                        {
                                            foreach (var member in Model.Class.ClassMembers)
                                            {
                                                <tr class="border-bottom">
                                                    <td class="px-4 py-3">
                                                        <div class="d-flex align-items-center">
                                                            <div class="rounded-circle d-flex justify-content-center align-items-center text-white me-3 bg-secondary fw-bold" style="width: 35px; height: 35px; font-size: 14px; background-color: var(--color-outline) !important;">
                                                                @(member.User?.Username?.FirstOrDefault() ?? '?')
                                                            </div>
                                                            <div class="fw-semibold text-dark">@(member.User?.Username ?? "Unknown")</div>
                                                        </div>
                                                    </td>
                                                    <td class="px-4 py-3">
                                                        @{
                                                            var assignedGroup = Model.Class.Groups?.FirstOrDefault(g => g.GroupMembers.Any(gm => gm.StudentId == member.UserId));
                                                        }
                                                        <span class="badge bg-light text-dark px-3 py-2 border rounded" style="font-size: 0.8rem;">
                                                            @(assignedGroup != null ? assignedGroup.GroupName : "Chưa có nhóm")
                                                        </span>
                                                    </td>
                                                    <td class="px-4 py-3 text-center">
                                                        @if (member.IsSupportTeam == true)
                                                        {
                                                            <span class="badge bg-success-subtle text-success px-3 py-1.5 rounded-pill fw-semibold">Có</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-light text-secondary px-3 py-1.5 rounded-pill border">Không</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="3" class="text-center py-5 text-muted">
                                                    <span class="material-symbols-outlined text-muted fs-1 mb-2 opacity-50">person_off</span>
                                                    <h6 class="text-muted fw-bold">Chưa có học viên nào trong lớp</h6>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Q&A Tab -->
                <div class="tab-pane fade" id="qa-content" role="tabpanel" aria-labelledby="qa-tab">
                    <div class="card card-premium">
                        <div class="card-premium-header">
                            <h4 class="fw-bold mb-0 text-primary d-flex align-items-center gap-2">
                                <span class="material-symbols-outlined">forum</span> Hỏi & Đáp Lớp Học
                            </h4>
                        </div>
                        <div class="card-body p-4">
                            <!-- Question Submission Form -->
                            <div class="card card-premium border mb-4 shadow-sm" style="border-radius: var(--radius-sm);">
                                <div class="card-body p-3">
                                    <h6 class="fw-bold mb-3 d-flex align-items-center gap-1"><span class="material-symbols-outlined text-primary">add_comment</span> Đặt câu hỏi mới</h6>
                                    <form id="createThreadForm" method="post">
                                        @Html.AntiForgeryToken()
                                        <div class="mb-3">
                                            <textarea id="questionTextInput" class="form-control bg-light" rows="3" placeholder="Nhập câu hỏi của bạn ở đây..." required style="border-radius: 8px;"></textarea>
                                        </div>
                                        <button type="submit" class="btn btn-primary px-4 py-2 d-flex align-items-center gap-1">
                                            Đăng câu hỏi <span class="material-symbols-outlined" style="font-size: 18px;">send</span>
                                        </button>
                                    </form>
                                </div>
                            </div>

                            <!-- List of Threads -->
                            <div id="qaThreadsContainer" class="d-flex flex-column gap-4">
                                @if (Model.QaThreads != null && Model.QaThreads.Any())
                                {
                                    foreach (var thread in Model.QaThreads)
                                    {
                                        <div class="card card-premium border shadow-sm qa-thread-card" data-thread-id="@thread.Id" style="border-radius: var(--radius-sm); overflow: hidden;">
                                            <div class="card-body p-3">
                                                <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
                                                    <div class="d-flex align-items-center">
                                                        <div class="rounded-circle text-white text-center me-2 d-flex justify-content-center align-items-center bg-secondary fw-bold" style="width: 36px; height: 36px; font-size: 14px; background-color: var(--color-outline) !important;">
                                                            @(thread.Student?.Username?.FirstOrDefault() ?? '?')
                                                        </div>
                                                        <div>
                                                            <strong class="text-dark">@(thread.Student?.Username ?? "Học viên")</strong>
                                                            <div class="text-muted small" style="font-size: 0.75rem;">@thread.CreatedAt?.ToString("dd/MM/yyyy HH:mm")</div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <p class="text-dark mb-3 fw-bold" style="white-space: pre-wrap; font-size: 1.05rem;">@thread.QuestionText</p>
                                                
                                                <!-- Replies Section -->
                                                <div class="p-3 rounded" style="background-color: var(--color-surface-container-low); border-radius: 8px;">
                                                    <h6 class="fw-bold text-muted mb-2 small d-flex align-items-center gap-1"><span class="material-symbols-outlined" style="font-size: 16px;">forum</span> Câu trả lời</h6>
                                                    <div class="replies-list d-flex flex-column gap-2 mb-3" data-thread-id="@thread.Id">
                                                        @if (thread.QaReplies != null && thread.QaReplies.Any())
                                                        {
                                                            foreach (var reply in thread.QaReplies)
                                                            {
                                                                var isTeacherReply = reply.User?.Role == "Teacher" || reply.User?.Role == "Manager" || reply.User?.Role == "Admin";
                                                                <div class="border-bottom pb-2">
                                                                    <div class="d-flex align-items-center mb-1">
                                                                        <strong class="@(isTeacherReply ? "text-primary" : "text-dark") small fw-bold">
                                                                            @(reply.User?.Username ?? "User")
                                                                            @if (isTeacherReply)
                                                                            {
                                                                                <span class="badge bg-primary-subtle text-primary ms-1" style="font-size: 0.75rem;">Giáo viên</span>
                                                                            }
                                                                        </strong>
                                                                        <span class="text-muted small ms-2" style="font-size: 0.75rem;">@reply.CreatedAt?.ToString("dd/MM/yyyy HH:mm")</span>
                                                                    </div>
                                                                    <p class="mb-0 text-secondary small" style="white-space: pre-wrap;">@reply.ReplyText</p>
                                                                </div>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <p class="text-muted small mb-0 no-replies-text">Chưa có câu trả lời nào. Hãy là người đầu tiên giúp đỡ!</p>
                                                        }
                                                    </div>
                                                    
                                                    <!-- Reply Form -->
                                                    <form class="create-reply-form d-flex gap-2" data-thread-id="@thread.Id">
                                                        <input type="text" class="form-control form-control-sm reply-input bg-white" placeholder="Viết phản hồi..." required style="border-radius: 20px;" />
                                                        <button type="submit" class="btn btn-primary btn-sm rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                                            <span class="material-symbols-outlined text-white" style="font-size: 16px;">send</span>
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div id="noThreadsMessage" class="text-center py-5 text-muted bg-light rounded border">
                                        <span class="material-symbols-outlined text-muted fs-1 mb-2 opacity-50">forum</span>
                                        <h6 class="text-muted fw-bold">Chưa có chủ đề thảo luận nào. Đặt câu hỏi đầu tiên!</h6>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Schedule Tab -->
                <div class="tab-pane fade" id="schedule-content" role="tabpanel" aria-labelledby="schedule-tab">
                    <div class="card card-premium">
                        <div class="card-premium-header">
                            <h4 class="fw-bold mb-0 text-primary d-flex align-items-center gap-2">
                                <span class="material-symbols-outlined">calendar_month</span> Lịch Học Của Lớp
                            </h4>
                        </div>
                        <div class="card-body p-4">
                            @if (Model.Class.ClassSchedules != null && Model.Class.ClassSchedules.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead>
                                            <tr class="table-light text-muted fw-semibold" style="font-size: 0.85rem;">
                                                <th class="px-4 py-3 border-0">Buổi</th>
                                                <th class="px-4 py-3 border-0">Ngày học</th>
                                                <th class="px-4 py-3 border-0">Thời gian</th>
                                                <th class="px-4 py-3 border-0">Phòng học</th>
                                                <th class="px-4 py-3 border-0">Trạng thái</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{
                                                var sessionNum = 0;
                                            }
                                            @foreach (var schedule in Model.Class.ClassSchedules.OrderBy(s => s.StudyDate).ThenBy(s => s.StartTime))
                                            {
                                                sessionNum++;
                                                var isPast = schedule.StudyDate < DateOnly.FromDateTime(DateTime.Now);
                                                var isToday = schedule.StudyDate == DateOnly.FromDateTime(DateTime.Now);
                                                var dayName = Flipped_Classroom.Services.ScheduleSlotHelper.GetVietnameseDayName(schedule.StudyDate.DayOfWeek);
                                                
                                                <tr class="align-middle @(isPast ? "opacity-50" : "")">
                                                    <td class="px-4 py-3 fw-bold">Buổi @sessionNum</td>
                                                    <td class="px-4 py-3">
                                                        <div class="fw-semibold">@schedule.StudyDate.ToString("dd/MM/yyyy")</div>
                                                        <small class="text-muted">@dayName</small>
                                                    </td>
                                                    <td class="px-4 py-3 text-primary fw-semibold">
                                                        <span class="d-flex align-items-center gap-1"><span class="material-symbols-outlined" style="font-size:16px;">schedule</span> @schedule.StartTime.ToString("HH:mm") – @schedule.EndTime.ToString("HH:mm")</span>
                                                    </td>
                                                    <td class="px-4 py-3">
                                                        @if (!string.IsNullOrEmpty(schedule.Room))
                                                        {
                                                            <span class="d-flex align-items-center gap-1"><span class="material-symbols-outlined text-muted" style="font-size: 16px;">meeting_room</span> @schedule.Room</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted fst-italic d-flex align-items-center gap-1"><span class="material-symbols-outlined" style="font-size: 16px;">cast_for_education</span> Trực tuyến</span>
                                                        }
                                                    </td>
                                                    <td class="px-4 py-3">
                                                        @if (isToday)
                                                        {
                                                            <span class="badge bg-danger text-white rounded-pill px-3 py-1.5 fw-bold shadow-sm">Hôm nay</span>
                                                        }
                                                        else if (isPast)
                                                        {
                                                            <span class="badge bg-secondary text-white rounded-pill px-3 py-1.5">Đã qua</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-success text-white rounded-pill px-3 py-1.5">Sắp tới</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-5 text-muted">
                                    <span class="material-symbols-outlined text-muted fs-1 mb-2 opacity-50">calendar_today</span>
                                    <h6 class="text-muted fw-bold">Lớp học này chưa được xếp lịch học.</h6>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function validateStudentFile(input) {
            const file = input.files[0];
            if (!file) return;

            const allowedExtensions = ['.docx', '.mp3'];
            const fileName = file.name.toLowerCase();
            const isValidExt = allowedExtensions.some(ext => fileName.endsWith(ext));

            if (!isValidExt) {
                alert("Chỉ chấp nhận các tệp tin có định dạng .docx hoặc .mp3!");
                input.value = "";
                return;
            }

            const maxSize = 15 * 1024 * 1024; // 15 MB
            if (file.size > maxSize) {
                alert("Dung lượng tệp tải lên vượt quá giới hạn cho phép (Tối đa 15MB)!");
                input.value = "";
                return;
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            // Tab persistence functionality
            const tabButtons = document.querySelectorAll('[data-bs-toggle="tab"]');
            const activeTabKey = 'classroomActiveTab_' + window.location.pathname;

            // Restore active tab on page load
            const savedTab = localStorage.getItem(activeTabKey);
            if (savedTab) {
                const tabButton = document.getElementById(savedTab);
                if (tabButton) {
                    const tab = new bootstrap.Tab(tabButton);
                    tab.show();
                }
            }

            // Save active tab when changed
            tabButtons.forEach(button => {
                button.addEventListener('shown.bs.tab', function(e) {
                    localStorage.setItem(activeTabKey, this.id);
                });
            });

            // AJAX Q&A Thread Creation
            const createThreadForm = document.getElementById('createThreadForm');
            if (createThreadForm) {
                createThreadForm.addEventListener('submit', async function(e) {
                    e.preventDefault();
                    const textarea = document.getElementById('questionTextInput');
                    const text = textarea.value.trim();
                    if (!text) return;

                    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

                    const formData = new URLSearchParams();
                    formData.append('questionText', text);
                    formData.append('__RequestVerificationToken', token);

                    try {
                        const response = await fetch('?handler=CreateThread&id=@Model.Class.Id', {
                            method: 'POST',
                            headers: {
                                'RequestVerificationToken': token
                            },
                            body: formData
                        });

                        const result = await response.json();
                        if (result.success) {
                            textarea.value = '';
                            
                            const container = document.getElementById('qaThreadsContainer');
                            const noThreadsMsg = document.getElementById('noThreadsMessage');
                            if (noThreadsMsg) {
                                noThreadsMsg.remove();
                            }

                            const threadHtml = `
                                <div class="card border shadow-sm qa-thread-card" data-thread-id="${result.thread.id}" style="border-radius: 10px; overflow: hidden;">
                                    <div class="card-body p-3">
                                        <div class="d-flex align-items-center justify-content-between mb-2">
                                            <div class="d-flex align-items-center">
                                                <div class="rounded-circle bg-secondary text-white text-center me-2 d-flex justify-content-center align-items-center" style="width: 32px; height: 32px; font-size: 13px;">
                                                    ${result.thread.studentName.charAt(0)}
                                                </div>
                                                <div>
                                                    <strong class="text-dark">${result.thread.studentName}</strong>
                                                    <span class="text-muted small ms-2">${result.thread.createdAtFormatted}</span>
                                                </div>
                                            </div>
                                        </div>
                                        <p class="text-dark mb-3 fs-5" style="white-space: pre-wrap;">${result.thread.questionText}</p>
                                        
                                        <div class="bg-light p-3 rounded" style="border-radius: 8px;">
                                            <h6 class="fw-bold text-muted mb-2 small"><i class="bi bi-chat-left-text"></i> Câu trả lời</h6>
                                            <div class="replies-list d-flex flex-column gap-2 mb-3" data-thread-id="${result.thread.id}">
                                                <p class="text-muted small mb-0 no-replies-text">Chưa có câu trả lời nào. Hãy là người đầu tiên giúp đỡ!</p>
                                            </div>
                                            
                                            <form class="create-reply-form d-flex gap-2" data-thread-id="${result.thread.id}">
                                                <input type="text" class="form-control form-control-sm reply-input" placeholder="Viết phản hồi..." required style="border-radius: 20px;" />
                                                <button type="submit" class="btn btn-primary btn-sm rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; background-color: #1a73e8; border: none;">
                                                    <i class="bi bi-send-fill" style="font-size: 0.8rem;"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            `;
                            container.insertAdjacentHTML('afterbegin', threadHtml);
                            
                            const newForm = container.querySelector(`.create-reply-form[data-thread-id="${result.thread.id}"]`);
                            bindReplyFormHandler(newForm);

                            // Cập nhật số lượng trên Tab Badge
                            const qaTab = document.getElementById('qa-tab');
                            if (qaTab) {
                                const countMatch = qaTab.innerHTML.match(/\((\d+)\)/);
                                if (countMatch) {
                                    const currentCount = parseInt(countMatch[1]);
                                    qaTab.innerHTML = qaTab.innerHTML.replace(/\(\d+\)/, `(${currentCount + 1})`);
                                }
                            }
                        } else {
                            console.error(result.message || 'Lỗi khi tạo câu hỏi.');
                        }
                    } catch (error) {
                        console.error('Error:', error);
                    }
                });
            }

            // AJAX Q&A Reply Creation
            function bindReplyFormHandler(form) {
                form.addEventListener('submit', async function(e) {
                    e.preventDefault();
                    const threadId = this.dataset.threadId;
                    const input = this.querySelector('.reply-input');
                    const text = input.value.trim();
                    if (!text) return;

                    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

                    const formData = new URLSearchParams();
                    formData.append('threadId', threadId);
                    formData.append('replyText', text);
                    formData.append('__RequestVerificationToken', token);

                    try {
                        const response = await fetch('?handler=CreateReply&id=@Model.Class.Id', {
                            method: 'POST',
                            headers: {
                                'RequestVerificationToken': token
                            },
                            body: formData
                        });

                        const result = await response.json();
                        if (result.success) {
                            input.value = '';
                            
                            const repliesList = document.querySelector(`.replies-list[data-thread-id="${threadId}"]`);
                            if (repliesList) {
                                const noRepliesMsg = repliesList.querySelector('.no-replies-text');
                                if (noRepliesMsg) {
                                    noRepliesMsg.remove();
                                }

                                const isTeacher = result.reply.userRole === 'Teacher' || result.reply.userRole === 'Manager' || result.reply.userRole === 'Admin';
                                const replyHtml = `
                                    <div class="border-bottom pb-2">
                                        <div class="d-flex align-items-center mb-1">
                                            <strong class="${isTeacher ? 'text-primary' : 'text-dark'} small">
                                                ${result.reply.userName}
                                                ${isTeacher ? '<span class="badge bg-primary-subtle text-primary ms-1" style="font-size: 0.75rem;">Giáo viên</span>' : ''}
                                            </strong>
                                            <span class="text-muted small ms-2" style="font-size: 0.75rem;">${result.reply.createdAtFormatted}</span>
                                        </div>
                                        <p class="mb-0 text-secondary small" style="white-space: pre-wrap;">${result.reply.replyText}</p>
                                    </div>
                                `;
                                repliesList.insertAdjacentHTML('beforeend', replyHtml);
                            }
                        } else {
                            console.error(result.message || 'Lỗi khi tạo phản hồi.');
                        }
                    } catch (error) {
                        console.error('Error:', error);
                    }
                });
            }

            document.querySelectorAll('.create-reply-form').forEach(form => {
                bindReplyFormHandler(form);
            });
        });
    </script>
}
