@page
@model Flipped_Classroom.Pages.StudentClasses.DetailsModel

@{
    ViewData["Title"] = "Classroom Details";
}

<style>
    .sticky-menu {
        background: white;
    }

    .tab-content .tab-pane {
        display: none;
    }

    .tab-content .tab-pane.active {
        display: block;
    }

    .nav-tabs .nav-link {
        color: #5f6368;
        border: none;
        border-bottom: 3px solid transparent;
        transition: all 0.3s ease;
        background: transparent !important;
    }

    .nav-tabs .nav-link.active {
        color: #1a73e8 !important;
        border-bottom: 3px solid #1a73e8 !important;
    }

    .nav-tabs .nav-link:hover {
        color: #1a73e8;
    }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <!-- Class Header -->
            <div class="card border-0 shadow-sm mb-4" style="border-radius: 15px; overflow: hidden;">
                <div class="card-header text-white p-5 text-center" style="background: linear-gradient(135deg, #1a73e8 0%, #4285f4 100%);">
                    <h2 class="fw-bold mb-2">@Html.DisplayFor(model => model.Class.ClassName)</h2>
                    <span class="badge bg-light text-primary rounded-pill px-4 py-2 fs-6 mb-3">@Html.DisplayFor(model => model.Class.Status)</span>
                </div>

                <div class="card-footer bg-light p-4 text-center border-0 d-flex justify-content-center gap-3">
                    <a asp-page="./Index" class="btn btn-outline-secondary px-4 rounded-pill">Trở lại Lớp của tôi</a>
                </div>
            </div>

            <!-- Sticky Menu and Description -->
            <div class="sticky-menu mb-4">
                <div class="card border-0 shadow-sm" style="border-radius: 15px; overflow: hidden;">
                    <div class="card-header bg-white p-4 border-bottom">
                        <div class="mb-4">
                            <h5 class="fw-bold text-muted mb-3">Mô tả Lớp Học</h5>
                            <p class="text-secondary" style="line-height: 1.6; margin: 0;">
                                @(string.IsNullOrEmpty(Model.Class.Description) ? "Chưa có mô tả cho lớp học này." : Model.Class.Description)
                            </p>
                        </div>

                        <!-- Date and Manager Info -->
                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <div class="d-flex align-items-center p-3 rounded" style="background-color: #f8f9fa;">
                                    <div class="me-3 text-primary">
                                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                                    </div>
                                    <div>
                                        <div class="text-muted small">Ngày Bắt Đầu</div>
                                        <div class="fw-medium">@Html.DisplayFor(model => model.Class.StartDate)</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="d-flex align-items-center p-3 rounded" style="background-color: #f8f9fa;">
                                    <div class="me-3 text-primary">
                                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                                    </div>
                                    <div>
                                        <div class="text-muted small">Ngày Kết Thúc</div>
                                        <div class="fw-medium">@Html.DisplayFor(model => model.Class.EndDate)</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <div class="d-flex align-items-center">
                                <div class="rounded-circle d-flex justify-content-center align-items-center text-white me-3" style="width: 40px; height: 40px; font-size: 16px; background-color: #5f6368;">
                                    @(Model.Class.Manager?.Username?.FirstOrDefault() ?? '?')
                                </div>
                                <div>
                                    <div class="text-muted small">Người Quản Lý</div>
                                    <div class="fw-bold small">@Html.DisplayFor(model => model.Class.Manager.Username)</div>
                                </div>
                            </div>
                        </div>

                        <!-- Tabs Navigation -->
                        <ul class="nav nav-tabs border-0 mt-4" id="classroomTabs" role="tablist" style="gap: 1rem;">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active fw-bold" id="learning-path-tab" data-bs-toggle="tab" data-bs-target="#learning-path-content" type="button" role="tab" aria-controls="learning-path-content" aria-selected="true">
                                    <i class="bi bi-journal-bookmark"></i> Lộ Trình Học
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link fw-bold" id="students-tab" data-bs-toggle="tab" data-bs-target="#students-content" type="button" role="tab" aria-controls="students-content" aria-selected="false">
                                    <i class="bi bi-people-fill"></i> Học Viên (@(Model.Class.ClassMembers?.Count ?? 0))
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link fw-bold" id="assignments-tab" data-bs-toggle="tab" data-bs-target="#assignments-content" type="button" role="tab" aria-controls="assignments-content" aria-selected="false">
                                    <i class="bi bi-file-earmark-text"></i> Bài Tập
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link fw-bold" id="qa-tab" data-bs-toggle="tab" data-bs-target="#qa-content" type="button" role="tab" aria-controls="qa-content" aria-selected="false">
                                    <i class="bi bi-chat-dots-fill"></i> Hỏi & Đáp (@(Model.QaThreads?.Count ?? 0))
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link fw-bold" id="schedule-tab" data-bs-toggle="tab" data-bs-target="#schedule-content" type="button" role="tab" aria-controls="schedule-content" aria-selected="false">
                                    <i class="bi bi-calendar-week"></i> Lịch Học
                                </button>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Tab Content -->
            <div class="tab-content" id="classroomTabContent">
                <!-- Learning Path Tab -->
                <div class="tab-pane fade show active" id="learning-path-content" role="tabpanel" aria-labelledby="learning-path-tab">
                    <div class="card border-0 shadow-sm" style="border-radius: 15px; overflow: hidden;">
                        <div class="card-header bg-white p-4 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-3">
                            <h4 class="fw-bold mb-0" style="color: #1a73e8;">Lộ Trình Học</h4>
                            @if (Model.Class.Curriculum != null)
                            {
                                <span class="badge bg-light text-primary rounded-pill px-3 py-2">@Model.Class.Curriculum.CurriculumName</span>
                            }
                        </div>
                        <div class="card-body p-4">
                            @if (Model.Class.Curriculum == null)
                            {
                                <div class="text-center text-muted py-4">
                                    <i class="bi bi-journal-x display-6 d-block mb-2 opacity-50"></i>
                                    <h6 class="text-muted">Lớp này chưa có khung chương trình.</h6>
                                </div>
                            }
                            else
                            {
                                var allNodes = Model.Class.Curriculum.Nodes;
                                var chapters = allNodes.Where(n => n.ParentNodeId == null).OrderBy(n => n.NodeOrder).ThenBy(n => n.Id).ToList();

                                if (!chapters.Any())
                                {
                                    <div class="text-center text-muted py-4">
                                        <i class="bi bi-journal display-6 d-block mb-2 opacity-50"></i>
                                        <h6 class="text-muted">Khung chương trình chưa có bài học nào.</h6>
                                    </div>
                                }
                                else
                                {
                                    <div class="accordion" id="learningPathAccordion">
                                        @for (int i = 0; i < chapters.Count; i++)
                                        {
                                            var chapter = chapters[i];
                                            var lessons = allNodes.Where(n => n.ParentNodeId == chapter.Id).OrderBy(n => n.NodeOrder).ThenBy(n => n.Id).ToList();
                                            var collapseId = $"lp-collapse-{chapter.Id}";
                                            var headingId = $"lp-heading-{chapter.Id}";
                                            var chapterUnlocked = Model.NodeUnlockStatus.TryGetValue(chapter.Id, out var cu) && cu;

                                            <div class="accordion-item border-0 mb-2 shadow-sm" style="border-radius: 10px; overflow: hidden;">
                                                <h2 class="accordion-header" id="@headingId">
                                                    <button class="accordion-button @(i == 0 ? "" : "collapsed") fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="@(i == 0 ? "true" : "false")" aria-controls="@collapseId">
                                                        <i class="bi bi-folder-fill text-warning me-2"></i> @chapter.Title
                                                    </button>
                                                </h2>
                                                <div id="@collapseId" class="accordion-collapse collapse @(i == 0 ? "show" : "")" aria-labelledby="@headingId" data-bs-parent="#learningPathAccordion">
                                                    <div class="accordion-body p-0">
                                                        @{
                                                            var chapterQuizzes = chapter.Quizzes.Where(q => q.ClassId == Model.Class.Id && q.Status == "Published" && !q.IsAlwaysOpen).ToList();
                                                        }
                                                        
                                                        @if (chapterQuizzes.Any())
                                                        {
                                                            <div class="px-4 py-3 bg-light border-bottom">
                                                                <span class="fs-8 fw-bold text-secondary text-uppercase d-block mb-2" style="font-size: 0.75rem; letter-spacing: 0.5px;">Bài test chương:</span>
                                                                <div class="d-flex flex-column gap-2">
                                                                    @foreach (var quiz in chapterQuizzes)
                                                                    {
                                                                        <div class="d-flex align-items-center justify-content-between py-2 border-bottom border-light">
                                                                            <div class="d-flex align-items-center gap-2">
                                                                                <i class="bi bi-file-earmark-check-fill text-warning fs-5"></i>
                                                                                <div>
                                                                                    <span class="fw-semibold text-dark">@quiz.Title</span>
                                                                                    <span class="text-muted small d-block">@quiz.DurationMinutes phút | @quiz.QuizQuestions.Count câu</span>
                                                                                </div>
                                                                            </div>
                                                                            @if (chapterUnlocked)
                                                                            {
                                                                                <a asp-page="/Quizzes/Take" asp-route-id="@quiz.Id" class="btn btn-sm btn-outline-warning rounded-pill px-3">
                                                                                    Làm bài <i class="bi bi-play-fill ms-1"></i>
                                                                                </a>
                                                                            }
                                                                            else
                                                                            {
                                                                                <button type="button" class="btn btn-sm btn-secondary rounded-pill px-3" disabled>
                                                                                    <i class="bi bi-lock-fill"></i> Đang khóa
                                                                                </button>
                                                                            }
                                                                        </div>
                                                                    }
                                                                </div>
                                                            </div>
                                                        }

                                                        @if (!lessons.Any() && !chapterQuizzes.Any())
                                                        {
                                                            <p class="text-muted text-center py-3 mb-0 small">Chương này chưa có bài học hoặc bài test.</p>
                                                        }
                                                        else if (lessons.Any())
                                                        {
                                                            <ul class="list-group list-group-flush">
                                                                @foreach (var lesson in lessons)
                                                                {
                                                                    var isUnlocked = chapterUnlocked;
                                                                    var isCompleted = Model.NodeCompletionStatus.TryGetValue(lesson.Id, out var c) && c;
                                                                    var lessonQuizzes = lesson.Quizzes.Where(q => q.ClassId == Model.Class.Id && q.Status == "Published" && !q.IsAlwaysOpen).ToList();
                                                                    
                                                                    <li class="list-group-item d-flex flex-column py-3 px-4 @(isUnlocked ? "" : "bg-light text-muted")">
                                                                        <div class="d-flex justify-content-between align-items-center w-100">
                                                                            <div class="d-flex align-items-center gap-2">
                                                                                @if (!isUnlocked)
                                                                                {
                                                                                    <i class="bi bi-lock-fill text-secondary"></i>
                                                                                }
                                                                                else if (isCompleted)
                                                                                {
                                                                                    <i class="bi bi-check-circle-fill text-success"></i>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <i class="bi bi-file-earmark-text text-primary"></i>
                                                                                }
                                                                                <span class="fw-medium @(isUnlocked ? "" : "text-muted")">@lesson.Title</span>
                                                                                @if (isCompleted)
                                                                                {
                                                                                    <span class="badge bg-success-subtle text-success rounded-pill">Đã hoàn thành</span>
                                                                                }
                                                                                @if (lesson.Materials.Any())
                                                                                {
                                                                                    <span class="badge bg-light text-muted rounded-pill">@lesson.Materials.Count tài liệu</span>
                                                                                }
                                                                            </div>
                                                                            @if (isUnlocked)
                                                                            {
                                                                                <a asp-page="./Lesson" asp-route-classId="@Model.Class.Id" asp-route-nodeId="@lesson.Id"
                                                                                   class="btn btn-sm btn-primary rounded-pill px-3" style="background-color: #1a73e8; border: none;">
                                                                                    Vào học <i class="bi bi-arrow-right ms-1"></i>
                                                                                </a>
                                                                            }
                                                                            else
                                                                            {
                                                                                <button type="button" class="btn btn-sm btn-secondary rounded-pill px-3" disabled title="Bài học chưa được giáo viên mở">
                                                                                    <i class="bi bi-lock me-1"></i> Đang khóa
                                                                                </button>
                                                                            }
                                                                        </div>

                                                                        @if (lessonQuizzes.Any())
                                                                        {
                                                                            <div class="mt-2 ps-4 d-flex flex-column gap-2">
                                                                                @foreach (var quiz in lessonQuizzes)
                                                                                {
                                                                                    <div class="d-flex align-items-center justify-content-between py-2 border-top border-light">
                                                                                        <div class="d-flex align-items-center gap-2">
                                                                                            <i class="bi bi-file-earmark-check text-warning fs-5"></i>
                                                                                            <div>
                                                                                                <span class="fw-semibold text-dark fs-7">@quiz.Title</span>
                                                                                                <span class="text-muted small d-block">@quiz.DurationMinutes phút | @quiz.QuizQuestions.Count câu</span>
                                                                                            </div>
                                                                                        </div>
                                                                                        @if (isUnlocked)
                                                                                        {
                                                                                            <a asp-page="/Quizzes/Take" asp-route-id="@quiz.Id" class="btn btn-sm btn-outline-warning rounded-pill px-3">
                                                                                                Làm bài <i class="bi bi-play-fill ms-1"></i>
                                                                                            </a>
                                                                                        }
                                                                                        else
                                                                                        {
                                                                                            <button type="button" class="btn btn-sm btn-secondary rounded-pill px-3" disabled>
                                                                                                <i class="bi bi-lock-fill"></i> Đang khóa
                                                                                            </button>
                                                                                        }
                                                                                    </div>
                                                                                }
                                                                            </div>
                                                                        }
                                                                    </li>
                                                                }
                                                            </ul>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>


                <!-- Assignments Tab -->
                <div class="tab-pane fade" id="assignments-content" role="tabpanel" aria-labelledby="assignments-tab">
                    <div class="card border-0 shadow-sm" style="border-radius: 15px; overflow: hidden;">
                        <div class="card-header bg-white p-4 border-bottom">
                            <h4 class="fw-bold mb-0" style="color: #1a73e8;">Danh Sách Bài Tập</h4>
                        </div>
                        <div class="card-body p-4">
                            @if (TempData["SuccessMessage"] != null)
                            {
                                <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
                                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                </div>
                            }

                            @if (!ViewData.ModelState.IsValid)
                            {
                                <div class="alert alert-danger alert-dismissible fade show rounded-3" role="alert">
                                    <div asp-validation-summary="All" class="text-danger small"></div>
                                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                </div>
                            }

                            @if (Model.Assignments != null && Model.Assignments.Any())
                            {
                                <div class="row g-4">
                                    @foreach (var assign in Model.Assignments)
                                    {
                                        var isOverdue = assign.DueDate.HasValue && DateTime.Now > assign.DueDate.Value;
                                        <div class="col-12">
                                            <div class="card border shadow-sm p-4 rounded-3">
                                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                                                    <div>
                                                        <h5 class="fw-bold text-dark mb-1">@assign.Title</h5>
                                                        <span class="text-muted small">
                                                            <i class="bi bi-clock me-1"></i> Hạn nộp: 
                                                            @(assign.DueDate.HasValue ? assign.DueDate.Value.ToString("dd/MM/yyyy HH:mm") : "Không giới hạn")
                                                        </span>
                                                    </div>
                                                    <div>
                                                        @if (assign.Status == "Graded")
                                                        {
                                                            <span class="badge bg-success fs-6 rounded-pill px-3"><i class="bi bi-patch-check"></i> Đã chấm điểm</span>
                                                        }
                                                        else if (assign.Status == "Submitted")
                                                        {
                                                            <span class="badge bg-primary fs-6 rounded-pill px-3"><i class="bi bi-check-circle"></i> Đã nộp bài</span>
                                                        }
                                                        else
                                                        {
                                                            if (isOverdue)
                                                            {
                                                                <span class="badge bg-danger fs-6 rounded-pill px-3"><i class="bi bi-exclamation-octagon"></i> Quá hạn</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-warning text-dark fs-6 rounded-pill px-3"><i class="bi bi-hourglass-split"></i> Chưa nộp</span>
                                                            }
                                                        }
                                                    </div>
                                                </div>

                                                @if (!string.IsNullOrEmpty(assign.RequirementText))
                                                {
                                                    <div class="bg-light p-3 rounded mb-3 text-secondary text-start" style="font-size: 0.95rem;">
                                                        <strong>Yêu cầu:</strong> @assign.RequirementText
                                                    </div>
                                                }

                                                @if (assign.Status == "Graded")
                                                {
                                                    <div class="card border-success bg-light mb-3" style="border-radius: 8px;">
                                                        <div class="card-body p-3">
                                                            <div class="d-flex align-items-center mb-2 text-success">
                                                                <i class="bi bi-star-fill me-2 fs-5"></i>
                                                                <h6 class="fw-bold mb-0">Kết Quả Chấm Điểm</h6>
                                                            </div>
                                                            <div class="fs-4 fw-bold text-dark mb-2">Điểm số: <span class="text-primary">@assign.Score?.ToString("0.0")</span> / 10.0</div>
                                                            @if (!string.IsNullOrEmpty(assign.Feedback))
                                                            {
                                                                <div class="text-secondary small mt-1">
                                                                    <strong>Nhận xét của giảng viên:</strong>
                                                                    <p class="mb-0 italic">"@assign.Feedback"</p>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                }

                                                @if (!isOverdue && assign.Status != "Graded")
                                                {
                                                    <div class="border-top pt-3 mt-2">
                                                        <form method="post" asp-page-handler="SubmitAssignment" asp-route-id="@Model.Class.Id" enctype="multipart/form-data">
                                                            <input type="hidden" name="AssignmentId" value="@assign.AssignmentId" />
                                                            
                                                            <div class="mb-3">
                                                                <label class="form-label fw-bold text-secondary" style="font-size: 0.9rem;">
                                                                    Tải lên bài nộp (Hỗ trợ `.docx` hoặc `.mp3`, tối đa 15MB)
                                                                </label>
                                                                <input type="file" name="UploadedFile" class="form-control" accept=".docx,.mp3" required onchange="validateStudentFile(this)" />
                                                                <div class="form-text">Tải lên file bài giải của bạn.</div>
                                                            </div>

                                                            <div class="mb-3">
                                                                <label class="form-label fw-bold text-secondary" style="font-size: 0.9rem;">Ghi chú (Tùy chọn)</label>
                                                                <textarea name="ContentText" class="form-control" rows="2" placeholder="Nhập ghi chú cho giáo viên..."></textarea>
                                                            </div>

                                                            <button type="submit" class="btn btn-primary rounded-pill px-4" style="background-color: #1a73e8; border: none;">
                                                                @(assign.Status == "Submitted" ? "Nộp lại bài tập" : "Nộp bài tập")
                                                            </button>
                                                        </form>
                                                    </div>
                                                }
                                                else if (isOverdue && assign.Status != "Graded" && assign.Status != "Submitted")
                                                {
                                                    <div class="text-danger small mt-2">
                                                        <i class="bi bi-info-circle"></i> Đã quá hạn nộp bài. Bạn không thể nộp hoặc chỉnh sửa bài tập này nữa.
                                                    </div>
                                                }

                                                @if (assign.Status == "Submitted" || assign.Status == "Graded")
                                                {
                                                    @if (!string.IsNullOrEmpty(assign.MediaUrl))
                                                    {
                                                        <div class="mt-2 text-muted small">
                                                            <i class="bi bi-file-earmark-check"></i> File đã nộp: 
                                                            <a href="@assign.MediaUrl" target="_blank" class="text-primary text-decoration-none">
                                                                Tải xuống tệp nộp bài
                                                            </a>
                                                        </div>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-5 text-muted">
                                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mb-3 opacity-50"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                                    <h6 class="text-muted">Chưa có bài tập nào được tạo cho lớp học này.</h6>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Students Tab -->
                <div class="tab-pane fade" id="students-content" role="tabpanel" aria-labelledby="students-tab">
                    <div class="card border-0 shadow-sm" style="border-radius: 15px; overflow: hidden;">
                        <div class="card-header bg-white p-4 border-bottom">
                            <h4 class="fw-bold mb-0" style="color: #1a73e8;">Danh Sách Học Viên</h4>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="bg-light text-muted">
                                        <tr>
                                            <th class="px-4 py-3 border-0 fw-semibold">Học Viên</th>
                                            <th class="px-4 py-3 border-0 fw-semibold">Nhóm</th>
                                            <th class="px-4 py-3 border-0 fw-semibold text-center">Support Team</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.Class.ClassMembers != null && Model.Class.ClassMembers.Any())
                                        {
                                            foreach (var member in Model.Class.ClassMembers)
                                            {
                                                <tr class="align-middle">
                                                    <td class="px-4 py-3">
                                                        <div class="d-flex align-items-center">
                                                            <div class="rounded-circle d-flex justify-content-center align-items-center text-white me-3" style="width: 35px; height: 35px; font-size: 14px; background-color: #4285f4;">
                                                                @(member.User?.Username?.FirstOrDefault() ?? '?')
                                                            </div>
                                                            <div class="fw-medium text-dark">@(member.User?.Username ?? "Unknown")</div>
                                                        </div>
                                                    </td>
                                                    <td class="px-4 py-3">
                                                        @{
                                                            var assignedGroup = Model.Class.Groups?.FirstOrDefault(g => g.GroupMembers.Any(gm => gm.StudentId == member.UserId));
                                                        }
                                                        <span class="badge" style="background-color: #f1f3f4; color: #3c4043; font-size: 0.9em; padding: 0.5em 1em; border-radius: 6px;">
                                                            @(assignedGroup != null ? assignedGroup.GroupName : "Chưa có nhóm")
                                                        </span>
                                                    </td>
                                                    <td class="px-4 py-3 text-center">
                                                        @if (member.IsSupportTeam == true)
                                                        {
                                                            <span class="badge bg-success rounded-pill px-3">Có</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-secondary rounded-pill px-3">Không</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="3" class="text-center py-5 text-muted">
                                                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mb-3 opacity-50"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                                                    <h6 class="text-muted">Chưa có học viên nào trong lớp</h6>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Q&A Tab -->
                <div class="tab-pane fade" id="qa-content" role="tabpanel" aria-labelledby="qa-tab">
                    <div class="card border-0 shadow-sm" style="border-radius: 15px; overflow: hidden;">
                        <div class="card-header bg-white p-4 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-3">
                            <h4 class="fw-bold mb-0" style="color: #1a73e8;">Hỏi & Đáp Lớp Học</h4>
                        </div>
                        <div class="card-body p-4">
                            <!-- Question Submission Form -->
                            <div class="card border mb-4 shadow-sm" style="border-radius: 10px;">
                                <div class="card-body p-3">
                                    <h6 class="fw-bold mb-3"><i class="bi bi-question-circle text-primary"></i> Đặt câu hỏi mới</h6>
                                    <form id="createThreadForm" method="post">
                                        @Html.AntiForgeryToken()
                                        <div class="mb-3">
                                            <textarea id="questionTextInput" class="form-control" rows="3" placeholder="Nhập câu hỏi của bạn ở đây..." required style="border-radius: 8px;"></textarea>
                                        </div>
                                        <button type="submit" class="btn btn-primary rounded-pill px-4" style="background-color: #1a73e8; border: none;">
                                            Đăng câu hỏi <i class="bi bi-send ms-1"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>

                            <!-- List of Threads -->
                            <div id="qaThreadsContainer" class="d-flex flex-column gap-3">
                                @if (Model.QaThreads != null && Model.QaThreads.Any())
                                {
                                    foreach (var thread in Model.QaThreads)
                                    {
                                        <div class="card border shadow-sm qa-thread-card" data-thread-id="@thread.Id" style="border-radius: 10px; overflow: hidden;">
                                            <div class="card-body p-3">
                                                <div class="d-flex align-items-center justify-content-between mb-2">
                                                    <div class="d-flex align-items-center">
                                                        <div class="rounded-circle bg-secondary text-white text-center me-2 d-flex justify-content-center align-items-center" style="width: 32px; height: 32px; font-size: 13px;">
                                                            @(thread.Student?.Username?.FirstOrDefault() ?? '?')
                                                        </div>
                                                        <div>
                                                            <strong class="text-dark">@(thread.Student?.Username ?? "Học viên")</strong>
                                                            <span class="text-muted small ms-2">@thread.CreatedAt?.ToString("dd/MM/yyyy HH:mm")</span>
                                                        </div>
                                                    </div>
                                                </div>
                                                <p class="text-dark mb-3 fs-5" style="white-space: pre-wrap;">@thread.QuestionText</p>
                                                
                                                <!-- Replies Section -->
                                                <div class="bg-light p-3 rounded" style="border-radius: 8px;">
                                                    <h6 class="fw-bold text-muted mb-2 small"><i class="bi bi-chat-left-text"></i> Câu trả lời</h6>
                                                    <div class="replies-list d-flex flex-column gap-2 mb-3" data-thread-id="@thread.Id">
                                                        @if (thread.QaReplies != null && thread.QaReplies.Any())
                                                        {
                                                            foreach (var reply in thread.QaReplies)
                                                            {
                                                                var isTeacherReply = reply.User?.Role == "Teacher" || reply.User?.Role == "Manager" || reply.User?.Role == "Admin";
                                                                <div class="border-bottom pb-2">
                                                                    <div class="d-flex align-items-center mb-1">
                                                                        <strong class="@(isTeacherReply ? "text-primary" : "text-dark") small">
                                                                            @(reply.User?.Username ?? "User")
                                                                            @if (isTeacherReply)
                                                                            {
                                                                                <span class="badge bg-primary-subtle text-primary ms-1" style="font-size: 0.75rem;">Giáo viên</span>
                                                                            }
                                                                        </strong>
                                                                        <span class="text-muted small ms-2" style="font-size: 0.75rem;">@reply.CreatedAt?.ToString("dd/MM/yyyy HH:mm")</span>
                                                                    </div>
                                                                    <p class="mb-0 text-secondary small" style="white-space: pre-wrap;">@reply.ReplyText</p>
                                                                </div>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <p class="text-muted small mb-0 no-replies-text">Chưa có câu trả lời nào. Hãy là người đầu tiên giúp đỡ!</p>
                                                        }
                                                    </div>
                                                    
                                                    <!-- Reply Form -->
                                                    <form class="create-reply-form d-flex gap-2" data-thread-id="@thread.Id">
                                                        <input type="text" class="form-control form-control-sm reply-input" placeholder="Viết phản hồi..." required style="border-radius: 20px;" />
                                                        <button type="submit" class="btn btn-primary btn-sm rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; background-color: #1a73e8; border: none;">
                                                            <i class="bi bi-send-fill" style="font-size: 0.8rem;"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div id="noThreadsMessage" class="text-center py-5 text-muted bg-light rounded border">
                                        <i class="bi bi-chat-square-text display-6 d-block mb-2 opacity-50"></i>
                                        <h6 class="text-muted">Chưa có chủ đề thảo luận nào. Đặt câu hỏi đầu tiên!</h6>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Schedule Tab -->
                <div class="tab-pane fade" id="schedule-content" role="tabpanel" aria-labelledby="schedule-tab">
                    <div class="card border-0 shadow-sm" style="border-radius: 15px; overflow: hidden;">
                        <div class="card-header bg-white p-4 border-bottom">
                            <h4 class="fw-bold mb-0" style="color: #1a73e8;">Lịch Học Của Lớp</h4>
                        </div>
                        <div class="card-body p-4">
                            @if (Model.Class.ClassSchedules != null && Model.Class.ClassSchedules.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="bg-light text-muted">
                                            <tr>
                                                <th class="px-4 py-3 border-0 fw-semibold">Buổi</th>
                                                <th class="px-4 py-3 border-0 fw-semibold">Ngày học</th>
                                                <th class="px-4 py-3 border-0 fw-semibold">Thời gian</th>
                                                <th class="px-4 py-3 border-0 fw-semibold">Phòng học</th>
                                                <th class="px-4 py-3 border-0 fw-semibold">Trạng thái</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{
                                                var sessionNum = 0;
                                            }
                                            @foreach (var schedule in Model.Class.ClassSchedules.OrderBy(s => s.StudyDate).ThenBy(s => s.StartTime))
                                            {
                                                sessionNum++;
                                                var isPast = schedule.StudyDate < DateOnly.FromDateTime(DateTime.Now);
                                                var isToday = schedule.StudyDate == DateOnly.FromDateTime(DateTime.Now);
                                                var dayName = Flipped_Classroom.Services.ScheduleSlotHelper.GetVietnameseDayName(schedule.StudyDate.DayOfWeek);
                                                
                                                <tr class="align-middle @(isPast ? "opacity-50" : "")">
                                                    <td class="px-4 py-3 fw-semibold">Buổi @sessionNum</td>
                                                    <td class="px-4 py-3">
                                                        <div class="fw-semibold">@schedule.StudyDate.ToString("dd/MM/yyyy")</div>
                                                        <small class="text-muted">@dayName</small>
                                                    </td>
                                                    <td class="px-4 py-3 text-primary">
                                                        <i class="bi bi-clock me-1"></i>
                                                        @schedule.StartTime.ToString("HH:mm") – @schedule.EndTime.ToString("HH:mm")
                                                    </td>
                                                    <td class="px-4 py-3">
                                                        @if (!string.IsNullOrEmpty(schedule.Room))
                                                        {
                                                            <span><i class="bi bi-geo-alt me-1 text-muted"></i>@schedule.Room</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted fst-italic">Trực tuyến</span>
                                                        }
                                                    </td>
                                                    <td class="px-4 py-3">
                                                        @if (isToday)
                                                        {
                                                            <span class="badge bg-danger rounded-pill px-3">Hôm nay</span>
                                                        }
                                                        else if (isPast)
                                                        {
                                                            <span class="badge bg-secondary rounded-pill px-3">Đã qua</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-success rounded-pill px-3">Sắp tới</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-5 text-muted">
                                    <i class="bi bi-calendar-x display-6 d-block mb-2 opacity-50"></i>
                                    <h6 class="text-muted">Lớp học này chưa được xếp lịch học.</h6>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function validateStudentFile(input) {
            const file = input.files[0];
            if (!file) return;

            const allowedExtensions = ['.docx', '.mp3'];
            const fileName = file.name.toLowerCase();
            const isValidExt = allowedExtensions.some(ext => fileName.endsWith(ext));

            if (!isValidExt) {
                alert("Chỉ chấp nhận các tệp tin có định dạng .docx hoặc .mp3!");
                input.value = "";
                return;
            }

            const maxSize = 15 * 1024 * 1024; // 15 MB
            if (file.size > maxSize) {
                alert("Dung lượng tệp tải lên vượt quá giới hạn cho phép (Tối đa 15MB)!");
                input.value = "";
                return;
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            // Tab persistence functionality
            const tabButtons = document.querySelectorAll('[data-bs-toggle="tab"]');
            const activeTabKey = 'classroomActiveTab_' + window.location.pathname;

            // Restore active tab on page load
            const savedTab = localStorage.getItem(activeTabKey);
            if (savedTab) {
                const tabButton = document.getElementById(savedTab);
                if (tabButton) {
                    const tab = new bootstrap.Tab(tabButton);
                    tab.show();
                }
            }

            // Save active tab when changed
            tabButtons.forEach(button => {
                button.addEventListener('shown.bs.tab', function(e) {
                    localStorage.setItem(activeTabKey, this.id);
                });
            });

            // AJAX Q&A Thread Creation
            const createThreadForm = document.getElementById('createThreadForm');
            if (createThreadForm) {
                createThreadForm.addEventListener('submit', async function(e) {
                    e.preventDefault();
                    const textarea = document.getElementById('questionTextInput');
                    const text = textarea.value.trim();
                    if (!text) return;

                    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

                    const formData = new URLSearchParams();
                    formData.append('questionText', text);
                    formData.append('__RequestVerificationToken', token);

                    try {
                        const response = await fetch('?handler=CreateThread&id=@Model.Class.Id', {
                            method: 'POST',
                            headers: {
                                'RequestVerificationToken': token
                            },
                            body: formData
                        });

                        const result = await response.json();
                        if (result.success) {
                            textarea.value = '';
                            
                            const container = document.getElementById('qaThreadsContainer');
                            const noThreadsMsg = document.getElementById('noThreadsMessage');
                            if (noThreadsMsg) {
                                noThreadsMsg.remove();
                            }

                            const threadHtml = `
                                <div class="card border shadow-sm qa-thread-card" data-thread-id="${result.thread.id}" style="border-radius: 10px; overflow: hidden;">
                                    <div class="card-body p-3">
                                        <div class="d-flex align-items-center justify-content-between mb-2">
                                            <div class="d-flex align-items-center">
                                                <div class="rounded-circle bg-secondary text-white text-center me-2 d-flex justify-content-center align-items-center" style="width: 32px; height: 32px; font-size: 13px;">
                                                    ${result.thread.studentName.charAt(0)}
                                                </div>
                                                <div>
                                                    <strong class="text-dark">${result.thread.studentName}</strong>
                                                    <span class="text-muted small ms-2">${result.thread.createdAtFormatted}</span>
                                                </div>
                                            </div>
                                        </div>
                                        <p class="text-dark mb-3 fs-5" style="white-space: pre-wrap;">${result.thread.questionText}</p>
                                        
                                        <div class="bg-light p-3 rounded" style="border-radius: 8px;">
                                            <h6 class="fw-bold text-muted mb-2 small"><i class="bi bi-chat-left-text"></i> Câu trả lời</h6>
                                            <div class="replies-list d-flex flex-column gap-2 mb-3" data-thread-id="${result.thread.id}">
                                                <p class="text-muted small mb-0 no-replies-text">Chưa có câu trả lời nào. Hãy là người đầu tiên giúp đỡ!</p>
                                            </div>
                                            
                                            <form class="create-reply-form d-flex gap-2" data-thread-id="${result.thread.id}">
                                                <input type="text" class="form-control form-control-sm reply-input" placeholder="Viết phản hồi..." required style="border-radius: 20px;" />
                                                <button type="submit" class="btn btn-primary btn-sm rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; background-color: #1a73e8; border: none;">
                                                    <i class="bi bi-send-fill" style="font-size: 0.8rem;"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            `;
                            container.insertAdjacentHTML('afterbegin', threadHtml);
                            
                            const newForm = container.querySelector(`.create-reply-form[data-thread-id="${result.thread.id}"]`);
                            bindReplyFormHandler(newForm);

                            // Cập nhật số lượng trên Tab Badge
                            const qaTab = document.getElementById('qa-tab');
                            if (qaTab) {
                                const countMatch = qaTab.innerHTML.match(/\((\d+)\)/);
                                if (countMatch) {
                                    const currentCount = parseInt(countMatch[1]);
                                    qaTab.innerHTML = qaTab.innerHTML.replace(/\(\d+\)/, `(${currentCount + 1})`);
                                }
                            }
                        } else {
                            console.error(result.message || 'Lỗi khi tạo câu hỏi.');
                        }
                    } catch (error) {
                        console.error('Error:', error);
                    }
                });
            }

            // AJAX Q&A Reply Creation
            function bindReplyFormHandler(form) {
                form.addEventListener('submit', async function(e) {
                    e.preventDefault();
                    const threadId = this.dataset.threadId;
                    const input = this.querySelector('.reply-input');
                    const text = input.value.trim();
                    if (!text) return;

                    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

                    const formData = new URLSearchParams();
                    formData.append('threadId', threadId);
                    formData.append('replyText', text);
                    formData.append('__RequestVerificationToken', token);

                    try {
                        const response = await fetch('?handler=CreateReply&id=@Model.Class.Id', {
                            method: 'POST',
                            headers: {
                                'RequestVerificationToken': token
                            },
                            body: formData
                        });

                        const result = await response.json();
                        if (result.success) {
                            input.value = '';
                            
                            const repliesList = document.querySelector(`.replies-list[data-thread-id="${threadId}"]`);
                            if (repliesList) {
                                const noRepliesMsg = repliesList.querySelector('.no-replies-text');
                                if (noRepliesMsg) {
                                    noRepliesMsg.remove();
                                }

                                const isTeacher = result.reply.userRole === 'Teacher' || result.reply.userRole === 'Manager' || result.reply.userRole === 'Admin';
                                const replyHtml = `
                                    <div class="border-bottom pb-2">
                                        <div class="d-flex align-items-center mb-1">
                                            <strong class="${isTeacher ? 'text-primary' : 'text-dark'} small">
                                                ${result.reply.userName}
                                                ${isTeacher ? '<span class="badge bg-primary-subtle text-primary ms-1" style="font-size: 0.75rem;">Giáo viên</span>' : ''}
                                            </strong>
                                            <span class="text-muted small ms-2" style="font-size: 0.75rem;">${result.reply.createdAtFormatted}</span>
                                        </div>
                                        <p class="mb-0 text-secondary small" style="white-space: pre-wrap;">${result.reply.replyText}</p>
                                    </div>
                                `;
                                repliesList.insertAdjacentHTML('beforeend', replyHtml);
                            }
                        } else {
                            console.error(result.message || 'Lỗi khi tạo phản hồi.');
                        }
                    } catch (error) {
                        console.error('Error:', error);
                    }
                });
            }

            document.querySelectorAll('.create-reply-form').forEach(form => {
                bindReplyFormHandler(form);
            });
        });
    </script>
}
