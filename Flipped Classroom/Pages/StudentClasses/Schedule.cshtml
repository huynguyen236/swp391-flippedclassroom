@page
@model Flipped_Classroom.Pages.StudentClasses.ScheduleModel
@using Flipped_Classroom.Services
@{
    ViewData["Title"] = "Lịch học của tôi";

    // Calendar calculations
    var firstDayOfMonth = new DateOnly(Model.DisplayYear, Model.DisplayMonth, 1);
    var daysInMonth = DateTime.DaysInMonth(Model.DisplayYear, Model.DisplayMonth);
    var startDayOfWeek = (int)firstDayOfMonth.DayOfWeek; // 0 = Sunday
    var startOffset = (startDayOfWeek == 0) ? 6 : startDayOfWeek - 1;

    var prevMonth = firstDayOfMonth.AddMonths(-1);
    var nextMonth = firstDayOfMonth.AddMonths(1);

    var monthNames = new[] { "", "Tháng 1", "Tháng 2", "Tháng 3", "Tháng 4", "Tháng 5", "Tháng 6",
        "Tháng 7", "Tháng 8", "Tháng 9", "Tháng 10", "Tháng 11", "Tháng 12" };

    var classColors = new[] {
        "background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-container) 100%);",
        "background: linear-gradient(135deg, var(--color-secondary) 0%, var(--color-secondary-container) 100%);",
        "background: linear-gradient(135deg, var(--color-tertiary) 0%, var(--color-tertiary-container) 100%);",
        "background: linear-gradient(135deg, #0f766e 0%, #14b8a6 100%);",
        "background: linear-gradient(135deg, #b45309 0%, #f59e0b 100%);"
    };
}

<div class="container py-5 student-schedule-container">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom flex-wrap gap-3">
        <div>
            <h2 class="fw-bold d-flex align-items-center gap-2 mb-1" style="color: var(--color-on-background);">
                <span class="material-symbols-outlined text-primary fs-3">calendar_month</span> Lịch học của tôi
            </h2>
            <p class="text-muted mb-0 small">Xem lịch học các lớp bạn đang tham gia</p>
        </div>
        <a asp-page="./Index" class="btn btn-outline-secondary px-4 py-2 d-inline-flex align-items-center gap-1">
            <span class="material-symbols-outlined" style="font-size: 18px;">arrow_back</span> Lớp của tôi
        </a>
    </div>

    @if (!Model.EnrolledClasses.Any())
    {
        <div class="card card-premium text-center py-5">
            <div class="card-body">
                <span class="material-symbols-outlined text-muted fs-1 mb-2 opacity-50">calendar_today</span>
                <h5 class="text-muted fw-bold">Bạn chưa tham gia lớp học nào</h5>
                <p class="text-muted small">Hãy tham gia lớp học để xem lịch học tại đây.</p>
                <a asp-page="./Index" class="btn btn-primary px-4 py-2 mt-2 d-inline-flex align-items-center gap-1">
                    <span class="material-symbols-outlined" style="font-size: 18px;">search</span> Xem lớp học
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- Class Legend -->
        <div class="card card-premium mb-4">
            <div class="card-body p-4">
                <h6 class="fw-bold text-muted mb-3 d-flex align-items-center gap-1"><span class="material-symbols-outlined text-muted" style="font-size: 18px;">bookmark</span> Lớp của tôi</h6>
                <div class="d-flex flex-wrap gap-2">
                    @for (int ci = 0; ci < Model.EnrolledClasses.Count; ci++)
                    {
                        var cls = Model.EnrolledClasses[ci];
                        var colorStyle = classColors[ci % classColors.Length];
                        <span class="badge text-white px-3 py-2 fw-normal" style="border-radius: 8px; font-size: 0.85rem; @colorStyle">
                            @cls.ClassName
                            @if (!string.IsNullOrEmpty(cls.DetectedSlot))
                            {
                                <span class="ms-1 opacity-75">(@cls.DetectedSlot)</span>
                            }
                        </span>
                    }
                </div>
            </div>
        </div>

        @if (!Model.ScheduleItems.Any())
        {
            <div class="card card-premium text-center py-5">
                <div class="card-body">
                    <span class="material-symbols-outlined text-muted fs-1 mb-2 opacity-50">calendar_today</span>
                    <h5 class="text-muted fw-bold">Chưa có lịch học</h5>
                    <p class="text-muted small">Quản lý chưa xếp lịch cho lớp của bạn.</p>
                </div>
            </div>
        }
        else
        {
            <div class="row g-4">
                <!-- Calendar View -->
                <div class="col-lg-7">
                    <div class="card card-premium">
                        <div class="card-body p-4">
                            <!-- Month Navigation -->
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <a asp-page="./Schedule"
                                   asp-route-month="@prevMonth.Month" asp-route-year="@prevMonth.Year"
                                   class="btn btn-light btn-sm rounded-circle d-flex align-items-center justify-content-center"
                                   style="width: 36px; height: 36px; padding: 0;">
                                    <span class="material-symbols-outlined" style="font-size: 20px;">chevron_left</span>
                                </a>
                                <h5 class="fw-bold mb-0 text-primary">
                                    @monthNames[Model.DisplayMonth] @Model.DisplayYear
                                </h5>
                                <a asp-page="./Schedule"
                                   asp-route-month="@nextMonth.Month" asp-route-year="@nextMonth.Year"
                                   class="btn btn-light btn-sm rounded-circle d-flex align-items-center justify-content-center"
                                   style="width: 36px; height: 36px; padding: 0;">
                                    <span class="material-symbols-outlined" style="font-size: 20px;">chevron_right</span>
                                </a>
                            </div>

                            <!-- Calendar Grid -->
                            <div class="calendar-grid">
                                <div class="calendar-header">
                                    <div class="cal-cell text-muted fw-semibold">T2</div>
                                    <div class="cal-cell text-muted fw-semibold">T3</div>
                                    <div class="cal-cell text-muted fw-semibold">T4</div>
                                    <div class="cal-cell text-muted fw-semibold">T5</div>
                                    <div class="cal-cell text-muted fw-semibold">T6</div>
                                    <div class="cal-cell text-muted fw-semibold">T7</div>
                                    <div class="cal-cell text-muted fw-semibold text-danger">CN</div>
                                </div>
                                <div class="calendar-body">
                                    @for (int i = 0; i < startOffset; i++)
                                    {
                                        <div class="cal-cell cal-empty"></div>
                                    }
                                    @for (int day = 1; day <= daysInMonth; day++)
                                    {
                                        var currentDate = new DateOnly(Model.DisplayYear, Model.DisplayMonth, day);
                                        var isScheduleDay = Model.ScheduleDates.Contains(currentDate);
                                        var isToday = currentDate == DateOnly.FromDateTime(DateTime.Now);
                                        var cellClass = "cal-cell cal-day";
                                        if (isScheduleDay) cellClass += " cal-active";
                                        if (isToday) cellClass += " cal-today";

                                        var dayClasses = isScheduleDay
                                            ? Model.ScheduleItems.Where(s => s.StudyDate == currentDate).Select(s => s.ClassName).Distinct().ToList()
                                            : new List<string>();
                                        var tooltip = isScheduleDay
                                            ? ScheduleSlotHelper.GetVietnameseDayName(currentDate.DayOfWeek) + " — " + string.Join(", ", dayClasses)
                                            : "";

                                        <div class="@cellClass" title="@tooltip">
                                            <span>@day</span>
                                            @if (isScheduleDay)
                                            {
                                                <div class="cal-dots">
                                                    @for (int di = 0; di < Math.Min(dayClasses.Count, 3); di++)
                                                    {
                                                        <div class="cal-dot" style="background: white;"></div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Legend -->
                            <div class="d-flex gap-4 mt-3 justify-content-center">
                                <div class="d-flex align-items-center gap-2">
                                    <div style="width: 12px; height: 12px; border-radius: 50%; background: linear-gradient(135deg, var(--color-primary), var(--color-primary-container));"></div>
                                    <small class="text-muted">Ngày có lịch</small>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <div style="width: 12px; height: 12px; border-radius: 50%; border: 2px solid var(--color-secondary);"></div>
                                    <small class="text-muted">Hôm nay</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Schedule List -->
                <div class="col-lg-5">
                    <div class="card card-premium">
                        <div class="card-premium-header bg-white border-0 px-4 pt-4 pb-0">
                            <h6 class="fw-bold text-muted mb-0 d-flex align-items-center gap-1">
                                <span class="material-symbols-outlined text-muted" style="font-size: 20px;">list</span> Lịch học — @monthNames[Model.DisplayMonth]
                            </h6>
                        </div>
                        <div class="card-body px-4 pb-4" style="max-height: 520px; overflow-y: auto;">
                            @{
                                var monthSchedules = Model.ScheduleItems
                                    .Where(s => s.StudyDate.Month == Model.DisplayMonth && s.StudyDate.Year == Model.DisplayYear)
                                    .ToList();
                            }
                            @if (!monthSchedules.Any())
                            {
                                <div class="text-center py-5 text-muted">
                                    <span class="material-symbols-outlined text-muted fs-2 mb-1 opacity-50">event_busy</span>
                                    <p class="small mb-0">Không có buổi học trong tháng này.</p>
                                </div>
                            }
                            else
                            {
                                var groupedByDate = monthSchedules.GroupBy(s => s.StudyDate).OrderBy(g => g.Key);
                                @foreach (var dateGroup in groupedByDate)
                                {
                                    var dayName = ScheduleSlotHelper.GetVietnameseDayName(dateGroup.Key.DayOfWeek);
                                    var isPast = dateGroup.Key < DateOnly.FromDateTime(DateTime.Now);
                                    var isToday = dateGroup.Key == DateOnly.FromDateTime(DateTime.Now);

                                    <div class="schedule-day-group mb-3 @(isPast ? "opacity-50" : "")">
                                        <div class="d-flex align-items-center gap-2 mb-2">
                                            <div class="text-center" style="min-width: 48px;">
                                                <div class="fw-bold" style="font-size: 1.4rem; color: @(isToday ? "var(--color-secondary)" : "var(--color-primary)"); line-height: 1;">
                                                    @dateGroup.Key.Day
                                                </div>
                                                <small class="text-muted" style="font-size: 0.7rem;">@dayName</small>
                                            </div>
                                            <div class="flex-grow-1">
                                                <span class="fw-bold small text-dark">@dateGroup.Key.ToString("dd/MM/yyyy")</span>
                                                @if (isToday)
                                                {
                                                    <span class="badge bg-danger text-white rounded-pill ms-2 small">Hôm nay</span>
                                                }
                                                else if (isPast)
                                                {
                                                    <span class="badge bg-secondary text-white rounded-pill ms-2 small">Đã qua</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success text-white rounded-pill ms-2 small">Sắp tới</span>
                                                }
                                            </div>
                                        </div>
                                        @foreach (var schedule in dateGroup.OrderBy(s => s.StartTime))
                                        {
                                            var cIndex = Model.EnrolledClasses.FindIndex(c => c.ClassId == schedule.ClassId);
                                            var itemColor = cIndex >= 0 ? classColors[cIndex % classColors.Length] : "background: #6c757d;";

                                            <div class="schedule-item d-flex align-items-center gap-3 p-3 mb-2 rounded-3 bg-light border-start"
                                                 style="transition: all 0.2s; border-left: 4px solid var(--color-primary) !important;">
                                                <div class="flex-grow-1">
                                                    <div class="d-flex align-items-center gap-2 mb-1">
                                                        <span class="badge text-white px-2.5 py-1 fw-normal" style="border-radius: 6px; font-size: 0.75rem; @itemColor">
                                                            @schedule.ClassName
                                                        </span>
                                                        @if (!string.IsNullOrEmpty(schedule.DetectedSlot))
                                                        {
                                                            <span class="text-muted fw-semibold" style="font-size: 0.75rem;">@schedule.DetectedSlot</span>
                                                        }
                                                    </div>
                                                    <div class="text-primary fw-semibold small d-flex align-items-center gap-1">
                                                        <span class="material-symbols-outlined" style="font-size: 16px;">schedule</span>
                                                        @schedule.StartTime.ToString("HH:mm") – @schedule.EndTime.ToString("HH:mm")
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(schedule.Room))
                                                    {
                                                        <div class="text-muted small mt-1 d-flex align-items-center gap-1">
                                                            <span class="material-symbols-outlined" style="font-size: 16px;">meeting_room</span> @schedule.Room
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

@section Styles {
    <style>
        .calendar-grid {
            width: 100%;
        }
        .calendar-header, .calendar-body {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 4px;
        }
        .calendar-header {
            margin-bottom: 8px;
        }
        .cal-cell {
            text-align: center;
            padding: 8px 4px;
            font-size: 0.85rem;
            border-radius: 10px;
            position: relative;
        }
        .cal-day {
            cursor: default;
            transition: all 0.2s;
            color: var(--color-on-background);
            font-weight: 500;
        }
        .cal-day:hover {
            background-color: var(--color-surface-container-low);
        }
        .cal-empty {
            visibility: hidden;
        }
        .cal-active {
            background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-container) 100%) !important;
            color: white !important;
            font-weight: 600;
            box-shadow: 0 4px 10px rgba(var(--bs-primary-rgb), 0.15);
        }
        .cal-today {
            border: 2px solid var(--color-secondary);
        }
        .cal-active.cal-today {
            border: 2px solid #ffdd59;
        }
        .cal-dots {
            display: flex;
            justify-content: center;
            gap: 2px;
            margin-top: 2px;
        }
        .cal-dot {
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: white;
        }
        .schedule-item:hover {
            background: var(--color-surface-container-high) !important;
            transform: translateX(4px);
        }
    </style>
}
