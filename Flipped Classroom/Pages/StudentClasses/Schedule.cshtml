@page
@model Flipped_Classroom.Pages.StudentClasses.ScheduleModel
@using Flipped_Classroom.Services
@{
    ViewData["Title"] = "Lịch học của tôi";

    // Calendar calculations
    var firstDayOfMonth = new DateOnly(Model.DisplayYear, Model.DisplayMonth, 1);
    var daysInMonth = DateTime.DaysInMonth(Model.DisplayYear, Model.DisplayMonth);
    var startDayOfWeek = (int)firstDayOfMonth.DayOfWeek; // 0 = Sunday
    var startOffset = (startDayOfWeek == 0) ? 6 : startDayOfWeek - 1;

    var prevMonth = firstDayOfMonth.AddMonths(-1);
    var nextMonth = firstDayOfMonth.AddMonths(1);

    var monthNames = new[] { "", "Tháng 1", "Tháng 2", "Tháng 3", "Tháng 4", "Tháng 5", "Tháng 6",
        "Tháng 7", "Tháng 8", "Tháng 9", "Tháng 10", "Tháng 11", "Tháng 12" };

    var classColors = new[] {
        "background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);",
        "background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);",
        "background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);",
        "background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);",
        "background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);"
    };
}

<div class="container py-5">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h2 class="fw-bold mb-1" style="color: #1a73e8;">
                <i class="bi bi-calendar-event-fill me-2"></i>Lịch học của tôi
            </h2>
            <p class="text-muted mb-0">Xem lịch học các lớp bạn đang tham gia</p>
        </div>
        <a asp-page="./Index" class="btn btn-outline-primary btn-sm rounded-pill px-4">
            <i class="bi bi-arrow-left me-1"></i> Lớp của tôi
        </a>
    </div>

    @if (!Model.EnrolledClasses.Any())
    {
        <div class="card border-0 shadow-sm" style="border-radius: 15px;">
            <div class="card-body text-center py-5">
                <i class="bi bi-calendar-x" style="font-size: 3rem; color: #ccc;"></i>
                <h5 class="text-muted mt-3">Bạn chưa tham gia lớp học nào</h5>
                <p class="text-muted">Hãy tham gia lớp học để xem lịch học tại đây.</p>
                <a asp-page="./Index" class="btn btn-primary rounded-pill px-4 mt-2" style="background-color: #1a73e8; border: none;">
                    <i class="bi bi-mortarboard me-1"></i> Xem lớp học
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- Class Legend -->
        <div class="card border-0 shadow-sm mb-4" style="border-radius: 15px;">
            <div class="card-body p-4">
                <h6 class="fw-bold text-muted mb-3"><i class="bi bi-bookmark-fill me-1"></i> Lớp của tôi</h6>
                <div class="d-flex flex-wrap gap-2">
                    @for (int ci = 0; ci < Model.EnrolledClasses.Count; ci++)
                    {
                        var cls = Model.EnrolledClasses[ci];
                        var colorStyle = classColors[ci % classColors.Length];
                        <span class="badge text-white px-3 py-2 fw-normal" style="border-radius: 8px; font-size: 0.85rem; @colorStyle">
                            @cls.ClassName
                            @if (!string.IsNullOrEmpty(cls.DetectedSlot))
                            {
                                <span class="ms-1 opacity-75">(@cls.DetectedSlot)</span>
                            }
                        </span>
                    }
                </div>
            </div>
        </div>

        @if (!Model.ScheduleItems.Any())
        {
            <div class="card border-0 shadow-sm" style="border-radius: 15px;">
                <div class="card-body text-center py-5">
                    <i class="bi bi-calendar2-x" style="font-size: 3rem; color: #ccc;"></i>
                    <h5 class="text-muted mt-3">Chưa có lịch học</h5>
                    <p class="text-muted">Manager chưa xếp lịch cho lớp của bạn.</p>
                </div>
            </div>
        }
        else
        {
            <div class="row g-4">
                <!-- Calendar View -->
                <div class="col-lg-7">
                    <div class="card border-0 shadow-sm" style="border-radius: 15px;">
                        <div class="card-body p-4">
                            <!-- Month Navigation -->
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <a asp-page="./Schedule"
                                   asp-route-month="@prevMonth.Month" asp-route-year="@prevMonth.Year"
                                   class="btn btn-light btn-sm rounded-circle d-flex align-items-center justify-content-center"
                                   style="width: 36px; height: 36px;">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                                <h5 class="fw-bold mb-0" style="color: #1a73e8;">
                                    @monthNames[Model.DisplayMonth] @Model.DisplayYear
                                </h5>
                                <a asp-page="./Schedule"
                                   asp-route-month="@nextMonth.Month" asp-route-year="@nextMonth.Year"
                                   class="btn btn-light btn-sm rounded-circle d-flex align-items-center justify-content-center"
                                   style="width: 36px; height: 36px;">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </div>

                            <!-- Calendar Grid -->
                            <div class="calendar-grid">
                                <div class="calendar-header">
                                    <div class="cal-cell text-muted fw-semibold">T2</div>
                                    <div class="cal-cell text-muted fw-semibold">T3</div>
                                    <div class="cal-cell text-muted fw-semibold">T4</div>
                                    <div class="cal-cell text-muted fw-semibold">T5</div>
                                    <div class="cal-cell text-muted fw-semibold">T6</div>
                                    <div class="cal-cell text-muted fw-semibold">T7</div>
                                    <div class="cal-cell text-muted fw-semibold" style="color: #dc3545 !important;">CN</div>
                                </div>
                                <div class="calendar-body">
                                    @for (int i = 0; i < startOffset; i++)
                                    {
                                        <div class="cal-cell cal-empty"></div>
                                    }
                                    @for (int day = 1; day <= daysInMonth; day++)
                                    {
                                        var currentDate = new DateOnly(Model.DisplayYear, Model.DisplayMonth, day);
                                        var isScheduleDay = Model.ScheduleDates.Contains(currentDate);
                                        var isToday = currentDate == DateOnly.FromDateTime(DateTime.Now);
                                        var cellClass = "cal-cell cal-day";
                                        if (isScheduleDay) cellClass += " cal-active";
                                        if (isToday) cellClass += " cal-today";

                                        var dayClasses = isScheduleDay
                                            ? Model.ScheduleItems.Where(s => s.StudyDate == currentDate).Select(s => s.ClassName).Distinct().ToList()
                                            : new List<string>();
                                        var tooltip = isScheduleDay
                                            ? ScheduleSlotHelper.GetVietnameseDayName(currentDate.DayOfWeek) + " — " + string.Join(", ", dayClasses)
                                            : "";

                                        <div class="@cellClass" title="@tooltip">
                                            <span>@day</span>
                                            @if (isScheduleDay)
                                            {
                                                <div class="cal-dots">
                                                    @for (int di = 0; di < Math.Min(dayClasses.Count, 3); di++)
                                                    {
                                                        <div class="cal-dot" style="background: white;"></div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Legend -->
                            <div class="d-flex gap-4 mt-3 justify-content-center">
                                <div class="d-flex align-items-center gap-2">
                                    <div style="width: 12px; height: 12px; border-radius: 50%; background: linear-gradient(135deg, #1a73e8, #4285f4);"></div>
                                    <small class="text-muted">Ngày có lịch</small>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <div style="width: 12px; height: 12px; border-radius: 50%; border: 2px solid #ff6b6b;"></div>
                                    <small class="text-muted">Hôm nay</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Schedule List -->
                <div class="col-lg-5">
                    <div class="card border-0 shadow-sm" style="border-radius: 15px;">
                        <div class="card-header bg-white border-0 px-4 pt-4 pb-0">
                            <h6 class="fw-bold text-muted mb-0">
                                <i class="bi bi-list-ul me-1"></i> Lịch học — @monthNames[Model.DisplayMonth]
                            </h6>
                        </div>
                        <div class="card-body px-4 pb-4" style="max-height: 520px; overflow-y: auto;">
                            @{
                                var monthSchedules = Model.ScheduleItems
                                    .Where(s => s.StudyDate.Month == Model.DisplayMonth && s.StudyDate.Year == Model.DisplayYear)
                                    .ToList();
                            }
                            @if (!monthSchedules.Any())
                            {
                                <div class="text-center py-4 text-muted">
                                    <i class="bi bi-calendar-x" style="font-size: 2rem;"></i>
                                    <p class="mt-2 mb-0">Không có buổi học trong tháng này.</p>
                                </div>
                            }
                            else
                            {
                                var groupedByDate = monthSchedules.GroupBy(s => s.StudyDate).OrderBy(g => g.Key);
                                @foreach (var dateGroup in groupedByDate)
                                {
                                    var dayName = ScheduleSlotHelper.GetVietnameseDayName(dateGroup.Key.DayOfWeek);
                                    var isPast = dateGroup.Key < DateOnly.FromDateTime(DateTime.Now);
                                    var isToday = dateGroup.Key == DateOnly.FromDateTime(DateTime.Now);

                                    <div class="schedule-day-group mb-3 @(isPast ? "opacity-50" : "")">
                                        <div class="d-flex align-items-center gap-2 mb-2">
                                            <div class="text-center" style="min-width: 48px;">
                                                <div class="fw-bold" style="font-size: 1.4rem; color: @(isToday ? "#ff6b6b" : "#1a73e8"); line-height: 1;">
                                                    @dateGroup.Key.Day
                                                </div>
                                                <small class="text-muted" style="font-size: 0.7rem;">@dayName</small>
                                            </div>
                                            <div class="flex-grow-1">
                                                <span class="fw-semibold small">@dateGroup.Key.ToString("dd/MM/yyyy")</span>
                                                @if (isToday)
                                                {
                                                    <span class="badge bg-danger rounded-pill ms-2 small">Hôm nay</span>
                                                }
                                                else if (isPast)
                                                {
                                                    <span class="badge bg-secondary rounded-pill ms-2 small">Đã qua</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success rounded-pill ms-2 small">Sắp tới</span>
                                                }
                                            </div>
                                        </div>
                                        @foreach (var schedule in dateGroup.OrderBy(s => s.StartTime))
                                        {
                                            var cIndex = Model.EnrolledClasses.FindIndex(c => c.ClassId == schedule.ClassId);
                                            var itemColor = cIndex >= 0 ? classColors[cIndex % classColors.Length] : "background: #6c757d;";

                                            <div class="schedule-item d-flex align-items-center gap-3 p-3 mb-1 rounded-3"
                                                 style="background: #f8f9fa; transition: all 0.2s; border-left: 4px solid transparent;">
                                                <div class="flex-grow-1">
                                                    <div class="d-flex align-items-center gap-2 mb-1">
                                                        <span class="badge text-white px-2 py-1 fw-normal" style="border-radius: 6px; font-size: 0.75rem; @itemColor">
                                                            @schedule.ClassName
                                                        </span>
                                                        @if (!string.IsNullOrEmpty(schedule.DetectedSlot))
                                                        {
                                                            <span class="text-muted" style="font-size: 0.7rem;">@schedule.DetectedSlot</span>
                                                        }
                                                    </div>
                                                    <small class="text-primary">
                                                        <i class="bi bi-clock me-1"></i>
                                                        @schedule.StartTime.ToString("HH:mm") – @schedule.EndTime.ToString("HH:mm")
                                                    </small>
                                                    @if (!string.IsNullOrEmpty(schedule.Room))
                                                    {
                                                        <small class="text-muted ms-2">
                                                            <i class="bi bi-geo-alt me-1"></i>@schedule.Room
                                                        </small>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

@section Styles {
    <style>
        .calendar-grid {
            width: 100%;
        }
        .calendar-header, .calendar-body {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 4px;
        }
        .calendar-header {
            margin-bottom: 8px;
        }
        .cal-cell {
            text-align: center;
            padding: 8px 4px;
            font-size: 0.85rem;
            border-radius: 10px;
            position: relative;
        }
        .cal-day {
            cursor: default;
            transition: all 0.2s;
            color: #495057;
        }
        .cal-day:hover {
            background-color: #f0f4ff;
        }
        .cal-empty {
            visibility: hidden;
        }
        .cal-active {
            background: linear-gradient(135deg, #1a73e8 0%, #4285f4 100%) !important;
            color: white !important;
            font-weight: 600;
            box-shadow: 0 2px 8px rgba(26, 115, 232, 0.3);
        }
        .cal-today {
            border: 2px solid #ff6b6b;
        }
        .cal-active.cal-today {
            border: 2px solid #ffdd59;
        }
        .cal-dots {
            display: flex;
            justify-content: center;
            gap: 2px;
            margin-top: 2px;
        }
        .cal-dot {
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: white;
        }
        .schedule-item:hover {
            background: #e8f0fe !important;
            transform: translateX(4px);
        }
    </style>
}
