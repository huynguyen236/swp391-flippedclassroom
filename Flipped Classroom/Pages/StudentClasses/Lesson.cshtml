        @@keyframes speechRipple {
            0%   { transform: scale(1); opacity: 0.8; }
            100% { transform: scale(1.8); opacity: 0; }
        }
        .speech-practice .progress-ring { transform: rotate(-90deg); }
        .speech-practice .progress-ring__circle {
            transition: stroke-dashoffset 0.5s ease-in-out;
            stroke-dasharray: 251.2; /* 2πr, r=40 */
            stroke-dashoffset: 251.2;
        }
        .speech-practice .score-container {
            display: flex; align-items: center; gap: 24px;
            padding-top: 20px; border-top: 1px dashed #dee2e6;
        }
        .speech-practice .score-number { font-size: 2rem; font-weight: 700; color: #1d3557; }
        .speech-practice .comparison-card {
            background: #f8f9fa; border-radius: 12px; padding: 16px; border-left: 4px solid #1a73e8;
        }
        .speech-practice .align-match { color: #2ec4b6; font-weight: bold; }
        .speech-practice .align-mismatch { color: #e63946; font-weight: bold; border-bottom: 2px dashed #e63946; cursor: help; }
        .speech-practice .align-delete { color: #adb5bd; text-decoration: line-through; }
        .speech-practice .align-insert { color: #fff; background: #e63946; padding: 0 4px; border-radius: 4px; font-weight: bold; }

        /* Modern tabs styling */
        .nav-tabs .nav-link {
            color: #5f6368;
            border: 1px solid #dee2e6;
            background: #f8f9fa;
            transition: all 0.2s ease;
        }
        .nav-tabs .nav-link.active {
            color: #ffffff !important;
            background: #1a73e8 !important;
            border-color: #1a73e8 !important;
        }
        .nav-tabs .nav-link:hover:not(.active) {
            background: #e9ecef;
            color: #1a73e8;
        }

        /* 3D Card Styling */
        .flashcard-scene {
            width: 100%;
            height: 380px;
            perspective: 1000px;
            cursor: pointer;
        }
        .flashcard-inner {
            width: 100%;
            height: 100%;
            position: relative;
            transform-style: preserve-3d;
            transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
