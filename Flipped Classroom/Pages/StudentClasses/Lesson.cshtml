@page "{classId:int}/{nodeId:int}"
@model Flipped_Classroom.Pages.StudentClasses.LessonModel
@{
    ViewData["Title"] = Model.Lesson.Title;
    var currentUserIdStr = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    int.TryParse(currentUserIdStr, out int currentUserId);
    var isTeacher = User.IsInRole("Teacher") || Model.Class.ManagerId == currentUserId;
}

<div class="container py-5 student-lesson-container">
    <div class="row justify-content-center">
        <div class="col-lg-10">

            <!-- Breadcrumbs -->
            <div class="d-flex align-items-center gap-2 mb-3 text-secondary small">
                <a asp-page="@(isTeacher ? "/TeacherClasses/Details" : "/StudentClasses/Details")" asp-route-id="@Model.Class.Id" class="text-secondary text-decoration-none hover-text-primary">@Model.Class.ClassName</a>
                <span class="material-symbols-outlined" style="font-size:16px;">chevron_right</span>
                @if (Model.Lesson.ParentNode != null)
                {
                    <span class="text-secondary">@Model.Lesson.ParentNode.Title</span>
                    <span class="material-symbols-outlined" style="font-size:16px;">chevron_right</span>
                }
                <span class="text-dark fw-medium">@Model.Lesson.Title</span>
            </div>

            <!-- Lesson Header Section -->
            <div class="hero-header-banner p-4 p-md-5 mb-4 rounded-3 d-flex flex-column justify-content-between align-items-start position-relative overflow-hidden">
                <div class="hero-header-decor"></div>
                <div class="relative z-1">
                    <h2 class="fw-bold mb-2 text-white" style="font-size: 2rem;">@Model.Lesson.Title</h2>
                    @if (!string.IsNullOrWhiteSpace(Model.Lesson.Description))
                    {
                        <p class="mb-0 text-white-50" style="max-width: 600px;">@Model.Lesson.Description</p>
                    }
                </div>
            </div>

            <!-- Navigation Tabs -->
            <ul class="nav nav-tabs nav-tabs-premium border-bottom-0 mb-4" id="lessonTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="materials-tab" data-bs-toggle="tab" data-bs-target="#materials-content" type="button" role="tab" aria-controls="materials-content" aria-selected="true">
                        <span class="material-symbols-outlined">menu_book</span> Học liệu
                    </button>
                </li>
                @if (Model.Lesson.Vocabularies != null && Model.Lesson.Vocabularies.Any())
                {
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="flashcards-tab" data-bs-toggle="tab" data-bs-target="#flashcards-content" type="button" role="tab" aria-controls="flashcards-content" aria-selected="false">
                            <span class="material-symbols-outlined">style</span> Flashcard Ôn Tập
                        </button>
                    </li>
                }
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="qa-tab" data-bs-toggle="tab" data-bs-target="#qa-content" type="button" role="tab" aria-controls="qa-content" aria-selected="false">
                        <span class="material-symbols-outlined">forum</span> Hỏi & Đáp
                    </button>
                </li>
            </ul>

            <!-- Tab Content -->
            <div class="tab-content" id="lessonTabContent">
                <!-- Tab Materials -->
                <div class="tab-pane fade show active" id="materials-content" role="tabpanel" aria-labelledby="materials-tab">
                    @if (!Model.Lesson.Materials.Any())
                    {
                        <div class="card card-premium text-center py-5 mb-4">
                            <div class="card-body text-muted">
                                <span class="material-symbols-outlined text-muted fs-1 mb-2 opacity-50">folder_open</span>
                                <h6 class="text-muted fw-bold">Bài học này chưa có tài liệu.</h6>
                            </div>
                        </div>
                    }
                    else
                    {
                        foreach (var mat in Model.Lesson.Materials)
                        {
                            var isSpeech = string.Equals(mat.MaterialType, "speech", System.StringComparison.OrdinalIgnoreCase);
                            var isYoutube = string.Equals(mat.MaterialType, "YouTube", System.StringComparison.OrdinalIgnoreCase);
                            var isPdf = !isSpeech && mat.Url.EndsWith(".pdf", System.StringComparison.OrdinalIgnoreCase);
                            var ext = isSpeech ? "" : System.IO.Path.GetExtension(mat.Url).ToLowerInvariant();
                            var isVideo = ext is ".mp4" or ".webm" or ".ogg";

                            <div class="card border-0 shadow-sm mb-4" style="border-radius: 15px; overflow: hidden;">
                                <div class="card-header bg-white border-bottom d-flex align-items-center gap-2 py-3">
                                    <i class="bi @(isSpeech ? "bi-mic-fill text-primary" : isYoutube || isVideo ? "bi-play-circle text-danger" : isPdf ? "bi-file-earmark-pdf text-danger" : "bi-file-earmark-text text-primary") fs-5"></i>
                                    <span class="fw-semibold">@mat.Title</span>
                                    @if (isSpeech)
                                    {
                                        <span class="badge bg-primary-subtle text-primary rounded-pill ms-auto">Luyện nói</span>
                                    }
                                </div>
                                <div class="card-body p-0">
                                    @if (isSpeech)
                                    {
                                        <div class="speech-practice p-4" data-material-id="@mat.Id"
                                             data-compare-url="@Url.Page("/StudentClasses/Lesson", "CompareSpeech", new { classId = Model.Class.Id, nodeId = Model.Lesson.Id })">
                                            <div class="sentence-box active mb-4 text-center">
                                                <div class="japanese-text speech-target">@mat.SpeechTargetText</div>
                                                @if (!string.IsNullOrWhiteSpace(mat.SpeechMeaning))
                                                {
                                                    <div class="vietnamese-text">@mat.SpeechMeaning</div>
                                                }
                                                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-4 mt-3 speech-tts-btn">
                                                    <i class="bi bi-volume-up-fill me-1"></i> Nghe mẫu
                                                </button>
                                            </div>

                                            <div class="text-center">
                                                <div class="mic-btn-wrapper">
                                                    <button type="button" class="mic-btn speech-record-btn"><i class="bi bi-mic-fill"></i></button>
                                                    <div class="pulse-ring"></div>
                                                </div>
                                                <div class="speech-status text-muted fw-semibold small text-uppercase">Bấm nút để bắt đầu nói</div>
                                            </div>

                                            <div class="speech-result mt-3" style="display:none;">
                                                <div class="score-container">
                                                    <div class="position-relative" style="width:100px;height:100px;">
                                                        <svg class="progress-ring" width="100" height="100">
                                                            <circle stroke="#e9ecef" stroke-width="8" fill="transparent" r="40" cx="50" cy="50" />
                                                            <circle class="progress-ring__circle speech-score-circle" stroke="#2ec4b6" stroke-width="8" fill="transparent" r="40" cx="50" cy="50" />
                                                        </svg>
                                                        <div class="position-absolute top-50 start-50 translate-middle text-center">
                                                            <span class="score-number speech-score-text">0</span><span class="small fw-bold text-muted">%</span>
                                                        </div>
                                                    </div>
                                                    <div class="flex-grow-1">
                                                        <div class="comparison-card small">
                                                            <div class="mb-1"><strong>Bạn nói:</strong> <span class="text-primary fw-medium speech-spoken-text"></span></div>
                                                            <div class="mb-1"><strong>Âm câu gốc:</strong> <span class="text-secondary font-monospace speech-target-hira"></span></div>
                                                            <div class="mb-2"><strong>Âm bạn nói:</strong> <span class="text-secondary font-monospace speech-spoken-hira"></span></div>
                                                            <div class="mb-1"><strong>Phân tích chi tiết:</strong></div>
                                                            <div class="speech-alignment fs-4 p-2 bg-white rounded border d-flex flex-wrap gap-1 font-monospace"></div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else if (isYoutube)
                                    {
                                        var embed = Flipped_Classroom.Pages.StudentClasses.LessonModel.ToYouTubeEmbed(mat.Url);
                                        <div class="ratio ratio-16x9">
                                            <iframe src="@embed" title="@mat.Title" frameborder="0"
                                                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                                    allowfullscreen></iframe>
                                        </div>
                                    }
                                    else if (isVideo)
                                    {
                                        <div class="ratio ratio-16x9 bg-black">
                                            <video controls preload="metadata" style="width:100%;height:100%;object-fit:contain;">
                                                <source src="@mat.Url" type="video/@(ext.TrimStart('.'))" />
                                                Trình duyệt của bạn không hỗ trợ phát video.
                                            </video>
                                        </div>
                                    }
                                    else if (isPdf)
                                    {
                                        <div class="p-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
                                            <span class="text-muted small d-inline-flex align-items-center gap-1">
                                                <i class="bi bi-file-earmark-pdf text-danger"></i> Tài liệu PDF
                                            </span>
                                            <a href="@mat.Url" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill px-3 d-inline-flex align-items-center gap-1">
                                                <span class="material-symbols-outlined" style="font-size: 16px;">download</span> Tải xuống
                                            </a>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="p-4 text-center">
                                            <p class="text-muted mb-3 small">Tài liệu đính kèm</p>
                                            <a href="@mat.Url" target="_blank" class="btn btn-primary rounded-pill px-4 d-inline-flex align-items-center gap-1">
                                                <span class="material-symbols-outlined" style="font-size: 18px;">open_in_new</span> Mở tài liệu
                                            </a>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>

                <!-- Tab Flashcard (Only if vocab exists) -->
                @if (Model.Lesson.Vocabularies != null && Model.Lesson.Vocabularies.Any())
                {
                    <div class="tab-pane fade" id="flashcards-content" role="tabpanel" aria-labelledby="flashcards-tab">
                        <div class="card card-premium p-4 mb-4">
                            <!-- Progress bar -->
                            <div class="d-flex justify-content-between align-items-center mb-2 px-1">
                                <span class="fs-8 fw-bold text-primary" id="progressText">Thẻ 1 / @Model.Lesson.Vocabularies.Count</span>
                                <span class="fs-8 text-muted">Bấm <kbd class="bg-dark text-white px-1.5 py-0.5 rounded">Space</kbd> để lật thẻ, <kbd class="bg-dark text-white px-1.5 py-0.5 rounded">←</kbd> <kbd class="bg-dark text-white px-1.5 py-0.5 rounded">→</kbd> để chuyển thẻ</span>
                            </div>
                            <div class="progress mb-4 shadow-sm" style="height: 6px; border-radius: 10px;">
                                <div class="progress-bar bg-primary progress-bar-striped progress-bar-animated" id="progressBar" role="progressbar" style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>

                            <!-- 3D Flashcard container -->
                            <div class="flashcard-scene mx-auto mb-4" id="flashcardScene" style="max-width: 600px;">
                                <div class="flashcard-inner" id="flashcardInner">
                                    <!-- Front of card -->
                                    <div class="flashcard-face flashcard-front">
                                        <span class="badge bg-white text-primary position-absolute top-0 start-0 m-3 px-3 py-1.5 rounded-pill fw-bold fs-7 shadow-sm" id="frontDiffBadge"></span>
                                        <div class="flashcard-body-content position-relative w-100">
                                            <!-- Audio pronounce button -->
                                            <button type="button" class="btn btn-light btn-sm rounded-circle audio-btn" id="speakBtn" title="Phát âm">
                                                <span class="material-symbols-outlined text-primary" style="font-size: 20px;">volume_up</span>
                                            </button>
                                            
                                            <div class="front-card-content py-4">
                                                <h1 class="flashcard-text-large" id="frontText">Front Text</h1>
                                                <p class="romaji-text text-white-50 mt-3" id="romajiText" style="font-size:1.35rem; font-style: italic;"></p>
                                            </div>
                                            <p class="text-white-50 fs-8 mt-4"><span class="material-symbols-outlined align-middle" style="font-size: 16px;">sync</span> Bấm để lật xem nghĩa mặt sau</p>
                                        </div>
                                    </div>
                                    <!-- Back of card -->
                                    <div class="flashcard-face flashcard-back">
                                        <span class="badge bg-white text-dark position-absolute top-0 start-0 m-3 px-3 py-1.5 rounded-pill fw-bold fs-7 shadow-sm" id="backDiffBadge"></span>
                                        <div class="flashcard-body-content w-100">
                                            <div class="back-card-content">
                                                <!-- Pronunciation (Cách đọc) -->
                                                <h3 class="pronunciation-text" id="pronunciationText">たべる</h3>
                                                <hr class="my-3 text-white-50 w-50 mx-auto">
                                                <!-- Meaning (Nghĩa) -->
                                                <h2 class="meaning-text" id="backText">Nghĩa của từ</h2>
                                            </div>

                                            <p class="text-white-50 fs-8 mt-4"><span class="material-symbols-outlined align-middle" style="font-size: 16px;">sync</span> Bấm để lật lại mặt trước</p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Control Buttons -->
                            <div class="d-flex justify-content-between align-items-center mt-3 gap-3 mx-auto" style="max-width: 600px; width: 100%;">
                                <button type="button" class="btn btn-outline-secondary rounded-pill px-4 py-2.5 flex-grow-1 shadow-sm fs-7 d-flex align-items-center justify-content-center gap-1.5" id="prevBtn">
                                    <span class="material-symbols-outlined" style="font-size: 18px;">arrow_back</span> Trước
                                </button>
                                <button type="button" class="btn btn-outline-primary rounded-pill px-3 py-2.5 shadow-sm fs-7 d-flex align-items-center justify-content-center" id="shuffleBtn" title="Trộn ngẫu nhiên thứ tự thẻ">
                                    <span class="material-symbols-outlined" style="font-size: 18px;">shuffle</span>
                                </button>
                                <button type="button" class="btn btn-primary rounded-pill px-4 py-2.5 flex-grow-1 shadow-sm fs-7 d-flex align-items-center justify-content-center gap-1.5" id="nextBtn">
                                    Kế tiếp <span class="material-symbols-outlined" style="font-size: 18px;">arrow_forward</span>
                                </button>
                            </div>
                        </div>
                    </div>
                }

                <!-- Tab Q&A -->
                <div class="tab-pane fade" id="qa-content" role="tabpanel" aria-labelledby="qa-tab">
                    <!-- Section Hỏi & Đáp (Lesson Comments) -->
                    <div class="card card-premium mb-4">
                        <div class="card-premium-header">
                            <h5 class="fw-bold mb-0 text-primary d-flex align-items-center gap-2">
                                <span class="material-symbols-outlined">forum</span> Hỏi đáp & Thảo luận
                            </h5>
                        </div>
                        <div class="card-body p-4">
                            <!-- Form đặt câu hỏi/bình luận mới -->
                            <form id="createCommentForm" class="mb-4">
                                @Html.AntiForgeryToken()
                                <div class="mb-3">
                                    <textarea id="commentTextInput" class="form-control bg-light" rows="3" 
                                              placeholder="Đặt câu hỏi hoặc viết bình luận về bài học này..." 
                                              required style="border-radius: 10px; resize: none;"></textarea>
                                </div>
                                <button type="submit" class="btn btn-primary px-4 py-2 d-flex align-items-center gap-1">
                                    Đăng bình luận <span class="material-symbols-outlined" style="font-size: 18px;">send</span>
                                </button>
                            </form>

                            <!-- Danh sách bình luận -->
                            <div id="commentsContainer" class="d-flex flex-column gap-4">
                                @if (Model.QaThreads != null && Model.QaThreads.Any())
                                {
                                    foreach (var thread in Model.QaThreads)
                                    {
                                        var canDeleteThread = thread.StudentId == currentUserId || isTeacher;
                                        var threadUserRole = thread.Student?.Role ?? "Student";
                                        var isThreadTeacher = threadUserRole == "Teacher" || threadUserRole == "Manager" || threadUserRole == "Admin";

                                        <div class="comment-card border-bottom pb-4" data-comment-id="@thread.Id">
                                            <div class="d-flex align-items-start justify-content-between mb-2">
                                                <div class="d-flex align-items-center">
                                                    <div class="rounded-circle text-white text-center me-2 d-flex justify-content-center align-items-center fw-bold" 
                                                         style="width: 36px; height: 36px; font-size: 14px; background-color: var(--color-outline) !important;">
                                                        @(thread.Student?.Username?.FirstOrDefault() ?? '?')
                                                    </div>
                                                    <div>
                                                        <strong class="text-dark">@thread.Student?.Username</strong>
                                                        @if (isThreadTeacher)
                                                        {
                                                            <span class="badge bg-primary-subtle text-primary ms-1" style="font-size: 0.75rem;">Giáo viên</span>
                                                        }
                                                        <div class="text-muted small" style="font-size: 0.75rem;">@thread.CreatedAt?.ToString("dd/MM/yyyy HH:mm")</div>
                                                    </div>
                                                </div>
                                                @if (canDeleteThread)
                                                {
                                                    <button type="button" class="btn btn-link text-danger p-0 delete-comment-btn d-flex align-items-center" data-comment-id="@thread.Id" title="Xóa bình luận">
                                                        <span class="material-symbols-outlined" style="font-size: 18px;">delete</span>
                                                    </button>
                                                }
                                            </div>
                                            <p class="text-dark mb-3 fw-semibold" style="white-space: pre-wrap; margin-left: 44px !important; font-size: 0.95rem;">@thread.QuestionText</p>
                                            
                                            <!-- Phản hồi (Replies) -->
                                            <div class="replies-wrapper ms-5 ps-3 border-start" style="border-left: 2px solid var(--color-outline-variant) !important; margin-left: 44px !important;">
                                                <div class="replies-list d-flex flex-column gap-2 mb-2" data-comment-id="@thread.Id">
                                                    @foreach (var reply in thread.QaReplies.OrderBy(r => r.CreatedAt))
                                                    {
                                                        var canDeleteReply = reply.UserId == currentUserId || isTeacher;
                                                        var replyUserRole = reply.User?.Role ?? "Student";
                                                        var isReplyTeacher = replyUserRole == "Teacher" || replyUserRole == "Manager" || replyUserRole == "Admin";

                                                        <div class="reply-item py-2 border-bottom-0" data-reply-id="@reply.Id">
                                                            <div class="d-flex align-items-center justify-content-between mb-1">
                                                                <div class="d-flex align-items-center">
                                                                    <strong class="@(isReplyTeacher ? "text-primary" : "text-dark") small fw-bold">
                                                                        @reply.User?.Username
                                                                    </strong>
                                                                    @if (isReplyTeacher)
                                                                    {
                                                                        <span class="badge bg-primary-subtle text-primary ms-1" style="font-size: 0.7rem;">Giáo viên</span>
                                                                    }
                                                                    <span class="text-muted small ms-2" style="font-size: 0.75rem;">@reply.CreatedAt?.ToString("dd/MM/yyyy HH:mm")</span>
                                                                </div>
                                                                @if (canDeleteReply)
                                                                {
                                                                    <button type="button" class="btn btn-link text-danger p-0 delete-reply-btn d-flex align-items-center" data-reply-id="@reply.Id" title="Xóa phản hồi">
                                                                        <span class="material-symbols-outlined" style="font-size: 16px;">delete</span>
                                                                    </button>
                                                                }
                                                            </div>
                                                            <p class="mb-0 text-secondary small" style="white-space: pre-wrap;">@reply.ReplyText</p>
                                                        </div>
                                                    }
                                                </div>

                                                <!-- Form phản hồi -->
                                                <form class="create-reply-form d-flex gap-2 mt-2" data-comment-id="@thread.Id">
                                                    <input type="text" class="form-control form-control-sm reply-input bg-white" placeholder="Viết câu trả lời..." required style="border-radius: 20px;" />
                                                    <button type="submit" class="btn btn-primary btn-sm rounded-circle d-flex align-items-center justify-content-center" 
                                                            style="width: 28px; height: 28px; padding: 0;">
                                                        <span class="material-symbols-outlined text-white" style="font-size: 16px;">send</span>
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div id="noCommentsMessage" class="text-center py-4 text-muted bg-light rounded border">
                                        <span class="material-symbols-outlined text-muted fs-2 d-block mb-1 opacity-50">forum</span>
                                        <p class="mb-0 small italic fw-bold">Chưa có bình luận nào. Hãy bắt đầu cuộc thảo luận đầu tiên!</p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>


            @if (Model.IsStudentView)
            {
                @Html.AntiForgeryToken()
                <div id="lessonCompleteCard" class="card card-premium mb-4"
                     data-toggle-url="@Url.Page("./Lesson", "ToggleComplete", new { classId = Model.Class.Id, nodeId = Model.Lesson.Id })">
                    <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3 py-4">
                        <div id="lessonCompleteStatus" class="d-flex align-items-center gap-2">
                            @if (Model.IsCompleted)
                            {
                                <span class="material-symbols-outlined text-success fs-3">check_circle</span>
                                <span class="fw-bold text-success">Bạn đã hoàn thành bài học này.</span>
                            }
                            else
                            {
                                <span class="material-symbols-outlined text-muted fs-3">radio_button_unchecked</span>
                                <span class="fw-semibold text-muted">Học xong rồi? Đánh dấu để hoàn thành bài học.</span>
                            }
                        </div>
                        <button type="button" id="lessonCompleteBtn"
                                class="btn rounded-pill px-4 @(Model.IsCompleted ? "btn-outline-secondary" : "btn-success")"
                                data-completed="@(Model.IsCompleted ? "true" : "false")">
                            @if (Model.IsCompleted)
                            {
                                <span class="d-flex align-items-center gap-1"><span class="material-symbols-outlined" style="font-size: 18px;">history</span> Bỏ hoàn thành</span>
                            }
                            else
                            {
                                <span class="d-flex align-items-center gap-1"><span class="material-symbols-outlined" style="font-size: 18px;">check</span> Hoàn thành</span>
                            }
                        </button>
                    </div>
                </div>
            }

            <div class="text-center">
                <a asp-page="./Details" asp-route-id="@Model.Class.Id" class="btn btn-outline-secondary px-4 py-2 d-inline-flex align-items-center gap-1">
                    <span class="material-symbols-outlined" style="font-size: 18px;">arrow_back</span> Quay lại lớp học
                </a>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.currentLessonNodeId = @Model.Lesson.Id;
    </script>
    <script src="~/js/speech-practice.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // === Học sinh tự tích / bỏ tích hoàn thành bằng AJAX (không reload trang) ===
            const card = document.getElementById('lessonCompleteCard');
            if (card) {
                const btn = document.getElementById('lessonCompleteBtn');
                const status = document.getElementById('lessonCompleteStatus');
                const toggleUrl = card.dataset.toggleUrl;
                const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                const token = tokenInput ? tokenInput.value : '';

                btn.addEventListener('click', async function () {
                    const current = btn.dataset.completed === 'true';
                    const next = !current; // trạng thái muốn đặt

                    const originalHtml = btn.innerHTML;
                    btn.disabled = true;
                    btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

                    try {
                        const body = new URLSearchParams();
                        body.append('isCompleted', next ? 'true' : 'false');
                        body.append('__RequestVerificationToken', token);

                        const res = await fetch(toggleUrl, {
                            method: 'POST',
                            headers: { 'RequestVerificationToken': token },
                            body: body
                        });

                        if (!res.ok) throw new Error('HTTP ' + res.status);
                        const data = await res.json();
                        if (!data.success) throw new Error(data.message || 'Thao tác thất bại');

                        const completed = data.isCompleted;

                        // Cập nhật nút
                        btn.dataset.completed = completed ? 'true' : 'false';
                        btn.classList.toggle('btn-outline-secondary', completed);
                        btn.classList.toggle('btn-success', !completed);
                        btn.innerHTML = completed
                            ? '<span class="d-flex align-items-center gap-1"><span class="material-symbols-outlined" style="font-size: 18px;">history</span> Bỏ hoàn thành</span>'
                            : '<span class="d-flex align-items-center gap-1"><span class="material-symbols-outlined" style="font-size: 18px;">check</span> Hoàn thành</span>';

                        // Cập nhật dòng trạng thái
                        status.innerHTML = completed
                            ? '<span class="material-symbols-outlined text-success fs-3">check_circle</span><span class="fw-bold text-success">Bạn đã hoàn thành bài học này.</span>'
                            : '<span class="material-symbols-outlined text-muted fs-3">radio_button_unchecked</span><span class="fw-semibold text-muted">Học xong rồi? Đánh dấu để hoàn thành bài học.</span>';
                    } catch (err) {
                        btn.innerHTML = originalHtml;
                        console.error('Không thể cập nhật trạng thái:', err);
                    } finally {
                        btn.disabled = false;
                    }
                });
            }

            // === AJAX Q&A Lesson Comments Logic ===
            const createCommentForm = document.getElementById('createCommentForm');
            if (createCommentForm) {
                createCommentForm.addEventListener('submit', async function(e) {
                    e.preventDefault();
                    const textarea = document.getElementById('commentTextInput');
                    const text = textarea.value.trim();
                    if (!text) return;

                    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

                    const formData = new URLSearchParams();
                    formData.append('questionText', text);
                    formData.append('__RequestVerificationToken', token);

                    try {
                        const response = await fetch('?handler=CreateComment&classId=@Model.Class.Id&nodeId=@Model.Lesson.Id', {
                            method: 'POST',
                            headers: {
                                'RequestVerificationToken': token
                            },
                            body: formData
                        });

                        const result = await response.json();
                        if (result.success) {
                            textarea.value = '';
                            
                            const container = document.getElementById('commentsContainer');
                            const noCommentsMsg = document.getElementById('noCommentsMessage');
                            if (noCommentsMsg) {
                                noCommentsMsg.remove();
                            }

                            const isCommentTeacher = result.comment.userRole === 'Teacher' || result.comment.userRole === 'Manager' || result.comment.userRole === 'Admin';
                            const commentHtml = `
                                <div class="comment-card border-bottom pb-4" data-comment-id="${result.comment.id}">
                                    <div class="d-flex align-items-start justify-content-between mb-2">
                                        <div class="d-flex align-items-center">
                                            <div class="rounded-circle text-white text-center me-2 d-flex justify-content-center align-items-center fw-bold" 
                                                 style="width: 36px; height: 36px; font-size: 14px; background-color: var(--color-outline) !important;">
                                                ${result.comment.studentName.charAt(0)}
                                            </div>
                                            <div>
                                                <strong class="text-dark">${result.comment.studentName}</strong>
                                                ${isCommentTeacher ? '<span class="badge bg-primary-subtle text-primary ms-1" style="font-size: 0.75rem;">Giáo viên</span>' : ''}
                                                <div class="text-muted small" style="font-size: 0.75rem;">${result.comment.createdAtFormatted}</div>
                                            </div>
                                        </div>
                                        <button type="button" class="btn btn-link text-danger p-0 delete-comment-btn d-flex align-items-center" data-comment-id="${result.comment.id}" title="Xóa bình luận">
                                            <span class="material-symbols-outlined" style="font-size: 18px;">delete</span>
                                        </button>
                                    </div>
                                    <p class="text-dark mb-3 fw-semibold" style="white-space: pre-wrap; margin-left: 44px !important; font-size: 0.95rem;">${result.comment.questionText}</p>
                                    
                                    <div class="replies-wrapper ms-5 ps-3 border-start" style="border-left: 2px solid var(--color-outline-variant) !important; margin-left: 44px !important;">
                                        <div class="replies-list d-flex flex-column gap-2 mb-2" data-comment-id="${result.comment.id}">
                                        </div>

                                        <form class="create-reply-form d-flex gap-2 mt-2" data-comment-id="${result.comment.id}">
                                            <input type="text" class="form-control form-control-sm reply-input bg-white" placeholder="Viết câu trả lời..." required style="border-radius: 20px;" />
                                            <button type="submit" class="btn btn-primary btn-sm rounded-circle d-flex align-items-center justify-content-center" 
                                                    style="width: 28px; height: 28px; padding: 0;">
                                                <span class="material-symbols-outlined text-white" style="font-size: 16px;">send</span>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            `;
                            container.insertAdjacentHTML('afterbegin', commentHtml);
                            
                            const newCommentCard = container.querySelector(`.comment-card[data-comment-id="${result.comment.id}"]`);
                            const newForm = newCommentCard.querySelector('.create-reply-form');
                            const newDeleteBtn = newCommentCard.querySelector('.delete-comment-btn');
                            
                            bindReplyFormHandler(newForm);
                            bindDeleteCommentBtn(newDeleteBtn);
                        } else {
                            console.error(result.message || 'Lỗi khi tạo bình luận.');
                        }
                    } catch (error) {
                        console.error('Error:', error);
                    }
                });
            }

            // AJAX Q&A Reply Creation
            function bindReplyFormHandler(form) {
                form.addEventListener('submit', async function(e) {
                    e.preventDefault();
                    const threadId = this.dataset.commentId;
                    const input = this.querySelector('.reply-input');
                    const text = input.value.trim();
                    if (!text) return;

                    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

                    const formData = new URLSearchParams();
                    formData.append('threadId', threadId);
                    formData.append('replyText', text);
                    formData.append('__RequestVerificationToken', token);

                    try {
                        const response = await fetch('?handler=CreateReply&classId=@Model.Class.Id', {
                            method: 'POST',
                            headers: {
                                'RequestVerificationToken': token
                            },
                            body: formData
                        });

                        const result = await response.json();
                        if (result.success) {
                            input.value = '';
                            
                            const repliesList = document.querySelector(`.replies-list[data-comment-id="${threadId}"]`);
                            if (repliesList) {
                                const isTeacher = result.reply.userRole === 'Teacher' || result.reply.userRole === 'Manager' || result.reply.userRole === 'Admin';
                                const replyHtml = `
                                    <div class="reply-item py-2 border-bottom-0" data-reply-id="${result.reply.id}">
                                        <div class="d-flex align-items-center justify-content-between mb-1">
                                            <div class="d-flex align-items-center">
                                                <strong class="${isTeacher ? 'text-primary' : 'text-dark'} small fw-bold">
                                                    ${result.reply.userName}
                                                </strong>
                                                ${isTeacher ? '<span class="badge bg-primary-subtle text-primary ms-1" style="font-size: 0.7rem;">Giáo viên</span>' : ''}
                                                <span class="text-muted small ms-2" style="font-size: 0.75rem;">${result.reply.createdAtFormatted}</span>
                                            </div>
                                            <button type="button" class="btn btn-link text-danger p-0 delete-reply-btn d-flex align-items-center" data-reply-id="${result.reply.id}" title="Xóa phản hồi">
                                                <span class="material-symbols-outlined" style="font-size: 16px;">delete</span>
                                            </button>
                                        </div>
                                        <p class="mb-0 text-secondary small" style="white-space: pre-wrap;">${result.reply.replyText}</p>
                                    </div>
                                `;
                                repliesList.insertAdjacentHTML('beforeend', replyHtml);
                                
                                const newDeleteBtn = repliesList.querySelector(`.delete-reply-btn[data-reply-id="${result.reply.id}"]`);
                                if (newDeleteBtn) {
                                    bindDeleteReplyBtn(newDeleteBtn);
                                }
                            }
                        } else {
                            console.error(result.message || 'Lỗi khi tạo phản hồi.');
                        }
                    } catch (error) {
                        console.error('Error:', error);
                    }
                });
            }

            function bindDeleteCommentBtn(btn) {
                btn.addEventListener('click', async function() {
                    if (!confirm('Bạn có chắc chắn muốn xóa bình luận này cùng toàn bộ các câu trả lời liên quan?')) return;
                    const commentId = this.dataset.commentId;
                    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

                    const body = new URLSearchParams();
                    body.append('threadId', commentId);
                    body.append('__RequestVerificationToken', token);

                    try {
                        const response = await fetch('?handler=DeleteComment&classId=@Model.Class.Id', {
                            method: 'POST',
                            headers: { 'RequestVerificationToken': token },
                            body: body
                        });
                        const result = await response.json();
                        if (result.success) {
                            const card = document.querySelector(`.comment-card[data-comment-id="${commentId}"]`);
                            if (card) {
                                card.remove();
                                checkEmptyComments();
                            }
                        } else {
                            console.error(result.message || 'Lỗi khi xóa bình luận.');
                        }
                    } catch (error) {
                        console.error('Error:', error);
                    }
                });
            }

            // Bind delete button for replies
            function bindDeleteReplyBtn(btn) {
                btn.addEventListener('click', async function() {
                    if (!confirm('Bạn có chắc chắn muốn xóa phản hồi này?')) return;
                    const replyId = this.dataset.replyId;
                    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

                    const body = new URLSearchParams();
                    body.append('replyId', replyId);
                    body.append('__RequestVerificationToken', token);

                    try {
                        const response = await fetch('?handler=DeleteReply&classId=@Model.Class.Id', {
                            method: 'POST',
                            headers: { 'RequestVerificationToken': token },
                            body: body
                        });
                        const result = await response.json();
                        if (result.success) {
                            const replyItem = document.querySelector(`.reply-item[data-reply-id="${replyId}"]`);
                            if (replyItem) {
                                replyItem.remove();
                            }
                        } else {
                            console.error(result.message || 'Lỗi khi xóa phản hồi.');
                        }
                    } catch (error) {
                        console.error('Error:', error);
                    }
                });
            }

            function checkEmptyComments() {
                const container = document.getElementById('commentsContainer');
                if (container && container.querySelectorAll('.comment-card').length === 0) {
                    container.innerHTML = `
                        <div id="noCommentsMessage" class="text-center py-4 text-muted bg-light rounded border">
                            <span class="material-symbols-outlined text-muted fs-2 d-block mb-1 opacity-50">forum</span>
                            <p class="mb-0 small italic fw-bold">Chưa có bình luận nào. Hãy bắt đầu cuộc thảo luận đầu tiên!</p>
                        </div>
                    `;
                }
            }

            // Khởi tạo các sự kiện cho các bình luận có sẵn
            document.querySelectorAll('.delete-comment-btn').forEach(btn => bindDeleteCommentBtn(btn));
            document.querySelectorAll('.delete-reply-btn').forEach(btn => bindDeleteReplyBtn(btn));
            document.querySelectorAll('.create-reply-form').forEach(form => bindReplyFormHandler(form));

            // === AJAX / Local Flashcards Logic ===
            const rawCards = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Lesson.Vocabularies!.Select(c => new {
                c.Word,
                c.Hiragana,
                c.Meaning,
                c.Romaji,
                c.DifficultyLevel
            })));

            if (rawCards && rawCards.length > 0) {
                let cards = [...rawCards];
                let currentIndex = 0;

                const scene = document.getElementById('flashcardScene');
                const inner = document.getElementById('flashcardInner');
                const frontTextEl = document.getElementById('frontText');
                const romajiTextEl = document.getElementById('romajiText');
                const backTextEl = document.getElementById('backText');
                const pronTextEl = document.getElementById('pronunciationText');
                
                const prevBtn = document.getElementById('prevBtn');
                const nextBtn = document.getElementById('nextBtn');
                const shuffleBtn = document.getElementById('shuffleBtn');
                const speakBtn = document.getElementById('speakBtn');

                const progressText = document.getElementById('progressText');
                const progressBar = document.getElementById('progressBar');

                let audioPlayer = null;

                function updateCard() {
                    inner.classList.remove('is-flipped');

                    setTimeout(() => {
                        const card = cards[currentIndex];
                        frontTextEl.innerText = card.Word;
                        backTextEl.innerText = card.Meaning;
                        pronTextEl.innerText = card.Hiragana;
                        
                        if (card.Romaji) {
                            romajiTextEl.innerText = card.Romaji;
                            romajiTextEl.style.display = 'block';
                        } else {
                            romajiTextEl.style.display = 'none';
                        }

                        const diffText = card.DifficultyLevel ? `N${card.DifficultyLevel}` : 'N5';
                        document.getElementById('frontDiffBadge').innerText = diffText;
                        document.getElementById('backDiffBadge').innerText = diffText;

                        // Update controls & progress
                        const numCards = cards.length;
                        progressText.innerText = `Thẻ ${currentIndex + 1} / ${numCards}`;
                        
                        const percent = ((currentIndex + 1) / numCards) * 100;
                        progressBar.style.width = `${percent}%`;
                        progressBar.setAttribute('aria-valuenow', percent);

                        prevBtn.disabled = currentIndex === 0;
                        nextBtn.disabled = currentIndex === numCards - 1;
                    }, 150);
                }

                scene.addEventListener('click', function () {
                    inner.classList.toggle('is-flipped');
                });

                speakBtn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    const card = cards[currentIndex];
                    if ('speechSynthesis' in window) {
                        const utterance = new SpeechSynthesisUtterance(card.Word);
                        utterance.lang = 'ja-JP';
                        window.speechSynthesis.cancel();
                        window.speechSynthesis.speak(utterance);
                    } else {
                        alert("Trình duyệt không hỗ trợ phát âm.");
                    }
                });

                prevBtn.addEventListener('click', function () {
                    if (currentIndex > 0) {
                        currentIndex--;
                        updateCard();
                    }
                });

                nextBtn.addEventListener('click', function () {
                    if (currentIndex < cards.length - 1) {
                        currentIndex++;
                        updateCard();
                    }
                });

                shuffleBtn.addEventListener('click', function () {
                    if (cards.length <= 1) return;
                    for (let i = cards.length - 1; i > 0; i--) {
                        const j = Math.floor(Math.random() * (i + 1));
                        [cards[i], cards[j]] = [cards[j], cards[i]];
                    }
                    currentIndex = 0;
                    updateCard();
                    
                    shuffleBtn.classList.add('bg-primary', 'text-white');
                    setTimeout(() => shuffleBtn.classList.remove('bg-primary', 'text-white'), 500);
                });

                // Keyboard Navigation
                document.addEventListener('keydown', function (e) {
                    const tab = document.getElementById('flashcards-content');
                    if (tab && !tab.classList.contains('active')) {
                        return;
                    }
                    if (e.code === 'Space') {
                        e.preventDefault();
                        inner.classList.toggle('is-flipped');
                    } else if (e.code === 'ArrowLeft') {
                        if (currentIndex > 0) {
                            currentIndex--;
                            updateCard();
                        }
                    } else if (e.code === 'ArrowRight') {
                        if (currentIndex < cards.length - 1) {
                            currentIndex++;
                            updateCard();
                        }
                    }
                });

                updateCard();
            }
        });
    </script>
}

