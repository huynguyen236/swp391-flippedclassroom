            transition: all 0.2s ease;
            z-index: 10;
        }
        .audio-btn:hover {
            transform: scale(1.1);
        }
        .fs-8 {
            font-size: 0.775rem;
        }
        .fs-7 {
            font-size: 0.875rem;
        }
    </style>
}

