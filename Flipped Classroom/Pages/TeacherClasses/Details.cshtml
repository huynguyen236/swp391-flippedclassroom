                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 bg-light rounded">
                            <p class="text-muted mb-0">Không có học viên nào khả dụng ?? thêm.</p>
                        </div>
                    }
                </div>
                <div class="modal-footer border-top-0 pt-0 pb-4 px-4 gap-2">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm" style="background-color: #1a73e8; border: none;">Xác Nhận Thêm</button>
