@page
@model Flipped_Classroom.Pages.TeacherClasses.DetailsModel

@{
    ViewData["Title"] = "Classroom Details";
}


<div class="container py-5 teacher-details-container">
    <div class="row justify-content-center">
        <div class="col-lg-12">
            
            <!-- Breadcrumbs -->
            <div class="d-flex align-items-center gap-2 mb-3 text-secondary small">
                <a asp-page="./Index" class="text-secondary text-decoration-none hover-text-primary">Lớp học của tôi</a>
                <span class="material-symbols-outlined" style="font-size:16px;">chevron_right</span>
                <span class="text-dark fw-medium">Chi tiết lớp học</span>
            </div>

            <!-- Hero Class Header Section -->
            <div class="hero-header-banner p-4 p-md-5 mb-4 rounded-3 d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-4">
                <div class="hero-header-decor"></div>
                <div class="relative z-1">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge bg-white text-primary rounded-pill px-3 py-1.5 shadow-sm small fw-bold">@Html.DisplayFor(model => model.Class.Status)</span>
                    </div>
                    <h2 class="fw-bold mb-2 text-white" style="font-size: 2rem;">@Html.DisplayFor(model => model.Class.ClassName)</h2>
                    <p class="mb-0 text-white-50" style="max-width: 600px;">
                        @(string.IsNullOrEmpty(Model.Class.Description) ? "Chưa có mô tả cho lớp học này." : Model.Class.Description)
                    </p>
                </div>
                <div class="glass-card-premium shrink-0 relative z-1">
                    <span class="text-white-50 small text-uppercase tracking-wider">Mã Tham Gia</span>
                    <div class="d-flex align-items-center justify-content-center gap-2 bg-white text-dark px-3 py-2 rounded-2 mt-2 border">
                        <strong class="font-monospace text-primary" style="font-size: 1.15rem; letter-spacing: 0.5px;">@Html.DisplayFor(model => model.Class.InviteCode)</strong>
                        <button class="btn p-0 text-secondary hover-text-primary d-flex align-items-center justify-content-center" onclick="copyInviteCodeDetails(this, '@Model.Class.InviteCode')" title="Copy mã">
                            <span class="material-symbols-outlined" style="font-size: 18px;">content_copy</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Date and Manager Info Card -->
            <div class="card card-premium p-4 mb-4">
                <div class="row g-3 align-items-center">
                    <div class="col-md-4">
                        <div class="d-flex align-items-center p-3 rounded" style="background-color: var(--color-surface-container-low);">
                            <span class="material-symbols-outlined text-primary fs-3 me-3">calendar_today</span>
                            <div>
                                <div class="text-muted small">Ngày Bắt Đầu</div>
                                <div class="fw-bold">@Html.DisplayFor(model => model.Class.StartDate)</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="d-flex align-items-center p-3 rounded" style="background-color: var(--color-surface-container-low);">
                            <span class="material-symbols-outlined text-primary fs-3 me-3">event</span>
                            <div>
                                <div class="text-muted small">Ngày Kết Thúc</div>
                                <div class="fw-bold">@Html.DisplayFor(model => model.Class.EndDate)</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="d-flex align-items-center p-3 rounded" style="background-color: var(--color-surface-container-low);">
                            <div class="avatar-initials-circle bg-primary me-3 text-white">
                                @(Model.Class.Manager?.Username?.FirstOrDefault() ?? '?')
                            </div>
                            <div>
                                <div class="text-muted small">Người Quản Lý</div>
                                <div class="fw-bold">@Html.DisplayFor(model => model.Class.Manager.Username)</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <script>
                function copyInviteCodeDetails(btn, code) {
                    navigator.clipboard.writeText(code).then(function() {
                        var originalHtml = btn.innerHTML;
                        btn.innerHTML = '<span class="material-symbols-outlined" style="color: #34a853;">check</span>';
                        setTimeout(function() {
                            btn.innerHTML = originalHtml;
                        }, 2000);
                    }, function(err) {
                        console.error('Lỗi khi copy mã: ', err);
                    });
                }
            </script>

            <!-- Sticky Menu Tabs Navigation -->
            <ul class="nav nav-tabs nav-tabs-premium mb-4" id="classroomTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="dashboard-tab" data-bs-toggle="tab" data-bs-target="#dashboard-content" type="button" role="tab" aria-controls="dashboard-content" aria-selected="true">
                        <span class="material-symbols-outlined">dashboard</span> Tổng Quan
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="curriculum-tab" data-bs-toggle="tab" data-bs-target="#curriculum-content" type="button" role="tab" aria-controls="curriculum-content" aria-selected="false">
                        <span class="material-symbols-outlined">route</span> Lộ Trình Học
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="students-tab" data-bs-toggle="tab" data-bs-target="#students-content" type="button" role="tab" aria-controls="students-content" aria-selected="false">
                        <span class="material-symbols-outlined">group</span> Học Viên (@(Model.Class.ClassMembers?.Count ?? 0))
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="assignments-tab" data-bs-toggle="tab" data-bs-target="#assignments-content" type="button" role="tab" aria-controls="assignments-content" aria-selected="false">
                        <span class="material-symbols-outlined">assignment</span> Bài Tập
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="qa-tab" data-bs-toggle="tab" data-bs-target="#qa-content" type="button" role="tab" aria-controls="qa-content" aria-selected="false">
                        <span class="material-symbols-outlined">forum</span> Hỏi & Đáp (@(Model.QaThreads?.Count ?? 0))
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="schedule-tab" data-bs-toggle="tab" data-bs-target="#schedule-content" type="button" role="tab" aria-controls="schedule-content" aria-selected="false">
                        <span class="material-symbols-outlined">calendar_month</span> Lịch Học
                    </button>
                </li>
            </ul>

            <!-- Tab Content -->
            <div class="tab-content" id="classroomTabContent">
                
                <!-- Overview (Tổng Quan) Tab -->
                <div class="tab-pane fade show active" id="dashboard-content" role="tabpanel" aria-labelledby="dashboard-tab">
                    <div class="row g-4 mb-4">
                        <div class="col-md-3">
                            <div class="stat-bento-card stat-bg-blue">
                                <div>
                                    <div class="small fw-semibold opacity-75">Sĩ số lớp</div>
                                    <h3 class="fw-bold mb-0 mt-1">@Model.TotalStudents</h3>
                                </div>
                                <div class="stat-icon">
                                    <span class="material-symbols-outlined text-primary">group</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="stat-bento-card stat-bg-green">
                                <div>
                                    <div class="small fw-semibold opacity-75">Tổng bài học</div>
                                    <h3 class="fw-bold mb-0 mt-1">@Model.TotalLessonsCount</h3>
                                </div>
                                <div class="stat-icon">
                                    <span class="material-symbols-outlined text-success">menu_book</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="stat-bento-card stat-bg-yellow">
                                <div>
                                    <div class="small fw-semibold opacity-75">Tiến độ trung bình</div>
                                    <h3 class="fw-bold mb-0 mt-1">@Model.AvgClassProgress%</h3>
                                </div>
                                <div class="stat-icon">
                                    <span class="material-symbols-outlined" style="color: #f2a600;">trending_up</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="stat-bento-card stat-bg-red">
                                <div>
                                    <div class="small fw-semibold opacity-75">Tỷ lệ nộp bài</div>
                                    <h3 class="fw-bold mb-0 mt-1">@Model.AvgSubmissionRate%</h3>
                                </div>
                                <div class="stat-icon">
                                    <span class="material-symbols-outlined text-danger">assignment_turned_in</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-4">
                        <!-- Left Panel: Tiến độ chi tiết Lộ trình -->
                        <div class="col-lg-6">
                            <div class="card card-premium h-100">
                                <div class="card-premium-header">
                                    <h5 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                                        <span class="material-symbols-outlined text-primary">route</span>
                                        Tiến Độ Lộ Trình Học Của Lớp
                                    </h5>
                                </div>
                                <div class="card-body p-4">
                                    @if (Model.Class.Curriculum == null)
                                    {
                                        <p class="text-muted text-center py-4">Lớp chưa có khung chương trình.</p>
                                    }
                                    else
                                    {
                                        var allNodes = Model.Class.Curriculum.Nodes;
                                        var chapters = allNodes.Where(n => n.ParentNodeId == null).OrderBy(n => n.NodeOrder).ThenBy(n => n.Id).ToList();

                                        if (!chapters.Any())
                                        {
                                            <p class="text-muted text-center py-4">Chương trình chưa có nội dung.</p>
                                        }
                                        else
                                        {
                                            <div class="d-flex flex-column gap-3">
                                                @foreach (var chapter in chapters)
                                                {
                                                    var lessons = allNodes.Where(n => n.ParentNodeId == chapter.Id).OrderBy(n => n.NodeOrder).ThenBy(n => n.Id).ToList();
                                                    <div>
                                                        <h6 class="fw-bold text-secondary mb-2 small text-uppercase d-flex align-items-center gap-1">
                                                            <span class="material-symbols-outlined text-warning" style="font-size:18px;">folder</span>
                                                            @chapter.Title
                                                        </h6>
                                                        @if (!lessons.Any())
                                                        {
                                                            <div class="text-muted small ps-4 mb-2">Chưa có bài học.</div>
                                                        }
                                                        else
                                                        {
                                                            <div class="d-flex flex-column gap-2 ps-4">
                                                                @foreach (var lesson in lessons)
                                                                {
                                                                    var completedCount = Model.NodeCompletionCounts.TryGetValue(lesson.Id, out var count) ? count : 0;
                                                                    var completionPercent = Model.TotalStudents > 0 ? (completedCount * 100 / Model.TotalStudents) : 0;
                                                                    
                                                                    var pendingStudents = Model.Class.ClassMembers
                                                                        .Where(cm => !Model.StudentProgressMap.TryGetValue(cm.UserId, out var dict) || !dict.ContainsKey(lesson.Id))
                                                                        .Select(cm => cm.User?.Username)
                                                                        .ToList();

                                                                    <div class="bg-light p-3 rounded border border-light">
                                                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                                                            <span class="fw-bold text-dark small">@lesson.Title</span>
                                                                            <span class="badge bg-white text-primary border rounded-pill px-2">
                                                                                @completedCount/@Model.TotalStudents HS hoàn thành
                                                                            </span>
                                                                        </div>
                                                                        <div class="progress-track-custom mb-2">
                                                                            <div class="progress-fill-success" style="width: @completionPercent%;"></div>
                                                                        </div>
                                                                        <div class="small">
                                                                            @if (pendingStudents.Any())
                                                                            {
                                                                                <span class="text-danger" style="font-size: 0.8rem; font-weight: 500;">
                                                                                    <strong>Chưa xong:</strong> @(string.Join(", ", pendingStudents))
                                                                                </span>
                                                                            }
                                                                            else
                                                                            {
                                                                                <span class="text-success" style="font-size: 0.8rem; font-weight: 500;">
                                                                                    <span class="material-symbols-outlined" style="font-size:16px;">check_circle</span> 100% Học viên đã hoàn thành
                                                                                </span>
                                                                            }
                                                                        </div>
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Right Panel: Tình trạng nộp Bài tập -->
                        <div class="col-lg-6">
                            <div class="card card-premium h-100">
                                <div class="card-premium-header">
                                    <h5 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                                        <span class="material-symbols-outlined text-success">assignment_turned_in</span>
                                        Tình Trạng Nộp Bài Tập
                                    </h5>
                                </div>
                                <div class="card-body p-4">
                                    @if (Model.Assignments == null || !Model.Assignments.Any())
                                    {
                                        <p class="text-muted text-center py-4">Lớp chưa có bài tập nào được tạo.</p>
                                    }
                                    else
                                    {
                                        <div class="d-flex flex-column gap-3">
                                            @foreach (var assign in Model.Assignments)
                                            {
                                                var assignSubs = Model.AssignmentSubmissions.ContainsKey(assign.Id) ? Model.AssignmentSubmissions[assign.Id] : new List<Submission>();
                                                var submittedStudentIds = assignSubs.Select(s => s.StudentId).ToList();
                                                
                                                var unsubmittedStudents = Model.Class.ClassMembers
                                                    .Where(cm => !submittedStudentIds.Contains(cm.UserId))
                                                    .Select(cm => cm.User?.Username)
                                                    .ToList();

                                                var ungradedStudents = assignSubs
                                                    .Where(s => s.Status != "Graded")
                                                    .Select(s => s.Student?.Username)
                                                    .ToList();

                                                var submissionPercent = Model.TotalStudents > 0 ? (assignSubs.Count * 100 / Model.TotalStudents) : 0;

                                                <div class="bg-light p-3 rounded border border-light">
                                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                                        <span class="fw-bold text-dark small">@assign.Title</span>
                                                        <span class="badge bg-white text-success border rounded-pill px-2">
                                                            @assignSubs.Count/@Model.TotalStudents Đã nộp
                                                        </span>
                                                    </div>
                                                    <div class="text-muted mb-2 small d-flex align-items-center gap-1">
                                                        <span class="material-symbols-outlined" style="font-size:14px;">calendar_month</span> 
                                                        Hạn: @(assign.DueDate.HasValue ? assign.DueDate.Value.ToString("dd/MM/yyyy HH:mm") : "Không giới hạn")
                                                    </div>
                                                    <div class="progress-track-custom mb-2">
                                                        <div class="progress-fill-primary" style="width: @submissionPercent%;"></div>
                                                    </div>
                                                    
                                                    <div class="d-flex flex-column gap-1 small mt-2">
                                                        @if (unsubmittedStudents.Any())
                                                        {
                                                            <span class="text-danger" style="font-size: 0.8rem; font-weight: 500;">
                                                                <strong>Chưa nộp:</strong> @(string.Join(", ", unsubmittedStudents))
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-success" style="font-size: 0.8rem; font-weight: 500;">
                                                                <span class="material-symbols-outlined" style="font-size:16px;">check_circle</span> 100% Học viên đã nộp bài
                                                            </span>
                                                        }

                                                        @if (ungradedStudents.Any())
                                                        {
                                                            <span class="text-warning" style="font-size: 0.8rem; font-weight: 500; color: #b07000 !important;">
                                                                <strong>Chờ chấm điểm:</strong> @(string.Join(", ", ungradedStudents))
                                                            </span>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Learning Path (Lộ Trình Học) Tab -->
                <div class="tab-pane fade" id="curriculum-content" role="tabpanel" aria-labelledby="curriculum-tab">
                    <div class="card card-premium">
                        <div class="card-premium-header d-flex justify-content-between align-items-center flex-wrap gap-3">
                            <h4 class="fw-bold mb-0 text-primary d-flex align-items-center gap-2">
                                <span class="material-symbols-outlined">route</span> Lộ Trình Học
                            </h4>
                            @if (Model.Class.Curriculum != null)
                            {
                                <span class="badge bg-light text-primary border rounded-pill px-3 py-2 fw-bold">@Model.Class.Curriculum.CurriculumName</span>
                            }
                        </div>
                        <div class="card-body p-4">
                            @if (Model.Class.Curriculum == null)
                            {
                                <div class="text-center text-muted py-5">
                                    <span class="material-symbols-outlined opacity-50 mb-2" style="font-size: 48px;">folder_off</span>
                                    <h6 class="text-muted">Lớp này chưa có khung chương trình.</h6>
                                </div>
                            }
                            else
                            {
                                var allNodes = Model.Class.Curriculum.Nodes;
                                var chapters = allNodes.Where(n => n.ParentNodeId == null).OrderBy(n => n.NodeOrder).ThenBy(n => n.Id).ToList();

                                if (!chapters.Any())
                                {
                                    <div class="text-center text-muted py-5">
                                        <span class="material-symbols-outlined opacity-50 mb-2" style="font-size: 48px;">menu_book</span>
                                        <h6 class="text-muted">Khung chương trình chưa có bài học nào.</h6>
                                    </div>
                                }
                                else
                                {
                                    @Html.AntiForgeryToken()
                                    <div class="accordion" id="teacherLearningPathAccordion"
                                         data-toggle-url="@Url.Page("./Details", "ToggleNodeLock", new { id = Model.Class.Id })">
                                        @for (int i = 0; i < chapters.Count; i++)
                                        {
                                            var chapter = chapters[i];
                                            var lessons = allNodes.Where(n => n.ParentNodeId == chapter.Id).OrderBy(n => n.NodeOrder).ThenBy(n => n.Id).ToList();
                                            var collapseId = $"tc-collapse-{chapter.Id}";
                                            var headingId = $"tc-heading-{chapter.Id}";

                                            var chapterUnlocked = Model.NodeUnlockStatus.TryGetValue(chapter.Id, out var cu) && cu;
                                            <div class="accordion-item border-0 mb-3 shadow-sm" style="border-radius: 10px; overflow: hidden;">
                                                <h2 class="accordion-header d-flex align-items-center bg-white" id="@headingId" style="border-radius: 10px;">
                                                    <button class="accordion-button accordion-premium-button @(i == 0 ? "" : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="@(i == 0 ? "true" : "false")" aria-controls="@collapseId">
                                                        <span class="material-symbols-outlined text-warning me-2">folder</span> 
                                                        @chapter.Title
                                                        <span class="badge bg-light text-muted border rounded-pill ms-2 small font-monospace">@lessons.Count bài</span>
                                                        <span class="node-lock-badge badge rounded-pill ms-2 @(chapterUnlocked ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary")" data-node-id="@chapter.Id">
                                                            @if (chapterUnlocked)
                                                            {
                                                                <span class="d-flex align-items-center gap-1"><span class="material-symbols-outlined" style="font-size: 14px;">lock_open</span>Đã mở</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="d-flex align-items-center gap-1"><span class="material-symbols-outlined" style="font-size: 14px;">lock</span>Đang khóa</span>
                                                            }
                                                        </span>
                                                    </button>
                                                    <button type="button"
                                                            class="node-lock-toggle btn btn-premium-outline btn-sm ms-3 me-3 flex-shrink-0 @(chapterUnlocked ? "btn-outline-warning" : "btn-outline-success")"
                                                            data-node-id="@chapter.Id"
                                                            data-unlocked="@(chapterUnlocked ? "true" : "false")"
                                                            title="@(chapterUnlocked ? "Khóa chương này" : "Mở chương này cho học sinh")"
                                                            style="padding: 0.4rem 0.8rem; font-size: 0.85rem;">
                                                        @if (chapterUnlocked)
                                                        {
                                                            <span class="d-flex align-items-center gap-1"><span class="material-symbols-outlined" style="font-size:16px;">lock</span>Khóa</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="d-flex align-items-center gap-1"><span class="material-symbols-outlined" style="font-size:16px;">lock_open</span>Mở</span>
                                                        }
                                                    </button>
                                                </h2>
                                                <div id="@collapseId" class="accordion-collapse collapse accordion-premium-collapse @(i == 0 ? "show" : "")" aria-labelledby="@headingId" data-bs-parent="#teacherLearningPathAccordion">
                                                    <div class="accordion-body p-0">
                                                        @{
                                                            var chapterQuizzes = chapter.Quizzes.Where(q => q.ClassId == Model.Class.Id && !q.IsAlwaysOpen).ToList();
                                                        }

                                                        @if (chapterQuizzes.Any())
                                                        {
                                                            <div class="px-4 py-3 bg-light border-bottom">
                                                                <span class="fs-8 fw-bold text-secondary text-uppercase d-block mb-2" style="font-size: 0.75rem; letter-spacing: 0.5px;">Bài test chương:</span>
                                                                <div class="d-flex flex-column gap-2">
                                                                    @foreach (var quiz in chapterQuizzes)
                                                                    {
                                                                        <div class="d-flex align-items-center justify-content-between py-2 border-bottom border-light">
                                                                            <div class="d-flex align-items-center gap-2">
                                                                                <i class="bi bi-file-earmark-check-fill text-warning fs-5"></i>
                                                                                <div>
                                                                                    <span class="fw-semibold text-dark">@quiz.Title</span>
                                                                                    <span class="text-muted small d-block">@quiz.DurationMinutes phút | @quiz.QuizQuestions.Count câu</span>
                                                                                </div>
                                                                                <span class="badge @(quiz.Status == "Published" ? "bg-success bg-opacity-10 text-success" : "bg-secondary bg-opacity-10 text-secondary") ms-2">@quiz.Status</span>
                                                                            </div>
                                                                        </div>
                                                                    }
                                                                </div>
                                                            </div>
                                                        }

                                                        @if (!lessons.Any() && !chapterQuizzes.Any())
                                                        {
                                                            <p class="text-muted text-center py-3 mb-0 small">Chương này chưa có bài học hoặc bài test.</p>
                                                        }
                                                        else if (lessons.Any())
                                                        {
                                                            <ul class="list-group list-group-flush mb-0">
                                                                @foreach (var lesson in lessons)
                                                                {
                                                                    var completedCount = Model.NodeCompletionCounts.TryGetValue(lesson.Id, out var c) ? c : 0;
                                                                    var lessonQuizzes = lesson.Quizzes.Where(q => q.ClassId == Model.Class.Id && !q.IsAlwaysOpen).ToList();
                                                                    
                                                                    <li class="list-group-item d-flex flex-column py-3 px-4 bg-transparent border-bottom">
                                                                        <div class="d-flex justify-content-between align-items-center w-100">
                                                                            <div class="d-flex align-items-center gap-2">
                                                                                <span class="material-symbols-outlined text-primary">article</span>
                                                                                <span class="fw-bold text-dark">@lesson.Title</span>
                                                                                @if (lesson.Materials.Any())
                                                                                {
                                                                                    <span class="badge bg-light text-muted border rounded-pill small">@lesson.Materials.Count tài liệu</span>
                                                                                }
                                                                                <span class="badge bg-light text-muted border rounded-pill small">
                                                                                    <span class="material-symbols-outlined" style="font-size:14px; margin-right:2px;">check</span>@completedCount/@Model.TotalStudents HS hoàn thành
                                                                                </span>
                                                                            </div>
                                                                            <div class="d-flex align-items-center gap-2">
                                                                                <a asp-page="/StudentClasses/Lesson" asp-route-classId="@Model.Class.Id" asp-route-nodeId="@lesson.Id"
                                                                                   class="btn btn-premium-outline btn-sm py-1 px-3" style="font-size: 0.8rem;">
                                                                                    Xem bài <span class="material-symbols-outlined" style="font-size:14px; margin-left: 2px;">visibility</span>
                                                                                </a>
                                                                            </div>
                                                                        </div>

                                                                        @if (lessonQuizzes.Any())
                                                                        {
                                                                            <div class="mt-3 ps-4 d-flex flex-column gap-2 border-top pt-2">
                                                                                @foreach (var quiz in lessonQuizzes)
                                                                                {
                                                                                    <div class="d-flex align-items-center justify-content-between py-2 border-bottom border-light">
                                                                                        <div class="d-flex align-items-center gap-2">
                                                                                            <span class="material-symbols-outlined text-warning" style="font-size: 20px;">assignment_turned_in</span>
                                                                                            <div>
                                                                                                <span class="fw-semibold text-dark" style="font-size: 0.9rem;">@quiz.Title</span>
                                                                                                <span class="text-muted small d-block">@quiz.DurationMinutes phút | @quiz.QuizQuestions.Count câu</span>
                                                                                            </div>
                                                                                            <span class="badge @(quiz.Status == "Published" ? "bg-success bg-opacity-10 text-success" : "bg-secondary bg-opacity-10 text-secondary") ms-2">@quiz.Status</span>
                                                                                        </div>
                                                                                    </div>
                                                                                }
                                                                            </div>
                                                                        }
                                                                    </li>
                                                                }
                                                            </ul>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>

                <!-- Student Roster (Học Viên) Tab -->
                <div class="tab-pane fade" id="students-content" role="tabpanel" aria-labelledby="students-tab">
                    <div class="card card-premium">
                        <div class="card-premium-header d-flex justify-content-between align-items-center flex-wrap gap-3">
                            <h4 class="fw-bold mb-0 text-primary d-flex align-items-center gap-2">
                                <span class="material-symbols-outlined">group</span> Danh Sách Học Viên
                            </h4>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-premium-outline px-3 send-email-btn shadow-sm text-nowrap" data-class-id="@Model.Class.Id" data-class-name="@Model.Class.ClassName">
                                    <span class="material-symbols-outlined">mail</span> Gửi Email
                                </button>
                                <button type="button" class="btn btn-premium-outline px-3 shadow-sm text-nowrap" data-bs-toggle="modal" data-bs-target="#createGroupModal">
                                    <span class="material-symbols-outlined">groups</span> Chia Nhóm (@(Model.Class.Groups?.Count ?? 0))
                                </button>
                                <button type="button" class="btn btn-premium-primary px-3 shadow-sm text-nowrap" data-bs-toggle="modal" data-bs-target="#addStudentModal">
                                    <span class="material-symbols-outlined">person_add</span> Thêm Học Viên
                                </button>
                            </div>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead>
                                        <tr class="table-light text-muted">
                                            <th class="px-4 py-3 border-0 fw-semibold text-uppercase small">Học Viên</th>
                                            <th class="px-4 py-3 border-0 fw-semibold text-uppercase small">Email</th>
                                            <th class="px-4 py-3 border-0 fw-semibold text-uppercase small">Nhóm</th>
                                            <th class="px-4 py-3 border-0 fw-semibold text-center text-uppercase small">Support Team</th>
                                            <th class="px-4 py-3 border-0 fw-semibold text-center text-uppercase small">Lộ Trình</th>
                                            <th class="px-4 py-3 border-0 fw-semibold text-end text-uppercase small" style="width: 120px;">Thao Tác</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.Class.ClassMembers != null && Model.Class.ClassMembers.Any())
                                        {
                                            var colorIndices = new[] { "blue", "pink", "purple" };
                                            var index = 0;
                                            foreach (var member in Model.Class.ClassMembers)
                                            {
                                                var colorClass = "avatar-bg-" + colorIndices[index % 3];
                                                index++;
                                                <tr class="border-bottom">
                                                    <td class="px-4 py-3">
                                                        <div class="d-flex align-items-center">
                                                            <div class="avatar-initials-circle @colorClass me-3">
                                                                @(member.User?.Username?.FirstOrDefault() ?? '?')
                                                            </div>
                                                            <div class="fw-bold text-dark">@(member.User?.Username ?? "Unknown")</div>
                                                        </div>
                                                    </td>
                                                    <td class="px-4 py-3 text-secondary">@(member.User?.Email ?? "-")</td>
                                                    <td class="px-4 py-3">
                                                        @{
                                                            var assignedGroup = Model.Class.Groups?.FirstOrDefault(g => g.GroupMembers.Any(gm => gm.StudentId == member.UserId));
                                                        }
                                                        <form method="post" asp-page-handler="AssignGroup" asp-route-id="@Model.Class.Id">
                                                            <input type="hidden" name="studentId" value="@member.UserId" />
                                                            <select name="groupId" class="form-select form-select-sm shadow-sm" style="border-radius: 6px; max-width: 150px;" onchange="this.form.submit()">
                                                                <option value="">Chưa có nhóm</option>
                                                                @if (Model.Class.Groups != null)
                                                                {
                                                                    foreach (var group in Model.Class.Groups)
                                                                    {
                                                                        <option value="@group.Id" selected="@(assignedGroup?.Id == group.Id)">@group.GroupName</option>
                                                                    }
                                                                }
                                                            </select>
                                                        </form>
                                                    </td>
                                                    <td class="px-4 py-3 text-center">
                                                        @if (member.IsSupportTeam == true)
                                                        {
                                                            <span class="badge bg-success-subtle text-success px-3 py-1.5 rounded-pill fw-bold">Có</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-light text-secondary border px-3 py-1.5 rounded-pill fw-semibold">Không</span>
                                                        }
                                                    </td>
                                                    <td class="px-4 py-3 text-center">
                                                        <button type="button" class="btn btn-premium-outline btn-sm py-1.5 px-3" data-bs-toggle="modal" data-bs-target="#progressModal-@member.UserId">
                                                            <span class="material-symbols-outlined" style="font-size:16px; margin-right:4px;">monitoring</span> Tiến độ
                                                        </button>
                                                        
                                                        <!-- Modal Tiến độ học tập -->
                                                        <div class="modal fade text-start" id="progressModal-@member.UserId" tabindex="-1" aria-labelledby="progressModalLabel-@member.UserId" aria-hidden="true">
                                                            <div class="modal-dialog modal-lg modal-dialog-scrollable">
                                                                <div class="modal-content" style="border-radius: 15px; border: none; box-shadow: 0 10px 30px rgba(0,0,0,0.15);">
                                                                    <div class="modal-header bg-light border-0 py-3">
                                                                        <h5 class="modal-title fw-bold text-primary" id="progressModalLabel-@member.UserId">
                                                                            <span class="material-symbols-outlined me-2">monitoring</span> Tiến độ: @(member.User?.Username ?? "Học viên")
                                                                        </h5>
                                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                                    </div>
                                                                    <div class="modal-body p-4 bg-light">
                                                                        @if (Model.Class.Curriculum == null)
                                                                        {
                                                                            <div class="text-center text-muted py-4">
                                                                                <span class="material-symbols-outlined opacity-50 mb-2" style="font-size: 36px;">folder_off</span>
                                                                                <h6>Lớp này chưa có khung chương trình.</h6>
                                                                            </div>
                                                                        }
                                                                        else
                                                                        {
                                                                            var allNodes = Model.Class.Curriculum.Nodes;
                                                                            var chapters = allNodes.Where(n => n.ParentNodeId == null).OrderBy(n => n.NodeOrder).ThenBy(n => n.Id).ToList();

                                                                            if (!chapters.Any())
                                                                            {
                                                                                <div class="text-center text-muted py-4">
                                                                                    <span class="material-symbols-outlined opacity-50 mb-2" style="font-size: 36px;">menu_book</span>
                                                                                    <h6>Chưa có bài học nào trong chương trình.</h6>
                                                                                </div>
                                                                            }
                                                                            else
                                                                            {
                                                                                <div class="d-flex flex-column gap-3">
                                                                                    @foreach (var chapter in chapters)
                                                                                    {
                                                                                        var lessons = allNodes.Where(n => n.ParentNodeId == chapter.Id).OrderBy(n => n.NodeOrder).ThenBy(n => n.Id).ToList();
                                                                                        var chapterUnlocked = Model.NodeUnlockStatus.TryGetValue(chapter.Id, out var cu) && cu;
                                                                                        
                                                                                        <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                                                                                            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                                                                                                <span class="fw-bold text-dark d-flex align-items-center gap-1"><span class="material-symbols-outlined text-warning" style="font-size: 18px;">folder</span> @chapter.Title</span>
                                                                                                <span class="badge @(chapterUnlocked ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary") rounded-pill">
                                                                                                    @(chapterUnlocked ? "Đang mở" : "Đang khóa")
                                                                                                </span>
                                                                                            </div>
                                                                                            <div class="card-body p-0 bg-white">
                                                                                                @if (!lessons.Any())
                                                                                                {
                                                                                                    <div class="p-3 text-muted small italic">Chương này chưa có bài học.</div>
                                                                                                }
                                                                                                else
                                                                                                {
                                                                                                    <ul class="list-group list-group-flush mb-0">
                                                                                                        @foreach (var lesson in lessons)
                                                                                                        {
                                                                                                            var isCompleted = Model.StudentProgressMap.TryGetValue(member.UserId, out var dict) && dict.ContainsKey(lesson.Id);
                                                                                                            var completedAt = isCompleted ? dict[lesson.Id] : null;
                                                                                                            
                                                                                                            <li class="list-group-item d-flex justify-content-between align-items-center py-2.5 px-3 border-0 border-top bg-transparent">
                                                                                                                <div class="d-flex align-items-center gap-2">
                                                                                                                    @if (isCompleted)
                                                                                                                    {
                                                                                                                        <span class="material-symbols-outlined text-success" style="font-size: 20px; font-variation-settings: 'FILL' 1;">check_circle</span>
                                                                                                                    }
                                                                                                                    else
                                                                                                                    {
                                                                                                                        <span class="material-symbols-outlined text-muted" style="font-size: 20px;">circle</span>
                                                                                                                    }
                                                                                                                    <span class="@(isCompleted ? "text-dark fw-bold" : "text-muted") small">@lesson.Title</span>
                                                                                                                </div>
                                                                                                                <div>
                                                                                                                    @if (isCompleted)
                                                                                                                    {
                                                                                                                        <span class="badge bg-success-subtle text-success rounded-pill px-2" style="font-size: 0.75rem;">
                                                                                                                            Hoàn thành @(completedAt.HasValue ? completedAt.Value.ToString("dd/MM/yyyy HH:mm") : "")
                                                                                                                        </span>
                                                                                                                    }
                                                                                                                    else
                                                                                                                    {
                                                                                                                        <span class="badge bg-light text-secondary rounded-pill px-2" style="font-size: 0.75rem;">Chưa hoàn thành</span>
                                                                                                                    }
                                                                                                                </div>
                                                                                                            </li>
                                                                                                        }
                                                                                                    </ul>
                                                                                                }
                                                                                            </div>
                                                                                        </div>
                                                                                    }
                                                                                </div>
                                                                            }
                                                                        }
                                                                    </div>
                                                                    <div class="modal-footer border-0 bg-light py-2">
                                                                        <button type="button" class="btn btn-secondary px-4 rounded-pill" data-bs-dismiss="modal">Đóng</button>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td class="px-4 py-3 text-end">
                                                        <button type="button" class="btn btn-premium-danger-outline btn-sm" onclick="showDeleteStudentModal('@member.UserId', '@(member.User?.Username)')">
                                                            <span class="material-symbols-outlined" style="font-size:16px;">delete</span> Xóa
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="6" class="text-center py-5 text-muted">
                                                    <span class="material-symbols-outlined opacity-50 mb-3" style="font-size: 48px;">group_off</span>
                                                    <h6 class="text-muted">Chưa có học viên nào trong lớp</h6>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Assignments Tab -->
                <div class="tab-pane fade" id="assignments-content" role="tabpanel" aria-labelledby="assignments-tab">
                    <div class="card card-premium">
                        <div class="card-premium-header bg-white border-bottom d-flex justify-content-between align-items-center flex-wrap gap-3">
                            <h4 class="fw-bold mb-0 text-primary d-flex align-items-center gap-2">
                                <span class="material-symbols-outlined">assignment</span> Danh Sách Bài Tập
                            </h4>
                            <button type="button" class="btn btn-premium-primary px-3 shadow-sm text-nowrap" data-bs-toggle="modal" data-bs-target="#createAssignmentModal">
                                <span class="material-symbols-outlined">add_task</span> Tạo Bài Tập
                            </button>
                        </div>
                        <div class="card-body p-4">
                            @if (TempData["SuccessMessage"] != null)
                            {
                                <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
                                    <span class="material-symbols-outlined me-2 text-success">check_circle</span> @TempData["SuccessMessage"]
                                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                </div>
                            }

                            @if (!ViewData.ModelState.IsValid)
                            {
                                <div class="alert alert-danger alert-dismissible fade show rounded-3" role="alert">
                                    <div asp-validation-summary="All" class="text-danger small"></div>
                                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                </div>
                            }

                            @if (Model.Assignments != null && Model.Assignments.Any())
                            {
                                <div class="row g-4">
                                    @foreach (var assign in Model.Assignments)
                                    {
                                        var submissions = Model.AssignmentSubmissions.ContainsKey(assign.Id) 
                                            ? Model.AssignmentSubmissions[assign.Id] 
                                            : new List<Submission>();
                                        
                                        <div class="col-12">
                                            <div class="card border shadow-sm rounded-3 overflow-hidden">
                                                <div class="card-header bg-light p-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                                                    <div>
                                                        <h5 class="fw-bold text-dark mb-1">@assign.Title</h5>
                                                        <div class="d-flex flex-wrap gap-3 align-items-center mt-1 text-muted small">
                                                            <span class="d-flex align-items-center gap-1"><span class="material-symbols-outlined" style="font-size:14px;">calendar_today</span> Hạn: @(assign.DueDate.HasValue ? assign.DueDate.Value.ToString("dd/MM/yyyy HH:mm") : "Không giới hạn")</span>
                                                            @if (assign.Node != null)
                                                            {
                                                                <span class="badge bg-secondary-subtle text-secondary border rounded-pill px-2">
                                                                    <span class="material-symbols-outlined" style="font-size: 12px; margin-right: 2px;">menu_book</span> Bài học: @assign.Node.Title
                                                                </span>
                                                            }
                                                        </div>
                                                    </div>
                                                    <div>
                                                        <form method="post" asp-page-handler="DeleteAssignment" asp-route-id="@Model.Class.Id" asp-route-assignmentId="@assign.Id" class="d-inline">
                                                            <button type="submit" class="btn btn-premium-danger-outline btn-sm px-3" onclick="return confirm('Bạn có chắc chắn muốn xóa bài tập này cùng toàn bộ bài nộp của học sinh?');">
                                                                <span class="material-symbols-outlined" style="font-size:16px;">delete</span> Xóa
                                                            </button>
                                                        </form>
                                                    </div>
                                                </div>
                                                <div class="card-body p-3">
                                                    @if (!string.IsNullOrEmpty(assign.RequirementText))
                                                    {
                                                        <div class="mb-3 text-secondary p-3 bg-light rounded text-start" style="font-size: 0.9rem; border-left: 3px solid var(--color-primary);">
                                                            <strong>Yêu cầu:</strong> @assign.RequirementText
                                                        </div>
                                                    }

                                                    <h6 class="fw-bold text-primary mb-3 d-flex align-items-center gap-1">
                                                        <span class="material-symbols-outlined">people</span> Tiến độ nộp bài của học viên (@submissions.Count / @(Model.Class.ClassMembers?.Count ?? 0) đã nộp)
                                                    </h6>

                                                    @if (Model.Class.ClassMembers != null && Model.Class.ClassMembers.Any())
                                                    {
                                                        <div class="table-responsive">
                                                            <table class="table table-hover table-sm align-middle mb-0">
                                                                <thead>
                                                                    <tr class="text-muted small">
                                                                        <th class="border-0">Học Viên</th>
                                                                        <th class="border-0">Trạng Thái</th>
                                                                        <th class="border-0">Ngày Nộp</th>
                                                                        <th class="border-0">Bài Làm (File)</th>
                                                                        <th class="border-0">Ghi chú</th>
                                                                        <th class="border-0">Điểm Số</th>
                                                                        <th class="border-0 text-end" style="width: 120px;">Thao Tác</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var member in Model.Class.ClassMembers)
                                                                    {
                                                                        var sub = submissions.FirstOrDefault(s => s.StudentId == member.UserId);
                                                                        <tr class="border-bottom">
                                                                            <td>
                                                                                <div class="d-flex align-items-center py-1">
                                                                                    <div class="rounded-circle bg-primary-container text-white text-center me-2 d-flex justify-content-center align-items-center" style="width: 28px; height: 28px; font-size: 12px; font-weight: 700; background-color: var(--color-primary-container);">
                                                                                        @(member.User?.Username?.FirstOrDefault() ?? '?')
                                                                                    </div>
                                                                                    <span class="fw-bold text-dark" style="font-size: 0.9rem;">@member.User?.Username</span>
                                                                                </div>
                                                                            </td>
                                                                            <td>
                                                                                @if (sub != null)
                                                                                {
                                                                                    if (sub.Status == "Graded")
                                                                                    {
                                                                                        <span class="badge bg-success-subtle text-success border border-success px-2 rounded-pill">Đã chấm điểm</span>
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <span class="badge bg-primary-subtle text-primary border border-primary px-2 rounded-pill">Đã nộp</span>
                                                                                    }
                                                                                }
                                                                                else
                                                                                {
                                                                                    <span class="badge bg-danger-subtle text-danger border border-danger px-2 rounded-pill">Chưa nộp</span>
                                                                                }
                                                                            </td>
                                                                            <td class="small text-secondary">@(sub?.SubmitAt?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                                                                            <td>
                                                                                @if (sub != null && !string.IsNullOrEmpty(sub.MediaUrl))
                                                                                {
                                                                                    <a href="@sub.MediaUrl" target="_blank" class="btn btn-premium-outline btn-sm py-1 px-2.5" style="font-size: 0.8rem;">
                                                                                        <span class="material-symbols-outlined" style="font-size: 14px;">download</span> Tải file
                                                                                    </a>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <span class="text-muted">-</span>
                                                                                }
                                                                            </td>
                                                                            <td class="small text-truncate text-secondary" style="max-width: 150px;" title="@sub?.ContentText">
                                                                                @(sub?.ContentText ?? "-")
                                                                            </td>
                                                                            <td>
                                                                                @if (sub != null)
                                                                                {
                                                                                    if (sub.Status == "Graded")
                                                                                    {
                                                                                        <span class="badge bg-success fw-bold" style="font-size: 0.85rem; padding: 0.35rem 0.6rem;">@sub.Score?.ToString("0.0") / 10</span>
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <span class="badge bg-warning text-dark fw-bold" style="font-size: 0.85rem; padding: 0.35rem 0.6rem;">Chưa chấm</span>
                                                                                    }
                                                                                }
                                                                                else
                                                                                {
                                                                                    <span class="text-muted">-</span>
                                                                                }
                                                                            </td>
                                                                            <td class="text-end">
                                                                                @if (sub != null)
                                                                                {
                                                                                    <button type="button" class="btn btn-premium-primary btn-sm px-3 py-1" style="font-size:0.8rem;" onclick="openGradeModal(@sub.Id, @(sub.Score?.ToString() ?? "null"), '@Html.Raw(sub.Feedback?.Replace("'", "\\'"))')">
                                                                                        Chấm điểm
                                                                                    </button>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <button type="button" class="btn btn-outline-secondary btn-sm px-3 py-1" style="font-size:0.8rem; border-radius:var(--border-radius-button);" disabled>
                                                                                        Chấm điểm
                                                                                    </button>
                                                                                }
                                                                            </td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="text-center py-4 bg-light rounded text-muted small">
                                                            Chưa có học viên nào trong lớp để theo dõi bài tập.
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-5 text-muted">
                                    <span class="material-symbols-outlined opacity-50 mb-2" style="font-size:48px;">assignment_late</span>
                                    <h6 class="text-muted">Lớp chưa có bài tập nào được tạo.</h6>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Q&A (Hỏi & Đáp) Tab -->
                <div class="tab-pane fade" id="qa-content" role="tabpanel" aria-labelledby="qa-tab">
                    <div class="card card-premium">
                        <div class="card-premium-header bg-white border-bottom">
                            <h4 class="fw-bold mb-0 text-primary d-flex align-items-center gap-2">
                                <span class="material-symbols-outlined">forum</span> Hỏi & Đáp Lớp Học
                            </h4>
                        </div>
                        <div class="card-body p-4">
                            <!-- Question Submission Form -->
                            <div class="card border-0 shadow-sm mb-4 bg-light" style="border-radius: 10px;">
                                <div class="card-body p-3">
                                    <h6 class="fw-bold mb-3 text-dark d-flex align-items-center gap-1">
                                        <span class="material-symbols-outlined text-primary">contact_support</span> Đặt câu hỏi mới
                                    </h6>
                                    <form id="createThreadForm" method="post">
                                        @Html.AntiForgeryToken()
                                        <div class="mb-3">
                                            <textarea id="questionTextInput" class="form-control bg-white" rows="3" placeholder="Nhập câu hỏi thảo luận hoặc thắc mắc của bạn ở đây..." required style="border-radius: 8px;"></textarea>
                                        </div>
                                        <button type="submit" class="btn btn-premium-primary px-4">
                                            Đăng câu hỏi <span class="material-symbols-outlined" style="font-size:16px; margin-left:4px;">send</span>
                                        </button>
                                    </form>
                                </div>
                            </div>

                            <!-- List of Threads -->
                            <div id="qaThreadsContainer" class="d-flex flex-column gap-3">
                                @if (Model.QaThreads != null && Model.QaThreads.Any())
                                {
                                    foreach (var thread in Model.QaThreads)
                                    {
                                        <div class="qa-thread-box p-4 qa-thread-card" data-thread-id="@thread.Id">
                                            <div class="d-flex align-items-center justify-content-between mb-3">
                                                <div class="d-flex align-items-center">
                                                    <div class="rounded-circle bg-primary-container text-white text-center me-2 d-flex justify-content-center align-items-center" style="width: 32px; height: 32px; font-size: 13px; font-weight: 700; background-color: var(--color-primary-container);">
                                                        @(thread.Student?.Username?.FirstOrDefault() ?? '?')
                                                    </div>
                                                    <div>
                                                        <strong class="text-dark">@(thread.Student?.Username ?? "Học viên")</strong>
                                                        <span class="text-muted small ms-2">@thread.CreatedAt?.ToString("dd/MM/yyyy HH:mm")</span>
                                                    </div>
                                                </div>
                                            </div>
                                            <p class="text-dark mb-3 fw-bold" style="white-space: pre-wrap; font-size: 1.05rem;">@thread.QuestionText</p>
                                            
                                            <!-- Replies Section -->
                                            <div class="qa-replies-container">
                                                <h6 class="fw-bold text-secondary mb-3 small d-flex align-items-center gap-1"><span class="material-symbols-outlined" style="font-size:16px;">forum</span> Câu trả lời</h6>
                                                <div class="replies-list d-flex flex-column gap-2 mb-3" data-thread-id="@thread.Id">
                                                    @if (thread.QaReplies != null && thread.QaReplies.Any())
                                                    {
                                                        foreach (var reply in thread.QaReplies)
                                                        {
                                                            var isTeacherReply = reply.User?.Role == "Teacher" || reply.User?.Role == "Manager" || reply.User?.Role == "Admin";
                                                            <div class="qa-reply-bubble">
                                                                <div class="d-flex align-items-center mb-1">
                                                                    <strong class="@(isTeacherReply ? "text-primary" : "text-dark") small font-weight-bold">
                                                                        @(reply.User?.Username ?? "User")
                                                                        @if (isTeacherReply)
                                                                        {
                                                                            <span class="badge bg-primary-subtle text-primary ms-1" style="font-size: 0.7rem; font-weight:700;">Giáo viên</span>
                                                                        }
                                                                    </strong>
                                                                    <span class="text-muted small ms-2" style="font-size: 0.7rem;">@reply.CreatedAt?.ToString("dd/MM/yyyy HH:mm")</span>
                                                                </div>
                                                                <p class="mb-0 text-dark small" style="white-space: pre-wrap;">@reply.ReplyText</p>
                                                            </div>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <p class="text-muted small mb-0 no-replies-text">Chưa có câu trả lời nào. Hãy phản hồi để hỗ trợ học viên!</p>
                                                    }
                                                </div>
                                                
                                                <!-- Reply Form -->
                                                <form class="create-reply-form d-flex gap-2 align-items-center mt-3" data-thread-id="@thread.Id">
                                                    <input type="text" class="form-control form-control-sm reply-input bg-white px-3 py-2" placeholder="Viết phản hồi hoặc trả lời..." required style="border-radius: 20px;" />
                                                    <button type="submit" class="btn btn-premium-primary rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 36px; height: 36px; padding: 0;">
                                                        <span class="material-symbols-outlined" style="font-size: 18px;">send</span>
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div id="noThreadsMessage" class="text-center py-5 text-muted bg-light rounded border">
                                        <span class="material-symbols-outlined opacity-50 mb-2" style="font-size:48px;">chat_bubble_outline</span>
                                        <h6 class="text-muted font-bold">Chưa có chủ đề thảo luận nào. Đặt câu hỏi đầu tiên!</h6>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Schedule Tab -->
                <div class="tab-pane fade" id="schedule-content" role="tabpanel" aria-labelledby="schedule-tab">
                    <div class="card card-premium">
                        <div class="card-premium-header bg-white border-bottom">
                            <h4 class="fw-bold mb-0 text-primary d-flex align-items-center gap-2">
                                <span class="material-symbols-outlined">calendar_month</span> Lịch Học Của Lớp
                            </h4>
                        </div>
                        <div class="card-body p-4">
                            @if (Model.Class.ClassSchedules != null && Model.Class.ClassSchedules.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead>
                                            <tr class="table-light text-muted">
                                                <th class="px-4 py-3 border-0 fw-semibold text-uppercase small">Buổi</th>
                                                <th class="px-4 py-3 border-0 fw-semibold text-uppercase small">Ngày học</th>
                                                <th class="px-4 py-3 border-0 fw-semibold text-uppercase small">Thời gian</th>
                                                <th class="px-4 py-3 border-0 fw-semibold text-uppercase small">Phòng học</th>
                                                <th class="px-4 py-3 border-0 fw-semibold text-uppercase small">Trạng thái</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{
                                                var sessionNum = 0;
                                            }
                                            @foreach (var schedule in Model.Class.ClassSchedules.OrderBy(s => s.StudyDate).ThenBy(s => s.StartTime))
                                            {
                                                sessionNum++;
                                                var isPast = schedule.StudyDate < DateOnly.FromDateTime(DateTime.Now);
                                                var isToday = schedule.StudyDate == DateOnly.FromDateTime(DateTime.Now);
                                                var dayName = Flipped_Classroom.Services.ScheduleSlotHelper.GetVietnameseDayName(schedule.StudyDate.DayOfWeek);
                                                
                                                <tr class="align-middle border-bottom @(isPast ? "opacity-50" : "")">
                                                    <td class="px-4 py-3 fw-bold text-dark">Buổi @sessionNum</td>
                                                    <td class="px-4 py-3">
                                                        <div class="fw-bold">@schedule.StudyDate.ToString("dd/MM/yyyy")</div>
                                                        <small class="text-secondary font-weight-medium">@dayName</small>
                                                    </td>
                                                    <td class="px-4 py-3 text-primary font-weight-bold">
                                                        <span class="material-symbols-outlined" style="font-size:16px; margin-right:4px;">schedule</span>
                                                        @schedule.StartTime.ToString("HH:mm") – @schedule.EndTime.ToString("HH:mm")
                                                    </td>
                                                    <td class="px-4 py-3 text-dark font-weight-medium">
                                                        @if (!string.IsNullOrEmpty(schedule.Room))
                                                        {
                                                            <span class="d-flex align-items-center gap-1"><span class="material-symbols-outlined text-secondary" style="font-size:16px;">location_on</span>@schedule.Room</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted fst-italic d-flex align-items-center gap-1"><span class="material-symbols-outlined text-secondary" style="font-size:16px;">laptop_mac</span>Trực tuyến</span>
                                                        }
                                                    </td>
                                                    <td class="px-4 py-3">
                                                        @if (isToday)
                                                        {
                                                            <span class="badge bg-danger text-white rounded-pill px-3 py-1.5 fw-bold shadow-sm">Hôm nay</span>
                                                        }
                                                        else if (isPast)
                                                        {
                                                            <span class="badge bg-secondary text-white rounded-pill px-3 py-1.5 fw-medium">Đã qua</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-success text-white rounded-pill px-3 py-1.5 fw-bold shadow-sm">Sắp tới</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-5 text-muted">
                                    <span class="material-symbols-outlined opacity-50 mb-2" style="font-size: 48px;">calendar_today</span>
                                    <h6 class="text-muted">Lớp học này chưa được xếp lịch học.</h6>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Student Modal -->
<div class="modal fade" id="addStudentModal" tabindex="-1" aria-labelledby="addStudentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow" style="border-radius: 15px;">
            <form method="post" asp-page-handler="AddStudents" asp-route-id="@Model.Class.Id">
                <div class="modal-header border-bottom-0 pb-0 pt-4 px-4">
                    <h5 class="modal-title fw-bold text-primary d-flex align-items-center gap-2" id="addStudentModalLabel">
                        <span class="material-symbols-outlined">person_add</span> Thêm Học Viên Mới
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-muted small mb-3">Chọn các học viên bạn muốn thêm vào lớp học này:</p>
                    @if (Model.AvailableUsers != null && Model.AvailableUsers.Any())
                    {
                        <div class="mb-3 position-relative">
                            <input type="text" class="form-control" id="studentSearchInput" placeholder="Tìm kiếm học viên..." autocomplete="off" style="border-radius: 8px; border-color: #ced4da; padding-right: 2.5rem;" />
                        </div>
                        <div class="list-group list-group-flush border rounded-3" id="studentListGroup" style="max-height: 350px; overflow-y: auto;">
                            @foreach (var user in Model.AvailableUsers)
                            {
                                <label class="list-group-item d-flex gap-3 align-items-center p-3 list-group-item-action student-option" style="cursor: pointer; border-bottom: 1px solid var(--color-surface-container);">
                                    <input class="form-check-input flex-shrink-0" type="checkbox" name="SelectedStudentIds" value="@user.Id" style="font-size: 1.2em; border-radius: 4px;">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-initials-circle bg-primary me-3 text-white">
                                            @(user.Username?.FirstOrDefault() ?? '?')
                                        </div>
                                        <div>
                                            <h6 class="mb-0 fw-bold text-dark">@user.Username</h6>
                                            @if (!string.IsNullOrEmpty(user.Email))
                                            {
                                                <small class="text-muted">@user.Email</small>
                                            }
                                        </div>
                                    </div>
                                </label>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 bg-light rounded-3">
                            <p class="text-muted mb-0">Không có học viên nào khả dụng để thêm.</p>
                        </div>
                    }
                </div>
                <div class="modal-footer border-top-0 pt-0 pb-4 px-4 gap-2">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-premium-primary rounded-pill px-4 shadow-sm">Xác Nhận Thêm</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Create Group Modal -->
<div class="modal fade" id="createGroupModal" tabindex="-1" aria-labelledby="createGroupModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius: 15px;">
            <form method="post" asp-page-handler="CreateGroups" asp-route-id="@Model.Class.Id" novalidate>
                <div class="modal-header border-bottom-0 pb-0 pt-4 px-4">
                    <h5 class="modal-title fw-bold text-primary d-flex align-items-center gap-2" id="createGroupModalLabel">
                        <span class="material-symbols-outlined">groups</span> Tạo Nhóm Mới
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-4">
                        <label class="form-label fw-bold text-dark">Danh Sách Học Viên Hiện Tại (@(Model.Class.ClassMembers?.Count ?? 0))</label>
                        <div class="list-group list-group-flush border rounded-3" style="max-height: 200px; overflow-y: auto;">
                            @if (Model.Class.ClassMembers != null && Model.Class.ClassMembers.Any())
                            {
                                foreach (var member in Model.Class.ClassMembers)
                                {
                                    <div class="list-group-item d-flex align-items-center gap-3 px-3 py-2 bg-light border-bottom">
                                        <div class="avatar-initials-circle bg-primary text-white" style="width: 28px; height: 28px; font-size:12px;">
                                            @(member.User?.Username?.FirstOrDefault() ?? '?')
                                        </div>
                                        <div class="d-flex flex-column">
                                            <span class="fw-bold small text-dark mb-0" style="line-height:1.2;">@member.User?.Username</span>
                                            @if (!string.IsNullOrEmpty(member.User?.Email))
                                            {
                                                <span class="text-muted" style="font-size: 0.75rem; line-height:1.2;">@member.User.Email</span>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="p-3 text-center text-muted small">Chưa có học viên nào để chia nhóm.</div>
                            }
                        </div>
                    </div>

                    <p class="text-muted small mb-3">Nhập số lượng nhóm bạn muốn tạo cho lớp học này:</p>
                    <div class="mb-3">
                        <label for="NumberOfGroupsToCreate" class="form-label fw-bold">Số lượng nhóm</label>
                        <input type="number" asp-for="NumberOfGroupsToCreate" class="form-control shadow-sm" style="border-radius: 8px; border-color: #ced4da;" />
                        <span asp-validation-for="NumberOfGroupsToCreate" class="text-danger small d-block mt-1"></span>
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0 pb-4 px-4 gap-2">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-premium-primary rounded-pill px-4 shadow-sm">Xác Nhận Tạo</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Create Assignment Modal -->
<div class="modal fade" id="createAssignmentModal" tabindex="-1" aria-labelledby="createAssignmentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius: 15px;">
            <form method="post" asp-page-handler="CreateAssignment" asp-route-id="@Model.Class.Id" novalidate>
                <div class="modal-header border-bottom-0 pb-0 pt-4 px-4">
                    <h5 class="modal-title fw-bold text-primary d-flex align-items-center gap-2" id="createAssignmentModalLabel">
                        <span class="material-symbols-outlined">add_task</span> Tạo Chủ Đề Bài Tập Mới
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label for="NewAssignment_Title" class="form-label fw-bold">Tiêu đề bài tập <span class="text-danger">*</span></label>
                        <input type="text" name="NewAssignment.Title" id="NewAssignment_Title" class="form-control" placeholder="Ví dụ: Bài tập nói số 1..." data-val="true" data-val-required="Vui lòng nhập tiêu đề bài tập." data-val-length="Tiêu đề bài tập không được vượt quá 100 ký tự." data-val-length-max="100" style="border-radius: 8px;" />
                        <span asp-validation-for="NewAssignment.Title" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="mb-3">
                        <label for="NewAssignment_RequirementText" class="form-label fw-bold">Yêu cầu & Hướng dẫn</label>
                        <textarea name="NewAssignment.RequirementText" id="NewAssignment_RequirementText" class="form-control" rows="3" placeholder="Ví dụ: Nêu suy nghĩ của bạn bằng tiếng Nhật..." style="border-radius: 8px;"></textarea>
                    </div>

                    <div class="mb-3">
                        <label for="NewAssignment_NodeId" class="form-label fw-bold">Liên kết bài học (Không bắt buộc)</label>
                        <select name="NewAssignment.NodeId" id="NewAssignment_NodeId" class="form-select" style="border-radius: 8px;">
                            <option value="">-- Không liên kết --</option>
                            @if (Model.Class.Curriculum?.Nodes != null)
                            {
                                foreach (var node in Model.Class.Curriculum.Nodes)
                                {
                                    if (node.ParentNodeId == null)
                                    {
                                        <option value="@node.Id">@node.Title</option>
                                    }
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="NewAssignment_DueDate" class="form-label fw-bold">Hạn nộp bài <span class="text-danger">*</span></label>
                        <input type="datetime-local" name="NewAssignment.DueDate" id="NewAssignment_DueDate" class="form-control" data-val="true" data-val-required="Vui lòng chọn hạn nộp bài." style="border-radius: 8px;" />
                        <span asp-validation-for="NewAssignment.DueDate" class="text-danger small d-block mt-1"></span>
                    </div>

                    <input type="hidden" name="NewAssignment.Type" value="File" />
                </div>
                <div class="modal-footer border-top-0 pt-0 pb-4 px-4 gap-2">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-premium-primary rounded-pill px-4 shadow-sm">Xác Nhận Tạo</button>
                </div>
            </form>
        </div>
    </div>
</div>

