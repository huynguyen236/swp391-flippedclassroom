                    <button type="submit" class="btn btn-premium-primary rounded-pill px-4 shadow-sm">Lưu Kết Quả</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Xác Nhận Xóa Học Viên -->
<div class="modal fade" id="deleteStudentModal" tabindex="-1" aria-labelledby="deleteStudentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius: 24px; background: var(--color-surface-container);">
            <div class="modal-header border-bottom-0 pb-0 pt-4 px-4">
                <h5 class="modal-title fw-bold text-danger d-flex align-items-center gap-2" id="deleteStudentModalLabel">
                    <span class="material-symbols-outlined text-danger">warning</span> Xác Nhận Xóa
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <span class="material-symbols-outlined text-danger mb-3" style="font-size: 56px;">person_remove</span>
                <p class="fs-5 mb-0" style="color: var(--color-on-surface);">Bạn có chắc chắn muốn xóa học viên <strong id="deleteStudentName" class="text-dark"></strong> khỏi lớp?</p>
            </div>
            <div class="modal-footer border-top-0 pt-0 pb-4 px-4 gap-2 justify-content-center">
                <form id="deleteStudentForm" method="post" asp-page-handler="RemoveStudent" asp-route-id="@Model.Class.Id">
                    <input type="hidden" name="memberUserId" id="deleteStudentId" value="" />
                    <button type="button" class="btn btn-premium-outline rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger rounded-pill px-4 shadow-sm" style="background-color: #dc3545; border: none; color: white;">Xóa</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function escapeHtml(text) {
            if (!text) return '';
            return text
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }

        function showDeleteStudentModal(userId, username) {
            document.getElementById('deleteStudentId').value = userId;
            document.getElementById('deleteStudentName').innerText = username;
            var modal = new bootstrap.Modal(document.getElementById('deleteStudentModal'));
            modal.show();
        }

        function openGradeModal(submissionId, score, feedback) {
            document.getElementById('GradeRequest_SubmissionId').value = submissionId;
            document.getElementById('GradeRequest_Score').value = score !== null ? score : '';
            document.getElementById('GradeRequest_Feedback').value = feedback || '';
            
            const gradeModal = new bootstrap.Modal(document.getElementById('gradeSubmissionModal'));
            gradeModal.show();
        }

        document.addEventListener('DOMContentLoaded', function() {
            // Tab persistence functionality
            const tabButtons = document.querySelectorAll('[data-bs-toggle="tab"]');
            const activeTabKey = 'classroomActiveTab_' + window.location.pathname;

            // Restore active tab on page load
            const savedTab = localStorage.getItem(activeTabKey);
            if (savedTab) {
                const tabButton = document.getElementById(savedTab);
                if (tabButton) {
                    const tab = new bootstrap.Tab(tabButton);
                    tab.show();
                }
            }

            // Save active tab when changed
            tabButtons.forEach(button => {
                button.addEventListener('shown.bs.tab', function(e) {
                    localStorage.setItem(activeTabKey, this.id);
                });
            });

            // Auto-show createGroupModal if validation failed on postback
            @if (true.Equals(ViewData["ShowCreateGroupModal"]))
            {
                <text>
                var groupModalElement = document.getElementById('createGroupModal');
                if (groupModalElement) {
                    var groupModal = new bootstrap.Modal(groupModalElement);
                    groupModal.show();
                }
                </text>
            }

            // Auto-show createAssignmentModal if validation failed on postback
            @if (true.Equals(ViewData["ShowCreateAssignmentModal"]))
            {
                <text>
                var assignmentModalElement = document.getElementById('createAssignmentModal');
                if (assignmentModalElement) {
                    var assignmentModal = new bootstrap.Modal(assignmentModalElement);
                    assignmentModal.show();
                }
                </text>
            }

            // Auto-show gradeSubmissionModal if validation failed on postback
            @if (true.Equals(ViewData["ShowGradeSubmissionModal"]))
            {
                <text>
                var gradeModalElement = document.getElementById('gradeSubmissionModal');
                if (gradeModalElement) {
                    document.getElementById('GradeRequest_SubmissionId').value = '@ViewData["GradeSubmissionId"]';
                    document.getElementById('GradeRequest_Score').value = '@ViewData["GradeScore"]';
                    document.getElementById('GradeRequest_Feedback').value = '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode((string)ViewData["GradeFeedback"] ?? ""))';
                    var gradeModal = new bootstrap.Modal(gradeModalElement);
                    gradeModal.show();
                }
                </text>
            }

            const studentSearchInput = document.getElementById('studentSearchInput');
            if (studentSearchInput) {
                studentSearchInput.addEventListener('keyup', function() {
                    const filter = this.value.toLowerCase();
                    const options = document.querySelectorAll('.student-option');

                    options.forEach(function(item) {
                        const text = item.textContent.toLowerCase();
                        if (text.includes(filter)) {
                            item.classList.remove('d-none');
                            item.classList.add('d-flex');
                        } else {
                            item.classList.remove('d-flex');
                            item.classList.add('d-none');
                        }
                    });
                });
            }

            // AJAX Q&A Thread Creation
            const createThreadForm = document.getElementById('createThreadForm');
            if (createThreadForm) {
                createThreadForm.addEventListener('submit', async function(e) {
                    e.preventDefault();
                    const textarea = document.getElementById('questionTextInput');
                    const text = textarea.value.trim();
                    if (!text) return;

                    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

                    const formData = new URLSearchParams();
                    formData.append('questionText', text);
                    formData.append('__RequestVerificationToken', token);

                    try {
                        const response = await fetch('?handler=CreateThread&id=@Model.Class.Id', {
                            method: 'POST',
                            headers: {
                                'RequestVerificationToken': token
                            },
                            body: formData
                        });

                        const result = await response.json();
                        if (result.success) {
                            textarea.value = '';
                            
                            const container = document.getElementById('qaThreadsContainer');
                            const noThreadsMsg = document.getElementById('noThreadsMessage');
                            if (noThreadsMsg) {
                                noThreadsMsg.remove();
                            }

                            const threadHtml = `
                                <div class="qa-thread-box p-4 qa-thread-card mb-3" data-thread-id="${result.thread.id}">
                                    <div class="d-flex align-items-center justify-content-between mb-3">
                                        <div class="d-flex align-items-center">
                                            <div class="rounded-circle bg-primary-container text-white text-center me-2 d-flex justify-content-center align-items-center" style="width: 32px; height: 32px; font-size: 13px; font-weight: 700; background-color: var(--color-primary-container);">
                                                ${result.thread.studentName.charAt(0)}
                                            </div>
                                            <div>
                                                <strong class="text-dark">${result.thread.studentName}</strong>
                                                <span class="text-muted small ms-2">${result.thread.createdAtFormatted}</span>
                                            </div>
                                        </div>
                                    </div>
                                    <p class="text-dark mb-3 fw-bold" style="white-space: pre-wrap; font-size: 1.05rem;">${escapeHtml(result.thread.questionText)}</p>
                                    
                                    <div class="qa-replies-container">
                                        <h6 class="fw-bold text-secondary mb-3 small d-flex align-items-center gap-1"><span class="material-symbols-outlined" style="font-size:16px;">forum</span> Câu trả lời</h6>
                                        <div class="replies-list d-flex flex-column gap-2 mb-3" data-thread-id="${result.thread.id}">
                                            <p class="text-muted small mb-0 no-replies-text">Chưa có câu trả lời nào. Hãy phản hồi để hỗ trợ học viên!</p>
                                        </div>
                                        
                                        <form class="create-reply-form d-flex gap-2 align-items-center mt-3" data-thread-id="${result.thread.id}">
                                            <input type="text" class="form-control form-control-sm reply-input bg-white px-3 py-2" placeholder="Viết phản hồi hoặc trả lời..." required style="border-radius: 20px;" />
                                            <button type="submit" class="btn btn-premium-primary rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 36px; height: 36px; padding:0;">
                                                <span class="material-symbols-outlined" style="font-size: 18px;">send</span>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            `;
                            container.insertAdjacentHTML('afterbegin', threadHtml);
                            
                            const newForm = container.querySelector(`.create-reply-form[data-thread-id="${result.thread.id}"]`);
                            bindReplyFormHandler(newForm);

                            // Cập nhật số lượng trên Tab Badge
                            const qaTab = document.getElementById('qa-tab');
                            if (qaTab) {
                                const countMatch = qaTab.innerHTML.match(/\((\d+)\)/);
                                if (countMatch) {
                                    const currentCount = parseInt(countMatch[1]);
                                    qaTab.innerHTML = qaTab.innerHTML.replace(/\(\d+\)/, `(${currentCount + 1})`);
                                }
                            }
                        } else {
                            console.error(result.message || 'Lỗi khi tạo câu hỏi.');
                        }
                    } catch (error) {
                        console.error('Error:', error);
                    }
                });
            }

            // AJAX Q&A Reply Creation
            function bindReplyFormHandler(form) {
                form.addEventListener('submit', async function(e) {
                    e.preventDefault();
                    const threadId = this.dataset.threadId;
                    const input = this.querySelector('.reply-input');
                    const text = input.value.trim();
                    if (!text) return;

                    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

                    const formData = new URLSearchParams();
                    formData.append('threadId', threadId);
                    formData.append('replyText', text);
                    formData.append('__RequestVerificationToken', token);

                    try {
                        const response = await fetch('?handler=CreateReply&id=@Model.Class.Id', {
                            method: 'POST',
                            headers: {
                                'RequestVerificationToken': token
                            },
                            body: formData
                        });

                        const result = await response.json();
                        if (result.success) {
                            input.value = '';
                            
                            const repliesList = document.querySelector(`.replies-list[data-thread-id="${threadId}"]`);
                            if (repliesList) {
                                const noRepliesMsg = repliesList.querySelector('.no-replies-text');
                                if (noRepliesMsg) {
                                    noRepliesMsg.remove();
                                }

                                const isTeacher = result.reply.userRole === 'Teacher' || result.reply.userRole === 'Manager' || result.reply.userRole === 'Admin';
                                const replyHtml = `
                                    <div class="qa-reply-bubble">
                                        <div class="d-flex align-items-center mb-1">
                                            <strong class="${isTeacher ? 'text-primary' : 'text-dark'} small font-weight-bold">
                                                ${result.reply.userName}
                                                ${isTeacher ? '<span class="badge bg-primary-subtle text-primary ms-1" style="font-size: 0.7rem; font-weight:700;">Giáo viên</span>' : ''}
                                            </strong>
                                            <span class="text-muted small ms-2" style="font-size: 0.7rem;">${result.reply.createdAtFormatted}</span>
                                        </div>
                                        <p class="mb-0 text-dark small" style="white-space: pre-wrap;">${escapeHtml(result.reply.replyText)}</p>
                                    </div>
                                `;
                                repliesList.insertAdjacentHTML('beforeend', replyHtml);
                            }
                        } else {
                            console.error(result.message || 'Lỗi khi tạo phản hồi.');
                        }
                    } catch (error) {
                        console.error('Error:', error);
                    }
                });
            }

            document.querySelectorAll('.create-reply-form').forEach(form => {
                bindReplyFormHandler(form);
            });

            // === Mở / khóa node bằng AJAX (không reload trang) ===
            const accordion = document.getElementById('teacherLearningPathAccordion');
            if (accordion) {
                const toggleUrl = accordion.dataset.toggleUrl;
                const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                const token = tokenInput ? tokenInput.value : '';

                accordion.addEventListener('click', async function (e) {
                    const btn = e.target.closest('.node-lock-toggle');
                    if (!btn) return;

                    // Ngăn click nút khóa/mở vô tình mở/đóng accordion của chương.
                    e.preventDefault();
                    e.stopPropagation();

                    const nodeId = btn.dataset.nodeId;
                    const originalHtml = btn.innerHTML;
                    btn.disabled = true;
                    btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

                    try {
                        const body = new URLSearchParams();
                        body.append('nodeId', nodeId);
                        body.append('__RequestVerificationToken', token);

                        const res = await fetch(toggleUrl, {
                            method: 'POST',
                            headers: { 'RequestVerificationToken': token },
                            body: body
                        });

                        if (!res.ok) throw new Error('HTTP ' + res.status);
                        const data = await res.json();
                        if (!data.success) throw new Error(data.message || 'Thao tác thất bại');

                        const unlocked = data.isUnlocked;

                        // Cập nhật nút
                        btn.dataset.unlocked = unlocked ? 'true' : 'false';
                        btn.title = unlocked ? 'Khóa bài học này' : 'Mở bài học này cho học sinh';
                        btn.innerHTML = unlocked
                            ? '<span class="d-flex align-items-center gap-1"><span class="material-symbols-outlined" style="font-size:16px;">lock</span>Khóa</span>'
                            : '<span class="d-flex align-items-center gap-1"><span class="material-symbols-outlined" style="font-size:16px;">lock_open</span>Mở</span>';

                        // Cập nhật badge tương ứng
                        const badge = accordion.querySelector('.node-lock-badge[data-node-id="' + nodeId + '"]');
                        if (badge) {
                            badge.classList.toggle('bg-success-subtle', unlocked);
                            badge.classList.toggle('text-success', unlocked);
                            badge.classList.toggle('bg-secondary-subtle', !unlocked);
                            badge.classList.toggle('text-secondary', !unlocked);
                            badge.innerHTML = unlocked
                                ? '<span class="d-flex align-items-center gap-1"><span class="material-symbols-outlined" style="font-size:14px;">lock_open</span>Đã mở</span>'
                                : '<span class="d-flex align-items-center gap-1"><span class="material-symbols-outlined" style="font-size:14px;">lock</span>Đang khóa</span>';
                        }
                    } catch (err) {
                        btn.innerHTML = originalHtml;
                        alert('Không thể đổi trạng thái bài học: ' + err.message);
                    } finally {
                        btn.disabled = false;
                    }
                });
            }
        });
    </script>

    <!-- Email Notification Modal -->
    <div class="modal fade" id="emailNotificationModal" tabindex="-1" aria-labelledby="emailNotificationModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 12px; background: var(--color-surface-container);">
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold d-flex align-items-center gap-2" id="emailNotificationModalLabel" style="color: var(--color-on-background);">
                        <span class="material-symbols-outlined text-primary">mail</span>
                        Gửi Email Thông Báo - <span id="modalClassName" class="text-primary"></span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body py-4">
                    <form id="emailNotificationForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" id="emailClassId" name="classId" />

                        <!-- Recipient Selection -->
                        <div class="mb-3">
                            <label class="form-label fw-bold small text-uppercase tracking-wider text-muted">Người nhận</label>
                            <div class="d-flex gap-3 mb-2">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="recipientType" id="recipientAll" value="all" checked>
                                    <label class="form-check-label fw-medium" for="recipientAll">
                                        Tất cả học viên
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="recipientType" id="recipientSelect" value="select">
                                    <label class="form-check-label fw-medium" for="recipientSelect">
                                        Chọn học viên cụ thể
                                    </label>
                                </div>
                            </div>

                            <!-- Student List (Hidden by default, shown when recipientSelect is active) -->
                            <div id="studentSelectionContainer" class="border rounded p-3 bg-light" style="display: none; max-height: 200px; overflow-y: auto;">
                                <div class="form-check mb-2 pb-2 border-bottom">
                                    <input class="form-check-input" type="checkbox" id="selectAllStudents">
                                    <label class="form-check-label fw-bold text-dark" for="selectAllStudents">
                                        Chọn tất cả
                                    </label>
                                </div>
                                <div id="studentListContainer">
                                    <!-- Populated via AJAX -->
                                </div>
                            </div>
                        </div>

                        <!-- Subject -->
                        <div class="mb-3">
                            <label for="emailSubject" class="form-label fw-bold small text-uppercase tracking-wider text-muted">Tiêu đề (Subject)</label>
                            <input type="text" class="form-control rounded-3" id="emailSubject" name="subject" placeholder="Nhập tiêu đề thông báo..." required>
                        </div>

                        <!-- Body -->
                        <div class="mb-3">
                            <label for="emailBody" class="form-label fw-bold small text-uppercase tracking-wider text-muted">Nội dung thông báo (Body)</label>
                            <textarea class="form-control rounded-3" id="emailBody" name="body" rows="6" placeholder="Nhập nội dung chi tiết..." required></textarea>
                        </div>
                    </form>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-premium-outline" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" class="btn btn-premium-primary" id="btnSendEmail">
                        <span class="d-flex align-items-center gap-1">
                            <span class="material-symbols-outlined" style="font-size: 18px;">send</span> Gửi Email
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const modal = new bootstrap.Modal(document.getElementById('emailNotificationModal'));
            const modalClassName = document.getElementById('modalClassName');
            const emailClassId = document.getElementById('emailClassId');
            const studentSelectionContainer = document.getElementById('studentSelectionContainer');
            const studentListContainer = document.getElementById('studentListContainer');
            const selectAllStudents = document.getElementById('selectAllStudents');
            const btnSendEmail = document.getElementById('btnSendEmail');
            const form = document.getElementById('emailNotificationForm');

            // Toggle recipient selector list
            document.querySelectorAll('input[name="recipientType"]').forEach(radio => {
                radio.addEventListener('change', function () {
                    if (this.value === 'select') {
                        studentSelectionContainer.style.display = 'block';
                    } else {
                        studentSelectionContainer.style.display = 'none';
                    }
                });
            });

            // Select/Deselect all students checkbox
            selectAllStudents.addEventListener('change', function () {
                document.querySelectorAll('.student-checkbox').forEach(cb => {
                    cb.checked = this.checked;
                });
            });

            // Click "Gửi Email" button
            document.querySelectorAll('.send-email-btn').forEach(btn => {
                btn.addEventListener('click', async function () {
                    const classId = this.dataset.classId;
                    const className = this.dataset.className;

                    modalClassName.textContent = className;
                    emailClassId.value = classId;
                    studentListContainer.innerHTML = '<div class="text-center py-2"><span class="spinner-border spinner-border-sm text-primary"></span> Đang tải...</div>';
                    
                    // Reset form fields
                    document.getElementById('emailSubject').value = '';
                    document.getElementById('emailBody').value = '';
                    document.getElementById('recipientAll').checked = true;
                    studentSelectionContainer.style.display = 'none';
                    selectAllStudents.checked = false;

                    modal.show();

                    try {
                        const res = await fetch(`?handler=ClassMembers&classId=${classId}`);
                        if (!res.ok) throw new Error('HTTP ' + res.status);
                        const students = await res.json();
                        
                        studentListContainer.innerHTML = '';
                        if (!students || students.length === 0) {
                            studentListContainer.innerHTML = '<p class="text-muted small mb-0">Không có học viên nào trong lớp.</p>';
                        } else {
                            students.forEach(student => {
                                const div = document.createElement('div');
                                div.className = 'form-check py-1';
                                div.innerHTML = `
                                    <input class="form-check-input student-checkbox" type="checkbox" value="${student.id}" id="student-${student.id}">
                                    <label class="form-check-label text-dark" for="student-${student.id}">
                                        ${student.username} (${student.email || 'N/A'})
                                    </label>
                                `;
                                studentListContainer.appendChild(div);
                            });
                            
                            // Bind change events to student checkboxes to sync "Select All" status
                            document.querySelectorAll('.student-checkbox').forEach(cb => {
                                cb.addEventListener('change', function () {
                                    const allCbs = document.querySelectorAll('.student-checkbox');
                                    const checkedCbs = document.querySelectorAll('.student-checkbox:checked');
                                    selectAllStudents.checked = allCbs.length === checkedCbs.length;
                                });
                            });
                        }
                    } catch (err) {
                        studentListContainer.innerHTML = '<p class="text-danger small mb-0">Lỗi khi tải danh sách học viên.</p>';
                    }
                });
            });

            // Click "Gửi" button inside modal
            btnSendEmail.addEventListener('click', async function () {
                const classId = emailClassId.value;
                const subject = document.getElementById('emailSubject').value.trim();
                const body = document.getElementById('emailBody').value.trim();
                const isSelect = document.getElementById('recipientSelect').checked;

                if (!subject || !body) {
                    alert('Vui lòng điền đầy đủ tiêu đề và nội dung.');
                    return;
                }

                const selectedStudentIds = [];
                if (isSelect) {
                    document.querySelectorAll('.student-checkbox:checked').forEach(cb => {
                        selectedStudentIds.push(parseInt(cb.value));
                    });
                    if (selectedStudentIds.length === 0) {
                        alert('Vui lòng chọn ít nhất một học viên.');
                        return;
                    }
                }

                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                
                const originalHtml = btnSendEmail.innerHTML;
                btnSendEmail.disabled = true;
                btnSendEmail.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Đang gửi...';

                try {
                    const formData = new FormData();
                    formData.append('classId', classId);
                    formData.append('subject', subject);
                    formData.append('body', body);
                    selectedStudentIds.forEach(id => {
                        formData.append('selectedStudentIds', id);
                    });
                    formData.append('__RequestVerificationToken', token);

                    const res = await fetch('?handler=SendNotification', {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': token
                        },
                        body: formData
                    });

                    if (!res.ok) throw new Error('HTTP ' + res.status);
                    const data = await res.json();
                    
                    if (data.success) {
                        alert(data.message || 'Gửi email thành công!');
                        modal.hide();
                    } else {
                        alert('Gửi email thất bại: ' + (data.message || 'Lỗi không xác định'));
                    }
                } catch (err) {
                    alert('Có lỗi xảy ra: ' + err.message);
                } finally {
                    btnSendEmail.disabled = false;
                    btnSendEmail.innerHTML = originalHtml;
                }
            });
        });
    </script>
    <partial name="_ValidationScriptsPartial" />
}