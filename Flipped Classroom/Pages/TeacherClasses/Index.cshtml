@page
@model Flipped_Classroom.Pages.TeacherClasses.IndexModel
@{
    ViewData["Title"] = "My Managed Classes";
}

<style>
    .dashboard-kpi {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .dashboard-kpi:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.12) !important;
    }
    .class-dashboard-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .class-dashboard-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.12) !important;
    }
    .pending-student-badge {
        font-size: 0.72rem;
        padding: 0.25em 0.6em;
    }
</style>

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold" style="color: #1a73e8;">
            <i class="bi bi-speedometer2 me-2"></i>Dashboard Giảng Dạy
        </h2>
    </div>

    @if (Model.Class != null && Model.Class.Any())
    {
        <!-- KPI Cards Row -->
        <div class="row g-4 mb-5">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-3 p-4 dashboard-kpi" style="background: linear-gradient(135deg, #e8f0fe 0%, #d2e3fc 100%);">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-secondary small fw-medium">Tổng số lớp</div>
                            <h3 class="fw-bold text-primary mb-0 mt-1">@Model.TotalClassesCount</h3>
                        </div>
                        <div class="rounded-circle bg-white text-primary shadow-sm d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                            <i class="bi bi-building fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-3 p-4 dashboard-kpi" style="background: linear-gradient(135deg, #e6f4ea 0%, #ceead6 100%);">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-secondary small fw-medium">Tổng học viên</div>
                            <h3 class="fw-bold text-success mb-0 mt-1">@Model.TotalStudentsAll</h3>
                        </div>
                        <div class="rounded-circle bg-white text-success shadow-sm d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                            <i class="bi bi-people-fill fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-3 p-4 dashboard-kpi" style="background: linear-gradient(135deg, #fef7e0 0%, #feefc3 100%);">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-secondary small fw-medium">Tổng bài tập</div>
                            <h3 class="fw-bold mb-0 mt-1" style="color: #e8a700;">@Model.TotalAssignmentsAll</h3>
                        </div>
                        <div class="rounded-circle bg-white shadow-sm d-flex align-items-center justify-content-center" style="width: 50px; height: 50px; color: #e8a700;">
                            <i class="bi bi-file-earmark-text-fill fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Per-class Dashboard Cards -->
        <h4 class="fw-bold mb-4" style="color: #3c4043;">
            <i class="bi bi-grid-1x2-fill text-primary me-2"></i>Tổng quan từng lớp
        </h4>

        <div class="row g-4">
            @foreach (var item in Model.Class)
            {
                var progress = Model.ClassProgressMap.TryGetValue(item.Id, out var p) ? p : 0;
                var subMap = Model.ClassSubmissionMap.TryGetValue(item.Id, out var sm) ? sm : (0, 0);
                var submissionPercent = subMap.Item2 > 0 ? (int)Math.Round((double)subMap.Item1 * 100 / subMap.Item2) : 0;
                var pendingStudents = Model.ClassPendingStudents.TryGetValue(item.Id, out var ps) ? ps : new List<string>();
                var studentCount = Model.ClassStudentCount.TryGetValue(item.Id, out var sc) ? sc : 0;
                var lessonCount = Model.ClassLessonCount.TryGetValue(item.Id, out var lc) ? lc : 0;

                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm class-dashboard-card h-100" style="border-radius: 15px; overflow: hidden;">
                        <!-- Card Header -->
                        <div class="card-header text-white p-4" style="background: linear-gradient(135deg, #1a73e8 0%, #4285f4 100%); border-bottom: none;">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="mb-0 fw-bold text-truncate me-2" title="@item.ClassName">@item.ClassName</h5>
                                <span class="badge bg-light text-primary rounded-pill px-3 flex-shrink-0">@item.Status</span>
                            </div>
                            <div class="d-flex gap-3 mt-2 text-white-50 small">
                                <span><i class="bi bi-people-fill me-1"></i> @studentCount học viên</span>
                                <span><i class="bi bi-journal-text me-1"></i> @lessonCount bài học</span>
                                <span><i class="bi bi-file-earmark-text me-1"></i> @(item.Assignments?.Count ?? 0) bài tập</span>
                            </div>
                        </div>

                        <!-- Card Body -->
                        <div class="card-body p-4">
                            <!-- Tiến độ lộ trình -->
                            <div class="mb-4">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="fw-semibold text-dark small">
                                        <i class="bi bi-bezier2 text-primary me-1"></i> Tiến độ lộ trình học
                                    </span>
                                    <span class="badge bg-primary-subtle text-primary rounded-pill px-2" style="font-size: 0.78rem;">
                                        @progress%
                                    </span>
                                </div>
                                <div class="progress" style="height: 8px; border-radius: 10px;">
                                    <div class="progress-bar rounded"
                                         role="progressbar"
                                         style="width: @progress%; background: linear-gradient(90deg, #34a853, #1a73e8);"
                                         aria-valuenow="@progress" aria-valuemin="0" aria-valuemax="100">
                                    </div>
                                </div>
                            </div>

                            <!-- Tỷ lệ nộp bài -->
                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="fw-semibold text-dark small">
                                        <i class="bi bi-file-earmark-check text-success me-1"></i> Tỷ lệ nộp bài tập
                                    </span>
                                    <span class="badge bg-success-subtle text-success rounded-pill px-2" style="font-size: 0.78rem;">
                                        @subMap.Item1/@subMap.Item2 (@submissionPercent%)
                                    </span>
                                </div>
                                <div class="progress" style="height: 8px; border-radius: 10px;">
                                    <div class="progress-bar bg-success rounded"
                                         role="progressbar"
                                         style="width: @submissionPercent%;"
                                         aria-valuenow="@submissionPercent" aria-valuemin="0" aria-valuemax="100">
                                    </div>
                                </div>
                            </div>

                            <!-- Học sinh chưa nộp bài -->
                            @if (pendingStudents.Any())
                            {
                                <div class="mt-3 p-3 rounded" style="background-color: #fef7f7; border: 1px solid #fce8e6;">
                                    <div class="fw-semibold text-danger small mb-2">
                                        <i class="bi bi-exclamation-triangle-fill me-1"></i> Học viên còn thiếu bài nộp (@pendingStudents.Count)
                                    </div>
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var name in pendingStudents)
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger rounded-pill pending-student-badge">
                                                @name
                                            </span>
                                        }
                                    </div>
                                </div>
                            }
                            else if ((item.Assignments?.Count ?? 0) > 0 && studentCount > 0)
                            {
                                <div class="mt-3 p-2 rounded text-center" style="background-color: #e6f4ea;">
                                    <span class="text-success small fw-medium">
                                        <i class="bi bi-check-circle-fill me-1"></i> Tất cả học viên đã nộp đầy đủ bài tập
                                    </span>
                                </div>
                            }
                        </div>

                        <!-- Card Footer -->
                        <div class="card-footer bg-white border-0 px-4 pb-4 pt-0">
                            <a asp-page="./Details" asp-route-id="@item.Id"
                               class="btn btn-primary w-100 rounded-pill shadow-sm"
                               style="background-color: #1a73e8; border: none;">
                                <i class="bi bi-gear me-1"></i> Quản lý lớp
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="col-12 text-center py-5">
            <div class="mb-3 text-muted">
                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="9" y1="3" x2="9" y2="21"></line>
                </svg>
            </div>
            <h5 class="text-muted">Bạn chưa được phân giảng dạy lớp nào</h5>
        </div>
    }
</div>
