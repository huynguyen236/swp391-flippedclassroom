@page
@model Flipped_Classroom.Pages.TeacherClasses.IndexModel
@{
    ViewData["Title"] = "My Managed Classes";
}



<div class="container py-5 teacher-dashboard-container">
    <!-- Title Area -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <h2 class="fw-bold d-flex align-items-center gap-2 mb-0" style="color: var(--color-on-background);">
            <span class="material-symbols-outlined text-primary fs-3">dashboard</span>
            Dashboard Giảng Dạy
        </h2>
    </div>

    @if (Model.Class != null && Model.Class.Any())
    {
        <!-- Bento KPI Cards Row -->
        <div class="row g-4 mb-5">
            <div class="col-md-4">
                <div class="bento-kpi-card bg-primary-fixed">
                    <div class="d-flex justify-content-between align-items-start w-100">
                        <span class="fw-semibold text-muted" style="font-size: 0.9rem;">Tổng số lớp</span>
                        <div class="kpi-icon-container">
                            <span class="material-symbols-outlined">school</span>
                        </div>
                    </div>
                    <div class="mt-3">
                        <h2 class="fw-bold mb-0">@Model.TotalClassesCount</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="bento-kpi-card bg-tertiary-fixed">
                    <div class="d-flex justify-content-between align-items-start w-100">
                        <span class="fw-semibold text-muted" style="font-size: 0.9rem;">Tổng học viên</span>
                        <div class="kpi-icon-container">
                            <span class="material-symbols-outlined">group</span>
                        </div>
                    </div>
                    <div class="mt-3">
                        <h2 class="fw-bold mb-0">@Model.TotalStudentsAll</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="bento-kpi-card bg-secondary-fixed">
                    <div class="d-flex justify-content-between align-items-start w-100">
                        <span class="fw-semibold text-muted" style="font-size: 0.9rem;">Tổng bài tập</span>
                        <div class="kpi-icon-container">
                            <span class="material-symbols-outlined">task_alt</span>
                        </div>
                    </div>
                    <div class="mt-3">
                        <h2 class="fw-bold mb-0">@Model.TotalAssignmentsAll</h2>
                    </div>
                </div>
            </div>
        </div>

        <!-- Class Codes Management Section -->
        <div class="card card-premium p-4 mb-5">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
                <div>
                    <h4 class="fw-bold mb-1 text-primary d-flex align-items-center gap-2">
                        <span class="material-symbols-outlined">key</span>
                        Quản lý mã lớp học
                    </h4>
                    <p class="text-muted small mb-0">Xem và chia sẻ mã lớp học cho học viên để tham gia lớp.</p>
                </div>
                <div style="min-width: 250px;">
                    <select id="classCodeFilter" class="form-select rounded-pill px-3">
                        <option value="all">Tất cả lớp học</option>
                        @foreach (var item in Model.Class)
                        {
                            <option value="class-row-@item.Id">@item.ClassName</option>
                        }
                    </select>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr class="table-light">
                            <th scope="col" class="border-0 px-4 py-3 text-muted fw-semibold small text-uppercase" style="border-radius: 8px 0 0 8px;">Tên lớp học</th>
                            <th scope="col" class="border-0 px-4 py-3 text-muted fw-semibold small text-uppercase">Mã mời (Invite Code)</th>
                            <th scope="col" class="border-0 px-4 py-3 text-muted fw-semibold small text-uppercase text-end" style="border-radius: 0 8px 8px 0; width: 150px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Class)
                        {
                            <tr id="class-row-@item.Id" class="class-code-row border-bottom">
                                <td class="fw-bold px-4 py-3 text-dark">@item.ClassName</td>
                                <td class="px-4 py-3">
                                    <span class="badge bg-light text-dark font-monospace px-3 py-2 border rounded" style="font-size: 0.9rem; letter-spacing: 0.5px;">
                                        @(string.IsNullOrEmpty(item.InviteCode) ? "Không có mã" : item.InviteCode)
                                    </span>
                                </td>
                                <td class="text-end px-4 py-3">
                                    @if (!string.IsNullOrEmpty(item.InviteCode))
                                    {
                                        <button class="btn btn-premium-outline btn-sm px-3 py-1.5" onclick="copyInviteCode(this, '@item.InviteCode')">
                                            <span class="material-symbols-outlined">content_copy</span> Copy
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">N/A</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <script>
            function copyInviteCode(btn, code) {
                navigator.clipboard.writeText(code).then(function() {
                    var originalHtml = btn.innerHTML;
                    btn.innerHTML = '<span class="material-symbols-outlined">check</span> Copied';
                    btn.style.borderColor = '#34a853';
                    btn.style.color = '#34a853';
                    btn.disabled = true;
                    
                    setTimeout(function() {
                        btn.innerHTML = originalHtml;
                        btn.style.borderColor = '';
                        btn.style.color = '';
                        btn.disabled = false;
                    }, 2000);
                }, function(err) {
                    console.error('Lỗi khi copy mã: ', err);
                });
            }

            document.getElementById('classCodeFilter').addEventListener('change', function() {
                var selectedValue = this.value;
                var rows = document.querySelectorAll('.class-code-row');
                rows.forEach(function(row) {
                    if (selectedValue === 'all' || row.id === selectedValue) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            });
        </script>

        <!-- Per-class Dashboard Cards -->
        <h4 class="fw-bold mb-4 d-flex align-items-center gap-2" style="color: var(--color-on-background);">
            <span class="material-symbols-outlined text-primary">view_agenda</span>
            Tổng quan từng lớp
        </h4>

        <div class="row g-4">
            @foreach (var item in Model.Class)
            {
                var progress = Model.ClassProgressMap.TryGetValue(item.Id, out var p) ? p : 0;
                var subMap = Model.ClassSubmissionMap.TryGetValue(item.Id, out var sm) ? sm : (0, 0);
                var submissionPercent = subMap.Item2 > 0 ? (int)Math.Round((double)subMap.Item1 * 100 / subMap.Item2) : 0;
                var pendingStudents = Model.ClassPendingStudents.TryGetValue(item.Id, out var ps) ? ps : new List<string>();
                var studentCount = Model.ClassStudentCount.TryGetValue(item.Id, out var sc) ? sc : 0;
                var lessonCount = Model.ClassLessonCount.TryGetValue(item.Id, out var lc) ? lc : 0;
                var isActive = string.Equals(item.Status, "Active", StringComparison.OrdinalIgnoreCase);

                <div class="col-lg-6">
                    <div class="class-premium-card h-100">
                        <!-- Card Header -->
                        <div class="class-card-header @(isActive ? "bg-active" : "bg-completed")">
                            <div class="header-decor-blur"></div>
                            <div class="d-flex justify-content-between align-items-start mb-2 relative z-1">
                                <h4 class="mb-0 fw-bold text-truncate me-2" title="@item.ClassName" style="max-width: 75%;">@item.ClassName</h4>
                                <span class="badge bg-white text-dark rounded-pill px-3 py-1.5 shadow-sm small fw-bold">@item.Status</span>
                            </div>
                            <div class="d-flex gap-3 mt-3 text-white-50 small relative z-1">
                                <span class="d-flex align-items-center gap-1"><span class="material-symbols-outlined" style="font-size:16px;">group</span> @studentCount học viên</span>
                                <span class="d-flex align-items-center gap-1"><span class="material-symbols-outlined" style="font-size:16px;">menu_book</span> @lessonCount bài học</span>
                                <span class="d-flex align-items-center gap-1"><span class="material-symbols-outlined" style="font-size:16px;">assignment</span> @(item.Assignments?.Count ?? 0) bài tập</span>
                            </div>
                        </div>

                        <!-- Card Body -->
                        <div class="card-body p-4 d-flex flex-column gap-4">
                            <!-- Progress Lộ trình -->
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="fw-semibold text-muted small d-flex align-items-center gap-1">
                                        <span class="material-symbols-outlined text-primary" style="font-size: 18px;">monitoring</span>
                                        Tiến độ lộ trình học
                                    </span>
                                    <span class="badge bg-light text-primary border rounded-pill px-2">
                                        @progress%
                                    </span>
                                </div>
                                <div class="progress-track-custom">
                                    <div class="progress-fill-primary" style="width: @progress%;"></div>
                                </div>
                            </div>

                            <!-- Tỷ lệ nộp bài -->
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="fw-semibold text-muted small d-flex align-items-center gap-1">
                                        <span class="material-symbols-outlined text-success" style="font-size: 18px;">assignment_turned_in</span>
                                        Tỷ lệ nộp bài tập
                                    </span>
                                    <span class="badge bg-light text-success border rounded-pill px-2">
                                        @subMap.Item1/@subMap.Item2 (@submissionPercent%)
                                    </span>
                                </div>
                                <div class="progress-track-custom">
                                    <div class="progress-fill-success" style="width: @submissionPercent%;"></div>
                                </div>
                            </div>

                            <!-- Học sinh chưa nộp bài -->
                            @if (pendingStudents.Any())
                            {
                                <div class="alert-soft-error">
                                    <div class="fw-semibold text-danger small mb-2 d-flex align-items-center gap-1">
                                        <span class="material-symbols-outlined text-danger" style="font-size: 18px;">warning</span>
                                        Học viên còn thiếu bài nộp (@pendingStudents.Count)
                                    </div>
                                    <div class="d-flex flex-wrap gap-2 mt-1">
                                        @foreach (var name in pendingStudents)
                                        {
                                            <span class="pending-badge-outline">
                                                @name
                                            </span>
                                        }
                                    </div>
                                </div>
                            }
                            else if ((item.Assignments?.Count ?? 0) > 0 && studentCount > 0)
                            {
                                <div class="p-2 rounded text-center" style="background-color: rgba(52, 168, 83, 0.08); border: 1px solid rgba(52, 168, 83, 0.2);">
                                    <span class="text-success small fw-semibold d-flex align-items-center justify-content-center gap-1">
                                        <span class="material-symbols-outlined" style="font-size: 18px;">check_circle</span>
                                        Tất cả học viên đã nộp đầy đủ bài tập
                                    </span>
                                </div>
                            }
                        </div>

                        <!-- Card Footer -->
                        <div class="card-footer bg-white border-0 px-4 pb-4 pt-0 d-flex gap-2">
                            <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-premium-primary flex-grow-1 d-flex align-items-center justify-content-center gap-1">
                                <span class="material-symbols-outlined" style="font-size: 18px;">settings</span> Quản lý lớp
                            </a>
                            <button type="button" class="btn btn-premium-outline px-3 send-email-btn d-flex align-items-center justify-content-center" data-class-id="@item.Id" data-class-name="@item.ClassName" title="Gửi email thông báo">
                                <span class="material-symbols-outlined" style="font-size: 18px;">mail</span>
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="col-12 text-center py-5">
            <div class="mb-3 text-muted">
                <span class="material-symbols-outlined" style="font-size: 64px; color: var(--color-outline-variant);">folder_open</span>
            </div>
            <h5 class="text-muted">Bạn chưa được phân giảng dạy lớp nào</h5>
        </div>
    }
</div>

<!-- Email Notification Modal -->
<div class="modal fade" id="emailNotificationModal" tabindex="-1" aria-labelledby="emailNotificationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 12px; background: var(--color-surface-container);">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold d-flex align-items-center gap-2" id="emailNotificationModalLabel" style="color: var(--color-on-background);">
                    <span class="material-symbols-outlined text-primary">mail</span>
                    Gửi Email Thông Báo - <span id="modalClassName" class="text-primary"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <form id="emailNotificationForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="emailClassId" name="classId" />

                    <!-- Recipient Selection -->
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-uppercase tracking-wider text-muted">Người nhận</label>
                        <div class="d-flex gap-3 mb-2">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="recipientType" id="recipientAll" value="all" checked>
                                <label class="form-check-label fw-medium" for="recipientAll">
                                    Tất cả học viên
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="recipientType" id="recipientSelect" value="select">
                                <label class="form-check-label fw-medium" for="recipientSelect">
                                    Chọn học viên cụ thể
                                </label>
                            </div>
                        </div>

                        <!-- Student List (Hidden by default, shown when recipientSelect is active) -->
                        <div id="studentSelectionContainer" class="border rounded p-3 bg-light" style="display: none; max-height: 200px; overflow-y: auto;">
                            <div class="form-check mb-2 pb-2 border-bottom">
                                <input class="form-check-input" type="checkbox" id="selectAllStudents">
                                <label class="form-check-label fw-bold text-dark" for="selectAllStudents">
                                    Chọn tất cả
                                </label>
                            </div>
                            <div id="studentListContainer">
                                <!-- Populated via AJAX -->
                            </div>
                        </div>
                    </div>

                    <!-- Subject -->
                    <div class="mb-3">
                        <label for="emailSubject" class="form-label fw-bold small text-uppercase tracking-wider text-muted">Tiêu đề (Subject)</label>
                        <input type="text" class="form-control rounded-3" id="emailSubject" name="subject" placeholder="Nhập tiêu đề thông báo..." required>
                    </div>

                    <!-- Body -->
                    <div class="mb-3">
                        <label for="emailBody" class="form-label fw-bold small text-uppercase tracking-wider text-muted">Nội dung thông báo (Body)</label>
                        <textarea class="form-control rounded-3" id="emailBody" name="body" rows="6" placeholder="Nhập nội dung chi tiết..." required></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-top-0 pt-0">
                <button type="button" class="btn btn-premium-outline" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-premium-primary" id="btnSendEmail">
                    <span class="d-flex align-items-center gap-1">
                        <span class="material-symbols-outlined" style="font-size: 18px;">send</span> Gửi Email
                    </span>
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const modal = new bootstrap.Modal(document.getElementById('emailNotificationModal'));
        const modalClassName = document.getElementById('modalClassName');
        const emailClassId = document.getElementById('emailClassId');
        const studentSelectionContainer = document.getElementById('studentSelectionContainer');
        const studentListContainer = document.getElementById('studentListContainer');
        const selectAllStudents = document.getElementById('selectAllStudents');
        const btnSendEmail = document.getElementById('btnSendEmail');
        const form = document.getElementById('emailNotificationForm');

        // Toggle recipient selector list
        document.querySelectorAll('input[name="recipientType"]').forEach(radio => {
            radio.addEventListener('change', function () {
                if (this.value === 'select') {
                    studentSelectionContainer.style.display = 'block';
                } else {
                    studentSelectionContainer.style.display = 'none';
                }
            });
        });

        // Select/Deselect all students checkbox
        selectAllStudents.addEventListener('change', function () {
            document.querySelectorAll('.student-checkbox').forEach(cb => {
                cb.checked = this.checked;
            });
        });

        // Click "Gửi Email" button on card
        document.querySelectorAll('.send-email-btn').forEach(btn => {
            btn.addEventListener('click', async function () {
                const classId = this.dataset.classId;
                const className = this.dataset.className;

                modalClassName.textContent = className;
                emailClassId.value = classId;
                studentListContainer.innerHTML = '<div class="text-center py-2"><span class="spinner-border spinner-border-sm text-primary"></span> Đang tải...</div>';
                
                // Reset form fields
                document.getElementById('emailSubject').value = '';
                document.getElementById('emailBody').value = '';
                document.getElementById('recipientAll').checked = true;
                studentSelectionContainer.style.display = 'none';
                selectAllStudents.checked = false;

                modal.show();

                try {
                    const res = await fetch(`?handler=ClassMembers&classId=${classId}`);
                    if (!res.ok) throw new Error('HTTP ' + res.status);
                    const students = await res.json();
                    
                    studentListContainer.innerHTML = '';
                    if (!students || students.length === 0) {
                        studentListContainer.innerHTML = '<p class="text-muted small mb-0">Không có học viên nào trong lớp.</p>';
                    } else {
                        students.forEach(student => {
                            const div = document.createElement('div');
                            div.className = 'form-check py-1';
                            div.innerHTML = `
                                <input class="form-check-input student-checkbox" type="checkbox" value="${student.id}" id="student-${student.id}">
                                <label class="form-check-label text-dark" for="student-${student.id}">
                                    ${student.username} (${student.email || 'N/A'})
                                </label>
                            `;
                            studentListContainer.appendChild(div);
                        });
                        
                        // Bind change events to student checkboxes to sync "Select All" status
                        document.querySelectorAll('.student-checkbox').forEach(cb => {
                            cb.addEventListener('change', function () {
                                const allCbs = document.querySelectorAll('.student-checkbox');
                                const checkedCbs = document.querySelectorAll('.student-checkbox:checked');
                                selectAllStudents.checked = allCbs.length === checkedCbs.length;
                            });
                        });
                    }
                } catch (err) {
                    studentListContainer.innerHTML = '<p class="text-danger small mb-0">Lỗi khi tải danh sách học viên.</p>';
                }
            });
        });

        // Click "Gửi" button inside modal
        btnSendEmail.addEventListener('click', async function () {
            const classId = emailClassId.value;
            const subject = document.getElementById('emailSubject').value.trim();
            const body = document.getElementById('emailBody').value.trim();
            const isSelect = document.getElementById('recipientSelect').checked;

            if (!subject || !body) {
                alert('Vui lòng điền đầy đủ tiêu đề và nội dung.');
                return;
            }

            const selectedStudentIds = [];
            if (isSelect) {
                document.querySelectorAll('.student-checkbox:checked').forEach(cb => {
                    selectedStudentIds.push(parseInt(cb.value));
                });
                if (selectedStudentIds.length === 0) {
                    alert('Vui lòng chọn ít nhất một học viên.');
                    return;
                }
            }

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            
            const originalHtml = btnSendEmail.innerHTML;
            btnSendEmail.disabled = true;
            btnSendEmail.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Đang gửi...';

            try {
                const formData = new FormData();
                formData.append('classId', classId);
                formData.append('subject', subject);
                formData.append('body', body);
                selectedStudentIds.forEach(id => {
                    formData.append('selectedStudentIds', id);
                });
                formData.append('__RequestVerificationToken', token);

                const res = await fetch('?handler=SendNotification', {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token
                    },
                    body: formData
                });

                if (!res.ok) throw new Error('HTTP ' + res.status);
                const data = await res.json();
                
                if (data.success) {
                    alert(data.message || 'Gửi email thành công!');
                    modal.hide();
                } else {
                    alert('Gửi email thất bại: ' + (data.message || 'Lỗi không xác định'));
                }
            } catch (err) {
                alert('Có lỗi xảy ra: ' + err.message);
            } finally {
                btnSendEmail.disabled = false;
                btnSendEmail.innerHTML = originalHtml;
            }
        });
    });
</script>

