@page
@model Flipped_Classroom.Pages.Curriculums.IndexModel
@{
    ViewData["Title"] = "Quản lý khung chương trình";
}

<div class="container-fluid px-4 py-4">
    <!-- Header Page -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-dark fw-bold">
                <i class="bi bi-diagram-3-fill text-primary me-2"></i>Quản lý khung chương trình
            </h1>
            <p class="text-muted mb-0">Quản lý và thiết kế các khung chương trình giảng dạy chuẩn (LMS Curriculum).</p>
        </div>
        <button type="button" class="btn btn-primary shadow-sm rounded-pill px-4 py-2 d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#createCurriculumModal">
            <i class="bi bi-plus-lg"></i>
            <span>Tạo Khung Mới</span>
        </button>
    </div>

    <!-- Alert Success -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-check-circle-fill fs-5 me-2"></i>
            <div>
                @TempData["SuccessMessage"]
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Validation Errors -->
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i>
            <span class="fw-semibold">Vui lòng kiểm tra lại thông tin:</span>
            <div asp-validation-summary="All" class="mt-2 text-danger"></div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Card wrapper -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            @if (Model.Curriculums == null || !Model.Curriculums.Any())
            {
                <div class="text-center py-5">
                    <div class="text-muted mb-3">
                        <i class="bi bi-folder-x display-1"></i>
                    </div>
                    <h5 class="text-dark fw-semibold">Chưa có khung chương trình nào</h5>
                    <p class="text-muted max-width-500 mx-auto">Hãy tạo khung chương trình giảng dạy đầu tiên để bắt đầu xây dựng các lộ trình bài học và tài liệu.</p>
                    <button type="button" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#createCurriculumModal">
                        Tạo mới ngay
                    </button>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover table-borderless align-middle mb-0">
                        <thead class="table-light text-muted uppercase fs-7">
                            <tr>
                                <th class="ps-4 py-3">Tên Khung Chương Trình</th>
                                <th class="py-3">Mô tả</th>
                                <th class="py-3">Người Quản Lý</th>
                                <th class="py-3">Ngày Tạo</th>
                                <th class="pe-4 py-3 text-end">Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Curriculums)
                            {
                                <tr>
                                    <td class="ps-4 py-3">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="bg-primary-subtle text-primary p-2.5 rounded-3 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                                                <i class="bi bi-journal-text fs-5"></i>
                                            </div>
                                            <div>
                                                <a asp-page="./Builder" asp-route-id="@item.Id" class="fw-bold text-dark text-decoration-none hover-primary">
                                                    @item.CurriculumName
                                                </a>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-3 text-muted text-truncate" style="max-width: 300px;">
                                        @(string.IsNullOrWhiteSpace(item.Description) ? "Không có mô tả" : item.Description)
                                    </td>
                                    <td class="py-3">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="avatar-sm bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center fw-semibold text-uppercase" style="width: 28px; height: 28px; font-size: 0.75rem;">
                                                @(item.Manager?.FirstName?.Substring(0, 1) ?? "?")
                                            </span>
                                            <span class="text-dark">@(item.Manager?.FirstName + " " + item.Manager?.LastName)</span>
                                        </div>
                                    </td>
                                    <td class="py-3 text-muted">
                                        <i class="bi bi-calendar3 me-1"></i>
                                        @item.CreatedAt?.ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td class="pe-4 py-3 text-end">
                                        <a asp-page="./Builder" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3 d-inline-flex align-items-center gap-1.5 hover-scale">
                                            <i class="bi bi-pencil-square"></i>
                                            <span>Xây dựng lộ trình</span>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal Tạo Mới -->
<div class="modal fade" id="createCurriculumModal" tabindex="-1" aria-labelledby="createCurriculumModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-dark" id="createCurriculumModalLabel">Tạo Khung Chương Trình Mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="Create">
                <div class="modal-body py-4">
                    <div class="mb-3">
                        <label for="NewCurriculumName" class="form-label fw-semibold text-muted fs-7">Tên Khung Chương Trình <span class="text-danger">*</span></label>
                        <input type="text" asp-for="NewCurriculumName" class="form-control rounded-3 py-2.5" placeholder="Nhập tên khung chương trình..." required />
                        <span asp-validation-for="NewCurriculumName" class="text-danger fs-7"></span>
                    </div>
                    <div class="mb-0">
                        <label for="NewDescription" class="form-label fw-semibold text-muted fs-7">Mô tả chi tiết</label>
                        <textarea asp-for="NewDescription" class="form-control rounded-3 py-2.5" rows="4" placeholder="Nhập mô tả khung chương trình..."></textarea>
                        <span asp-validation-for="NewDescription" class="text-danger fs-7"></span>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0 justify-content-end gap-2">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">Lưu</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .fs-7 {
            font-size: 0.825rem;
        }
        .bg-primary-subtle {
            background-color: rgba(13, 110, 253, 0.08) !important;
        }
        .hover-primary:hover {
            color: #0d6efd !important;
        }
        .hover-scale {
            transition: transform 0.2s ease, background-color 0.2s ease;
        }
        .hover-scale:hover {
            transform: translateY(-1px);
        }
        .max-width-500 {
            max-width: 500px;
        }
    </style>
}
