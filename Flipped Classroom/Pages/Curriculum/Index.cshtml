@page
@model Flipped_Classroom.Pages.Curriculums.IndexModel
@{
    ViewData["Title"] = "Quản lý khung chương trình";
}

<div class="container-fluid py-4">
    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="fw-bold mb-1 text-dark" style="font-family: var(--font-heading);">
                <span class="material-symbols-outlined text-primary align-middle me-1">menu_book</span>
                Quản lý khung chương trình
            </h1>
            <p class="text-muted mb-0">Quản lý và thiết kế các khung chương trình giảng dạy chuẩn (LMS Curriculum).</p>
        </div>
        <div>
            <button type="button" class="btn btn-premium-primary rounded-pill px-4 d-inline-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#createCurriculumModal">
                <span class="material-symbols-outlined">add</span> Tạo Khung Mới
            </button>
        </div>
    </div>

    <!-- Alert Success -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 d-flex align-items-center mb-4" role="alert">
            <span class="material-symbols-outlined text-success me-2">check_circle</span>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Validation Errors -->
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <span class="material-symbols-outlined text-danger me-2">warning</span>
            <span class="fw-semibold me-2">Vui lòng kiểm tra lại thông tin:</span>
            <div asp-validation-summary="All" class="mt-2 text-danger small"></div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Main Card Wrapper -->
    <div class="card card-premium shadow-sm overflow-hidden mb-4">
        <div class="card-body p-0">
            @if (Model.Curriculums == null || !Model.Curriculums.Any())
            {
                <div class="text-center py-5">
                    <div class="w-16 h-16 bg-light rounded-circle d-flex align-items-center justify-content-center text-muted mx-auto mb-3" style="width: 64px; height: 64px; background-color: var(--color-surface-container-low) !important;">
                        <span class="material-symbols-outlined text-[36px] opacity-40">folder_off</span>
                    </div>
                    <h5 class="text-dark fw-bold mb-1">Chưa có khung chương trình nào</h5>
                    <p class="text-muted small max-width-500 mx-auto mb-3">Hãy tạo khung chương trình giảng dạy đầu tiên để bắt đầu xây dựng các lộ trình bài học và tài liệu.</p>
                    <button type="button" class="btn btn-premium-primary btn-sm rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#createCurriculumModal">
                        Tạo mới ngay
                    </button>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle table-hover mb-0">
                        <thead class="bg-light text-muted uppercase">
                            <tr>
                                <th class="ps-4 py-3">Tên Khung Chương Trình</th>
                                <th class="py-3">Mô tả</th>
                                <th class="py-3">Người Quản Lý</th>
                                <th class="py-3">Ngày Tạo</th>
                                <th class="pe-4 py-3 text-end">Hành động</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y">
                            @foreach (var item in Model.Curriculums)
                            {
                                <tr>
                                    <td class="ps-4 py-3">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="bg-primary-fixed text-primary p-2.5 rounded-3 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px; background-color: rgba(var(--bs-primary-rgb), 0.08) !important;">
                                                <span class="material-symbols-outlined text-[24px]">description</span>
                                            </div>
                                            <div>
                                                <a asp-page="./Builder" asp-route-id="@item.Id" class="fw-bold text-dark text-decoration-none hover-primary">
                                                    @item.CurriculumName
                                                </a>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-3 text-muted text-truncate" style="max-width: 300px;" title="@item.Description">
                                        @(string.IsNullOrWhiteSpace(item.Description) ? "Không có mô tả" : item.Description)
                                    </td>
                                    <td class="py-3">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="avatar-initials-circle avatar-bg-blue" style="width: 28px; height: 28px; font-size: 0.7rem; font-weight: 700; text-transform: uppercase;">
                                                @(item.Manager?.FirstName?.Substring(0, 1) ?? "?")
                                            </span>
                                            <span class="text-dark fw-medium">@(item.Manager?.FirstName + " " + item.Manager?.LastName)</span>
                                        </div>
                                    </td>
                                    <td class="py-3 text-muted" style="font-size: 0.9rem;">
                                        <span class="d-inline-flex align-items-center gap-1">
                                            <span class="material-symbols-outlined text-muted text-[16px]">calendar_today</span>
                                            @item.CreatedAt?.ToString("dd/MM/yyyy HH:mm")
                                        </span>
                                    </td>
                                    <td class="pe-4 py-3 text-end">
                                        <a asp-page="./Builder" asp-route-id="@item.Id" class="btn btn-premium-outline btn-sm rounded-pill px-3 d-inline-flex align-items-center gap-1.5 hover-scale">
                                            <span class="material-symbols-outlined text-[16px]">map</span>
                                            <span>Xây dựng lộ trình</span>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal Tạo Mới -->
<div class="modal fade" id="createCurriculumModal" tabindex="-1" aria-labelledby="createCurriculumModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-dark" id="createCurriculumModalLabel">Tạo Khung Chương Trình Mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="Create">
                <div class="modal-body py-4">
                    <div class="mb-3">
                        <label for="NewCurriculumName" class="form-label fw-semibold text-muted small mb-1">Tên Khung Chương Trình <span class="text-danger">*</span></label>
                        <input type="text" asp-for="NewCurriculumName" class="form-control rounded-3" placeholder="Nhập tên khung chương trình..." required />
                        <span asp-validation-for="NewCurriculumName" class="text-danger small mt-1 d-block"></span>
                    </div>
                    <div class="mb-0">
                        <label for="NewDescription" class="form-label fw-semibold text-muted small mb-1">Mô tả chi tiết</label>
                        <textarea asp-for="NewDescription" class="form-control rounded-3" rows="4" placeholder="Nhập mô tả khung chương trình..."></textarea>
                        <span asp-validation-for="NewDescription" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0 justify-content-end gap-2">
                    <button type="button" class="btn btn-premium-outline rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-premium-primary rounded-pill px-4 shadow-sm">Lưu</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .hover-primary:hover {
            color: var(--color-primary) !important;
        }
        .hover-scale {
            transition: transform 0.2s ease, background-color 0.2s ease;
        }
        .hover-scale:hover {
            transform: translateY(-1px);
        }
        .max-width-500 {
            max-width: 500px;
        }
    </style>
}
