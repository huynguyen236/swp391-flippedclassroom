@page
@model Flipped_Classroom.Pages.Classrooms.EditModel

@{
    ViewData["Title"] = "Edit Classroom";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm" style="border-radius: 15px;">
                <div class="card-header text-white p-4" style="background: linear-gradient(135deg, #1a73e8 0%, #4285f4 100%); border-radius: 15px 15px 0 0;">
                    <h3 class="fw-bold mb-0">Sửa Lớp Học</h3>
                </div>

                <div class="card-body p-5">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="Class.Id" />
                        <input type="hidden" asp-for="Class.InviteCode" />
                        <input type="hidden" asp-for="Class.CreatedAt" />
                        <input type="hidden" asp-for="Class.CurriculumId" />

                        <div class="mb-3">
                            <label asp-for="Class.ClassName" class="form-label text-muted fw-bold">Tên Lớp Học</label>
                            <input asp-for="Class.ClassName" class="form-control" placeholder="Nhập tên lớp học..." maxlength="999" />
                            <span asp-validation-for="Class.ClassName" class="text-danger"></span>
                        </div>

                        <div class="mb-3 position-relative">
                            <label class="form-label text-muted fw-bold">Giáo Viên Phụ Trách</label>
                            <input type="text" class="form-control" id="managerDisplayInput" placeholder="Chọn giáo viên phụ trách..." value="@(Model.Class.Manager != null ? $"{Model.Class.Manager.FirstName} {Model.Class.Manager.LastName}" : "")" autocomplete="off" style="cursor: text; background-image: url('data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 16 16%22><path fill=%22none%22 stroke=%22%23343a40%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22 stroke-width=%222%22 d=%22M2 5l6 6 6-6%22/></svg>'); background-repeat: no-repeat; background-position: right .75rem center; background-size: 16px 12px;" />
                            <ul class="dropdown-menu w-100 shadow-sm" id="managerDropdown" style="max-height: 250px; overflow-y: auto; margin-top: 2px;">
                                @if (ViewBag.ManagerId != null)
                                {
                                    foreach (var item in (SelectList)ViewBag.ManagerId)
                                    {
                                        <li><a class="dropdown-item manager-option fst-normal" href="javascript:void(0)" data-value="@item.Value">@item.Text</a></li>
                                    }
                                }
                            </ul>
                            <input type="hidden" asp-for="Class.ManagerId" id="managerIdInput" />
                            <span asp-validation-for="Class.ManagerId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Class.Description" class="form-label text-muted fw-bold">Mô tả</label>
                            <textarea asp-for="Class.Description" class="form-control" rows="4" placeholder="Nhập mô tả lớp học..."></textarea>
                            <span asp-validation-for="Class.Description" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Class.Status" class="form-label text-muted fw-bold">Trạng thái</label>
                                <select asp-for="Class.Status" class="form-select">
                                    <option value="Active">Active</option>
                                    <option value="Inactive">Inactive</option>
                                </select>
                                <span asp-validation-for="Class.Status" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Class.StartDate" class="form-label text-muted fw-bold">Ngày Bắt Đầu</label>
                                <input asp-for="Class.StartDate" class="form-control" type="date" />
                                <span asp-validation-for="Class.StartDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Class.EndDate" class="form-label text-muted fw-bold">Ngày Kết Thúc</label>
                                <input asp-for="Class.EndDate" class="form-control" type="date" />
                                <span asp-validation-for="Class.EndDate" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SlotName" class="form-label text-muted fw-bold">Slot Học</label>
                            <select asp-for="SlotName" class="form-select">
                                <option value="">-- Giữ nguyên lịch hiện tại --</option>
                                @foreach (var slot in Model.AvailableSlots)
                                {
                                    <option value="@slot.SlotName">@slot.DisplayName</option>
                                }
                            </select>
                            <span asp-validation-for="SlotName" class="text-danger"></span>
                            <div class="form-text">
                                @if (Model.ExistingScheduleCount > 0)
                                {
                                    <text>Lớp đang có <strong>@Model.ExistingScheduleCount</strong> buổi học. Nếu đổi giáo viên, khoảng ngày, hoặc slot thì toàn bộ lịch sẽ được <strong>sinh lại</strong> theo slot đang chọn.</text>
                                }
                                else
                                {
                                    <text>Lớp chưa có lịch học. Chọn slot để sinh lịch theo khoảng ngày bắt đầu — kết thúc.</text>
                                }
                            </div>
                            <div id="slotCheckResult" class="mt-2 small d-none"></div>
                        </div>

                        <div class="d-flex justify-content-end gap-3 mt-4 pt-3 border-top">
                            <a asp-page="./Index" class="btn btn-outline-secondary px-4 rounded-pill">Hủy</a>
                            <button type="submit" class="btn btn-primary px-4 rounded-pill shadow-sm" style="background-color: #1a73e8; border: none;">Lưu Thay Đổi</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const input = document.getElementById('managerDisplayInput');
            const hidden = document.getElementById('managerIdInput');
            const dropdown = document.getElementById('managerDropdown');
            const items = dropdown.querySelectorAll('.manager-option');

            function showDropdown() {
                dropdown.classList.add('show');
            }

            input.addEventListener('focus', showDropdown);
            input.addEventListener('click', showDropdown);

            input.addEventListener('keyup', function() {
                showDropdown();
                const filter = input.value.toLowerCase();
                let hasVisible = false;

                items.forEach(function(item) {
                    const text = item.textContent.toLowerCase();
                    if (text.includes(filter)) {
                        item.parentElement.style.display = '';
                        hasVisible = true;
                    } else {
                        item.parentElement.style.display = 'none';
                    }
                });

                if (!hasVisible) {
                    dropdown.classList.remove('show');
                }
            });

            items.forEach(function(item) {
                item.addEventListener('click', function(e) {
                    e.preventDefault();
                    input.value = item.textContent;
                    hidden.value = item.getAttribute('data-value');
                    dropdown.classList.remove('show');

                    items.forEach(i => i.parentElement.style.display = '');

                    // Báo cho phần kiểm tra trùng lịch biết giáo viên đã thay đổi
                    hidden.dispatchEvent(new Event('change'));
                });
            });

            document.addEventListener('click', function(e) {
                if (!input.contains(e.target) && !dropdown.contains(e.target)) {
                    dropdown.classList.remove('show');
                }
            });

            // ─── Kiểm tra trùng lịch giảng viên ngay trên form (AJAX) ───
            const classId = document.querySelector('[name="Class.Id"]').value;
            const slotSelect = document.getElementById('SlotName');
            const startInput = document.querySelector('[name="Class.StartDate"]');
            const endInput = document.querySelector('[name="Class.EndDate"]');
            const resultBox = document.getElementById('slotCheckResult');
            let checkToken = 0;

            function showResult(cssClass, text) {
                resultBox.className = 'mt-2 small ' + cssClass;
                resultBox.textContent = text;
            }

            async function checkSlot() {
                const managerId = hidden.value;
                const slotName = slotSelect.value;
                const startDate = startInput.value;
                const endDate = endInput.value;

                // Chưa đủ dữ liệu (hoặc chọn "giữ nguyên lịch") thì ẩn kết quả đi
                if (!managerId || !slotName || !startDate || !endDate) {
                    resultBox.className = 'mt-2 small d-none';
                    resultBox.textContent = '';
                    return;
                }

                const token = ++checkToken;
                showResult('text-muted', 'Đang kiểm tra lịch giảng viên...');

                try {
                    const url = '?handler=CheckSlot'
                        + '&classId=' + encodeURIComponent(classId)
                        + '&managerId=' + encodeURIComponent(managerId)
                        + '&startDate=' + encodeURIComponent(startDate)
                        + '&endDate=' + encodeURIComponent(endDate)
                        + '&slotName=' + encodeURIComponent(slotName);

                    const res = await fetch(url, { headers: { 'Accept': 'application/json' } });

                    // Bỏ qua nếu đã có request mới hơn được gửi đi
                    if (token !== checkToken) return;

                    if (!res.ok) {
                        resultBox.className = 'mt-2 small d-none';
                        return;
                    }

                    const data = await res.json();
                    if (token !== checkToken) return;

                    if (!data.message) {
                        resultBox.className = 'mt-2 small d-none';
                        resultBox.textContent = '';
                    } else if (data.ok) {
                        showResult('text-success fw-semibold', '✔ ' + data.message);
                    } else {
                        showResult('text-danger fw-semibold', '✘ ' + data.message);
                    }
                } catch {
                    if (token === checkToken) {
                        resultBox.className = 'mt-2 small d-none';
                    }
                }
            }

            [slotSelect, startInput, endInput, hidden].forEach(function(el) {
                if (el) el.addEventListener('change', checkSlot);
            });
        });
    </script>
}
