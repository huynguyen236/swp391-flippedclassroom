@page
@model Flipped_Classroom.Pages.Classrooms.IndexModel
@{
    ViewData["Title"] = "Classrooms";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <h2 class="fw-bold" style="color: #1a73e8;">Quản lý Lớp học</h2>
        <div class="d-flex gap-3">
            <form method="get" class="d-flex">
                <input type="text" name="SearchString" value="@Model.SearchString" class="form-control shadow-sm" style="border-radius: 8px 0 0 8px; border-right: none;" placeholder="Tìm theo tên..." />
                <button type="submit" class="btn btn-outline-primary shadow-sm" style="border-radius: 0 8px 8px 0; border-color: #ced4da; border-left: none; background: white; color: #1a73e8;">
                    <i class="bi bi-search"></i> Tìm
                </button>
            </form>
            <a asp-page="Create" class="btn btn-primary px-4 shadow-sm text-nowrap" style="background-color: #1a73e8; border: none; border-radius: 8px; display: flex; align-items: center;">
                + Tạo lớp mới
            </a>
        </div>
    </div>

    <div class="row g-4">
        @foreach (var item in Model.Class) {
            <div class="col-md-4 col-sm-6">
                <div class="card h-100 border-0 shadow-sm" style="border-radius: 15px; overflow: hidden; transition: 0.3s;">
                    <div class="card-header text-white p-4" style="background: linear-gradient(135deg, #1a73e8 0%, #4285f4 100%); border-bottom: none;">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h4 class="mb-0 text-truncate" title="@item.ClassName">@item.ClassName</h4>
                            <span class="badge bg-light text-primary rounded-pill px-3">@item.Status</span>
                        </div>
                        <p class="mb-0 text-white-50 small">Code: <strong>@item.InviteCode</strong></p>
                    </div>

                    <div class="card-body p-4">
                        <p class="card-text text-muted mb-4" style="min-height: 48px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                            @(string.IsNullOrEmpty(item.Description) ? "Chưa có mô tả..." : item.Description)
                        </p>

                        <div class="d-flex align-items-center mb-3">
                            <div class="rounded-circle d-flex justify-content-center align-items-center text-white me-2" style="width: 32px; height: 32px; font-size: 14px; background-color: #5f6368;">
                                @(item.Manager?.Username?.FirstOrDefault() ?? '?')
                            </div>
                            <span class="text-muted small"><strong>@item.Manager?.Username</strong></span>
                        </div>

                        <div class="d-flex text-muted small mt-2 justify-content-between">
                            <span><i class="bi bi-calendar3"></i> @item.StartDate?.ToString("dd/MM/yyyy")</span>
                            <span><i class="bi bi-calendar-check"></i> @item.EndDate?.ToString("dd/MM/yyyy")</span>
                        </div>  
                    </div>

                    <div class="card-footer bg-white border-0 px-4 pb-4 pt-0 d-flex flex-wrap gap-2">
                        <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm rounded-pill flex-grow-1">Chi tiết</a>
                        <button type="button" class="btn btn-outline-primary btn-sm rounded-pill send-email-btn" data-class-id="@item.Id" data-class-name="@item.ClassName" title="Gửi email thông báo">
                            <i class="bi bi-envelope"></i> Gửi Email
                        </button>
                        <a href="/Schedules/Details?classId=@item.Id" class="btn btn-outline-info btn-sm rounded-pill">
                            <i class="bi bi-calendar-week"></i> Lịch học
                        </a>
                        <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm rounded-pill">Sửa</a>
                        <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm rounded-pill">Xóa</a>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Class.Any())
    {
        <div class="text-center py-5">
            <div class="mb-3 text-muted">
                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="9" y1="3" x2="9" y2="21"></line>
                </svg>
            </div>
            <h5 class="text-muted">Chưa tìm thấy lớp học nào</h5>
            <p class="text-muted small">Vui lòng thay đổi từ khóa hoặc tạo lớp học mới.</p>
        </div>
    }
    else if (Model.TotalPages > 0)
    {
        <nav aria-label="Page navigation" class="mt-5">
            <ul class="pagination justify-content-center">
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link shadow-sm border-0 rounded-start-pill px-3" 
                       asp-page="./Index" 
                       asp-route-PageIndex="@(Model.PageIndex - 1)" 
                       asp-route-SearchString="@Model.SearchString">
                        Trước
                    </a>
                </li>

                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                        <a class="page-link shadow-sm border-0 @(i == Model.PageIndex ? "bg-primary text-white" : "text-primary")" 
                           style="@(i == Model.PageIndex ? "background-color: #1a73e8; border-color: #1a73e8;" : "background-color: white;")"
                           asp-page="./Index" 
                           asp-route-PageIndex="@i" 
                           asp-route-SearchString="@Model.SearchString">
                            @i
                        </a>
                    </li>
                }

                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link shadow-sm border-0 rounded-end-pill px-3" 
                       asp-page="./Index" 
                       asp-route-PageIndex="@(Model.PageIndex + 1)" 
                       asp-route-SearchString="@Model.SearchString">
                        Tiếp
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>

<!-- Email Notification Modal -->
<div class="modal fade" id="emailNotificationModal" tabindex="-1" aria-labelledby="emailNotificationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 12px; background: var(--color-surface-container);">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold d-flex align-items-center gap-2" id="emailNotificationModalLabel" style="color: var(--color-on-background);">
                    <span class="material-symbols-outlined text-primary">mail</span>
                    Gửi Email Thông Báo - <span id="modalClassName" class="text-primary"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <form id="emailNotificationForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="emailClassId" name="classId" />

                    <!-- Recipient Selection -->
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-uppercase tracking-wider text-muted">Người nhận</label>
                        <div class="d-flex gap-3 mb-2">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="recipientType" id="recipientAll" value="all" checked>
                                <label class="form-check-label fw-medium" for="recipientAll">
                                    Tất cả học viên
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="recipientType" id="recipientSelect" value="select">
                                <label class="form-check-label fw-medium" for="recipientSelect">
                                    Chọn học viên cụ thể
                                </label>
                            </div>
                        </div>

                        <!-- Student List (Hidden by default, shown when recipientSelect is active) -->
                        <div id="studentSelectionContainer" class="border rounded p-3 bg-light" style="display: none; max-height: 200px; overflow-y: auto;">
                            <div class="form-check mb-2 pb-2 border-bottom">
                                <input class="form-check-input" type="checkbox" id="selectAllStudents">
                                <label class="form-check-label fw-bold text-dark" for="selectAllStudents">
                                    Chọn tất cả
                                </label>
                            </div>
                            <div id="studentListContainer">
                                <!-- Populated via AJAX -->
                            </div>
                        </div>
                    </div>

                    <!-- Subject -->
                    <div class="mb-3">
                        <label for="emailSubject" class="form-label fw-bold small text-uppercase tracking-wider text-muted">Tiêu đề (Subject)</label>
                        <input type="text" class="form-control rounded-3" id="emailSubject" name="subject" placeholder="Nhập tiêu đề thông báo..." required>
                    </div>

                    <!-- Body -->
                    <div class="mb-3">
                        <label for="emailBody" class="form-label fw-bold small text-uppercase tracking-wider text-muted">Nội dung thông báo (Body)</label>
                        <textarea class="form-control rounded-3" id="emailBody" name="body" rows="6" placeholder="Nhập nội dung chi tiết..." required></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-top-0 pt-0">
                <button type="button" class="btn btn-premium-outline" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-premium-primary" id="btnSendEmail">
                    <span class="d-flex align-items-center gap-1">
                        <span class="material-symbols-outlined" style="font-size: 18px;">send</span> Gửi Email
                    </span>
                </button>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const modal = new bootstrap.Modal(document.getElementById('emailNotificationModal'));
        const modalClassName = document.getElementById('modalClassName');
        const emailClassId = document.getElementById('emailClassId');
        const studentSelectionContainer = document.getElementById('studentSelectionContainer');
        const studentListContainer = document.getElementById('studentListContainer');
        const selectAllStudents = document.getElementById('selectAllStudents');
        const btnSendEmail = document.getElementById('btnSendEmail');
        const form = document.getElementById('emailNotificationForm');

        // Toggle recipient selector list
        document.querySelectorAll('input[name="recipientType"]').forEach(radio => {
            radio.addEventListener('change', function () {
                if (this.value === 'select') {
                    studentSelectionContainer.style.display = 'block';
                } else {
                    studentSelectionContainer.style.display = 'none';
                }
            });
        });

        // Select/Deselect all students checkbox
        selectAllStudents.addEventListener('change', function () {
            document.querySelectorAll('.student-checkbox').forEach(cb => {
                cb.checked = this.checked;
            });
        });

        // Click "Gửi Email" button on card
        document.querySelectorAll('.send-email-btn').forEach(btn => {
            btn.addEventListener('click', async function () {
                const classId = this.dataset.classId;
                const className = this.dataset.className;

                modalClassName.textContent = className;
                emailClassId.value = classId;
                studentListContainer.innerHTML = '<div class="text-center py-2"><span class="spinner-border spinner-border-sm text-primary"></span> Đang tải...</div>';
                
                // Reset form fields
                document.getElementById('emailSubject').value = '';
                document.getElementById('emailBody').value = '';
                document.getElementById('recipientAll').checked = true;
                studentSelectionContainer.style.display = 'none';
                selectAllStudents.checked = false;

                modal.show();

                try {
                    const res = await fetch(`/Classrooms/Index?handler=ClassMembers&classId=${classId}`);
                    if (!res.ok) throw new Error('HTTP ' + res.status);
                    const students = await res.json();
                    
                    studentListContainer.innerHTML = '';
                    if (!students || students.length === 0) {
                        studentListContainer.innerHTML = '<p class="text-muted small mb-0">Không có học viên nào trong lớp.</p>';
                    } else {
                        students.forEach(student => {
                            const div = document.createElement('div');
                            div.className = 'form-check py-1';
                            div.innerHTML = `
                                <input class="form-check-input student-checkbox" type="checkbox" value="${student.id}" id="student-${student.id}">
                                <label class="form-check-label text-dark" for="student-${student.id}">
                                    ${student.username} (${student.email || 'N/A'})
                                </label>
                            `;
                            studentListContainer.appendChild(div);
                        });
                        
                        // Bind change events to student checkboxes to sync "Select All" status
                        document.querySelectorAll('.student-checkbox').forEach(cb => {
                            cb.addEventListener('change', function () {
                                const allCbs = document.querySelectorAll('.student-checkbox');
                                const checkedCbs = document.querySelectorAll('.student-checkbox:checked');
                                selectAllStudents.checked = allCbs.length === checkedCbs.length;
                            });
                        });
                    }
                } catch (err) {
                    studentListContainer.innerHTML = '<p class="text-danger small mb-0">Lỗi khi tải danh sách học viên.</p>';
                }
            });
        });

        // Click "Gửi" button inside modal
        btnSendEmail.addEventListener('click', async function () {
            const classId = emailClassId.value;
            const subject = document.getElementById('emailSubject').value.trim();
            const body = document.getElementById('emailBody').value.trim();
            const isSelect = document.getElementById('recipientSelect').checked;

            if (!subject || !body) {
                alert('Vui lòng điền đầy đủ tiêu đề và nội dung.');
                return;
            }

            const selectedStudentIds = [];
            if (isSelect) {
                document.querySelectorAll('.student-checkbox:checked').forEach(cb => {
                    selectedStudentIds.push(parseInt(cb.value));
                });
                if (selectedStudentIds.length === 0) {
                    alert('Vui lòng chọn ít nhất một học viên.');
                    return;
                }
            }

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            
            const originalHtml = btnSendEmail.innerHTML;
            btnSendEmail.disabled = true;
            btnSendEmail.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Đang gửi...';

            try {
                const formData = new FormData();
                formData.append('classId', classId);
                formData.append('subject', subject);
                formData.append('body', body);
                selectedStudentIds.forEach(id => {
                    formData.append('selectedStudentIds', id);
                });
                formData.append('__RequestVerificationToken', token);

                const res = await fetch('/Classrooms/Index?handler=SendNotification', {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token
                    },
                    body: formData
                });

                if (!res.ok) throw new Error('HTTP ' + res.status);
                const data = await res.json();
                
                if (data.success) {
                    alert(data.message || 'Gửi email thành công!');
                    modal.hide();
                } else {
                    alert('Gửi email thất bại: ' + (data.message || 'Lỗi không xác định'));
                }
            } catch (err) {
                alert('Có lỗi xảy ra: ' + err.message);
            } finally {
                btnSendEmail.disabled = false;
                btnSendEmail.innerHTML = originalHtml;
            }
        });
    });
</script>
