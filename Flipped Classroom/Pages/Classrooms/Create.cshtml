                </div>

                <div class="card-body p-5">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Class.ClassName" class="form-label text-muted fw-bold">Tên L?p H?c</label>
                            <input asp-for="Class.ClassName" class="form-control" placeholder="Nh?p tên l?p h?c..." />
                            <span asp-validation-for="Class.ClassName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Class.InviteCode" class="form-label text-muted fw-bold">Mã Tham Gia</label>
                            <input asp-for="Class.InviteCode" class="form-control" placeholder="Mã m?i..." />
                            <span asp-validation-for="Class.InviteCode" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Class.ManagerId" class="form-label text-muted fw-bold">Ng??i Qu?n Lý</label>
                            <select asp-for="Class.ManagerId" class="form-select" asp-items="ViewBag.ManagerId"></select>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Class.Description" class="form-label text-muted fw-bold">Mô t?</label>
                            <textarea asp-for="Class.Description" class="form-control" rows="4" placeholder="Nh?p mô t? l?p h?c..."></textarea>
                            <span asp-validation-for="Class.Description" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Class.StartDate" class="form-label text-muted fw-bold">Ngày B?t ??u</label>
                                <input asp-for="Class.StartDate" class="form-control" type="date" />
                                <span asp-validation-for="Class.StartDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Class.EndDate" class="form-label text-muted fw-bold">Ngày K?t Thúc</label>
                                <input asp-for="Class.EndDate" class="form-control" type="date" />
                                <span asp-validation-for="Class.EndDate" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-3 mt-4 pt-3 border-top">
                            <a asp-page="Index" class="btn btn-outline-secondary px-4 rounded-pill">H?y</a>
                            <button type="submit" class="btn btn-primary px-4 rounded-pill shadow-sm" style="background-color: #1a73e8; border: none;">T?o L?p H?c</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
