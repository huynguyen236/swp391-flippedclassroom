@page
@model Flipped_Classroom.Pages.Classrooms.DetailsModel

@{
    ViewData["Title"] = "Classroom Details";
}

<style>
    .sticky-menu {
        background: white;
    }

    .tab-content .tab-pane {
        display: none;
    }

    .tab-content .tab-pane.active {
        display: block;
    }

    /* Custom styles for active tab underline */
    .nav-tabs .nav-link.active {
        color: #1a73e8;
        border: none;
        border-bottom: 3px solid #1a73e8;
    }

    .nav-tabs .nav-link {
        border: none;
        color: #5f6368;
        transition: all 0.3s ease;
    }

    .nav-tabs .nav-link:hover {
        color: #1a73e8;
    }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <!-- Class Header -->
            <div class="card border-0 shadow-sm mb-4" style="border-radius: 15px; overflow: hidden;">
                <div class="card-header text-white p-5 text-center" style="background: linear-gradient(135deg, #1a73e8 0%, #4285f4 100%);">
                    <h2 class="fw-bold mb-2">@Html.DisplayFor(model => model.Class.ClassName)</h2>
                    <span class="badge bg-light text-primary rounded-pill px-4 py-2 fs-6 mb-3">@Html.DisplayFor(model => model.Class.Status)</span>
                    <p class="mb-0 text-white-50">Mã Tham Gia (Invite Code): <strong class="text-white fs-5">@Html.DisplayFor(model => model.Class.InviteCode)</strong></p>
                </div>

                <div class="card-body p-5">
                </div>

                <div class="card-footer bg-light p-4 text-center border-0 d-flex justify-content-center gap-3">
                    <a asp-page="./Index" class="btn btn-outline-secondary px-4 rounded-pill">Trở lại Danh sách</a>
                    <a href="/Schedules/Details?classId=@Model.Class?.Id" class="btn btn-info px-4 rounded-pill shadow-sm text-white" style="border: none;">
                        <i class="bi bi-calendar-week me-1"></i>Xem lịch học
                    </a>
                    <a asp-page="./Edit" asp-route-id="@Model.Class?.Id" class="btn btn-primary px-4 rounded-pill shadow-sm" style="background-color: #1a73e8; border: none;">Chỉnh sửa</a>
                </div>
            </div>

            <!-- Sticky Menu and Description -->
            <div class="sticky-menu mb-4">
                <div class="card border-0 shadow-sm" style="border-radius: 15px; overflow: hidden;">
                    <div class="card-header bg-white p-4 border-bottom">
                        <div class="mb-4">
                            <h5 class="fw-bold text-muted mb-3">Mô tả Lớp Học</h5>
                            <p class="text-secondary" style="line-height: 1.6; margin: 0;">
                                @(string.IsNullOrEmpty(Model.Class.Description) ? "Chưa có mô tả cho lớp học này." : Model.Class.Description)
                            </p>
                        </div>

                        <!-- Date and Manager Info -->
                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <div class="d-flex align-items-center p-3 rounded" style="background-color: #f8f9fa;">
                                    <div class="me-3 text-primary">
                                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                                    </div>
                                    <div>
                                        <div class="text-muted small">Ngày Bắt Đầu</div>
                                        <div class="fw-medium">@Html.DisplayFor(model => model.Class.StartDate)</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="d-flex align-items-center p-3 rounded" style="background-color: #f8f9fa;">
                                    <div class="me-3 text-primary">
                                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                                    </div>
                                    <div>
                                        <div class="text-muted small">Ngày Kết Thúc</div>
                                        <div class="fw-medium">@Html.DisplayFor(model => model.Class.EndDate)</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <div class="d-flex align-items-center">
                                <div class="rounded-circle d-flex justify-content-center align-items-center text-white me-3" style="width: 40px; height: 40px; font-size: 16px; background-color: #5f6368;">
                                    @(Model.Class.Manager?.Username?.FirstOrDefault() ?? '?')
                                </div>
                                <div>
                                    <div class="text-muted small">Người Quản Lý</div>
                                    <div class="fw-bold small">@Html.DisplayFor(model => model.Class.Manager.Username)</div>
                                </div>
                            </div>
                            <div class="text-end text-muted" style="font-size: 0.85rem;">
                                Tạo: @Html.DisplayFor(model => model.Class.CreatedAt)
                            </div>
                        </div>

                        <!-- Tabs Navigation -->
                        <ul class="nav nav-tabs border-0 mt-4" id="classroomTabs" role="tablist" style="gap: 1rem;">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active fw-bold" id="qa-tab" data-bs-toggle="tab" data-bs-target="#qa-content" type="button" role="tab" aria-controls="qa-content" aria-selected="true" style="color: #1a73e8; border: none; border-bottom: 3px solid #1a73e8;">
                                    <i class="bi bi-question-circle"></i> Q&A
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link fw-bold" id="students-tab" data-bs-toggle="tab" data-bs-target="#students-content" type="button" role="tab" aria-controls="students-content" aria-selected="false" style="color: #5f6368; border: none; transition: all 0.3s ease;">
                                    <i class="bi bi-people-fill"></i> Học Viên (@(Model.Class.ClassMembers?.Count ?? 0))
                                </button>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Tab Content -->
            <div class="tab-content" id="classroomTabContent">
                <!-- Q&A Tab -->
                <div class="tab-pane fade show active" id="qa-content" role="tabpanel" aria-labelledby="qa-tab">
                    <div class="card border-0 shadow-sm" style="border-radius: 15px; overflow: hidden;">
                        <div class="card-body p-5 text-center text-muted">
                            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mb-3 opacity-50"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg>
                            <h6 class="text-muted">Q&A sẽ sớm được cập nhật</h6>
                        </div>
                    </div>
                </div>

                <!-- Students Tab -->
                <div class="tab-pane fade" id="students-content" role="tabpanel" aria-labelledby="students-tab">
                    <div class="card border-0 shadow-sm" style="border-radius: 15px; overflow: hidden;">
                        <div class="card-header bg-white p-4 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-3">
                            <h4 class="fw-bold mb-0" style="color: #1a73e8;">Danh Sách Học Viên</h4>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-outline-primary px-4 shadow-sm text-nowrap" style="border-radius: 8px;" data-bs-toggle="modal" data-bs-target="#createGroupModal">
                                    <i class="bi bi-people-fill"></i> Chia Nhóm (@(Model.Class.Groups?.Count ?? 0))
                                </button>
                                <button type="button" class="btn btn-primary px-4 shadow-sm text-nowrap" style="background-color: #1a73e8; border: none; border-radius: 8px;" data-bs-toggle="modal" data-bs-target="#addStudentModal">
                                    + Thêm Học Viên
                                </button>
                            </div>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="bg-light text-muted">
                                        <tr>
                                            <th class="px-4 py-3 border-0 fw-semibold">Học Viên</th>
                                            <th class="px-4 py-3 border-0 fw-semibold">Email</th>
                                            <th class="px-4 py-3 border-0 fw-semibold">Nhóm</th>
                                            <th class="px-4 py-3 border-0 fw-semibold text-center">Support Team</th>
                                            <th class="px-4 py-3 border-0 fw-semibold text-end">Thao Tác</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.Class.ClassMembers != null && Model.Class.ClassMembers.Any())
                                        {
                                            foreach (var member in Model.Class.ClassMembers)
                                            {
                                                <tr class="align-middle">
                                                    <td class="px-4 py-3">
                                                        <div class="d-flex align-items-center">
                                                            <div class="rounded-circle d-flex justify-content-center align-items-center text-white me-3" style="width: 35px; height: 35px; font-size: 14px; background-color: #4285f4;">
                                                                @(member.User?.Username?.FirstOrDefault() ?? '?')
                                                            </div>
                                                            <div class="fw-medium text-dark">@(member.User?.Username ?? "Unknown")</div>
                                                        </div>
                                                    </td>
                                                    <td class="px-4 py-3 text-secondary">@(member.User?.Email ?? "-")</td>
                                                    <td class="px-4 py-3">
                                                        @{
                                                            var assignedGroup = Model.Class.Groups?.FirstOrDefault(g => g.GroupMembers.Any(gm => gm.StudentId == member.UserId));
                                                        }
                                                        <form method="post" asp-page-handler="AssignGroup" asp-route-id="@Model.Class.Id">
                                                            <input type="hidden" name="studentId" value="@member.UserId" />
                                                            <select name="groupId" class="form-select form-select-sm shadow-sm" style="border-radius: 6px;" onchange="this.form.submit()">
                                                                <option value="">Chưa có nhóm</option>
                                                                @if (Model.Class.Groups != null)
                                                                {
                                                                    foreach (var group in Model.Class.Groups)
                                                                    {
                                                                        if (assignedGroup?.Id == group.Id)
                                                                        {
                                                                            <option value="@group.Id" selected>@group.GroupName</option>
                                                                        }
                                                                        else
                                                                        {
                                                                            <option value="@group.Id">@group.GroupName</option>
                                                                        }
                                                                    }
                                                                }
                                                            </select>
                                                        </form>
                                                    </td>
                                                    <td class="px-4 py-3 text-center">
                                                        @if (member.IsSupportTeam == true)
                                                        {
                                                            <span class="badge bg-success rounded-pill px-3">Có</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-secondary rounded-pill px-3">Không</span>
                                                        }
                                                    </td>
                                                    <td class="px-4 py-3 text-end">
                                                        <form method="post" asp-page-handler="RemoveStudent" asp-route-id="@Model.Class.Id">
                                                            <input type="hidden" name="memberUserId" value="@member.UserId" />
                                                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3" onclick="return confirm('Bạn có chắc chắn muốn xóa @(member.User?.Username) khỏi lớp?');">Xóa</button>
                                                        </form>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="5" class="text-center py-5 text-muted">
                                                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mb-3 opacity-50"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                                                    <h6 class="text-muted">Chưa có học viên nào trong lớp</h6>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Student Modal -->
<div class="modal fade" id="addStudentModal" tabindex="-1" aria-labelledby="addStudentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow" style="border-radius: 15px;">
            <form method="post" asp-page-handler="AddStudents" asp-route-id="@Model.Class.Id">
                <div class="modal-header border-bottom-0 pb-0 pt-4 px-4">
                    <h5 class="modal-title fw-bold text-primary" id="addStudentModalLabel">Thêm Học Viên Mới</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-muted small mb-3">Chọn các học viên bạn muốn thêm vào lớp học này:</p>
                    @if (Model.AvailableUsers != null && Model.AvailableUsers.Any())
                    {
                        <div class="mb-3 position-relative">
                            <input type="text" class="form-control" id="studentSearchInput" placeholder="Tìm kiếm học viên..." autocomplete="off" style="border-radius: 8px; border-color: #ced4da; background-image: url('data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 16 16%22><path fill=%22none%22 stroke=%22%23343a40%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22 stroke-width=%222%22 d=%22M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z%22/></svg>'); background-repeat: no-repeat; background-position: right .75rem center; background-size: 16px 16px; padding-right: 2.5rem;" />
                        </div>
                        <div class="list-group list-group-flush border rounded" id="studentListGroup" style="max-height: 350px; overflow-y: auto;">
                            @foreach (var user in Model.AvailableUsers)
                            {
                                <label class="list-group-item d-flex gap-3 align-items-center p-3 list-group-item-action student-option" style="cursor: pointer;">
                                    <input class="form-check-input flex-shrink-0" type="checkbox" name="SelectedStudentIds" value="@user.Id" style="font-size: 1.2em;">
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle d-flex justify-content-center align-items-center text-white me-3" style="width: 32px; height: 32px; font-size: 14px; background-color: #5f6368;">
                                            @(user.Username?.FirstOrDefault() ?? '?')
                                        </div>
                                        <div>
                                            <h6 class="mb-0 fw-medium">@user.Username</h6>
                                            @if (!string.IsNullOrEmpty(user.Email))
                                            {
                                                <small class="text-muted">@user.Email</small>
                                            }
                                        </div>
                                    </div>
                                </label>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 bg-light rounded">
                            <p class="text-muted mb-0">Không có học viên nào khả dụng ?? thêm.</p>
                        </div>
                    }
                </div>
                <div class="modal-footer border-top-0 pt-0 pb-4 px-4 gap-2">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm" style="background-color: #1a73e8; border: none;">Xác Nhận Thêm</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Create Group Modal -->
<div class="modal fade" id="createGroupModal" tabindex="-1" aria-labelledby="createGroupModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius: 15px;">
            <form method="post" asp-page-handler="CreateGroups" asp-route-id="@Model.Class.Id">
                <div class="modal-header border-bottom-0 pb-0 pt-4 px-4">
                    <h5 class="modal-title fw-bold text-primary" id="createGroupModalLabel">Tạo Nhóm Mới</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-4">
                        <label class="form-label fw-bold text-dark">Danh Sách Học Viên Hiện Tại (@(Model.Class.ClassMembers?.Count ?? 0))</label>
                        <div class="list-group list-group-flush border rounded" style="max-height: 200px; overflow-y: auto;">
                            @if (Model.Class.ClassMembers != null && Model.Class.ClassMembers.Any())
                            {
                                foreach (var member in Model.Class.ClassMembers)
                                {
                                    <div class="list-group-item d-flex align-items-center gap-3 px-3 py-2 bg-light">
                                        <div class="rounded-circle d-flex justify-content-center align-items-center text-white" style="width: 30px; height: 30px; font-size: 13px; background-color: #4285f4;">
                                            @(member.User?.Username?.FirstOrDefault() ?? '?')
                                        </div>
                                        <div class="d-flex flex-column">
                                            <span class="fw-medium small text-dark mb-0" style="line-height:1.2;">@member.User?.Username</span>
                                            @if (!string.IsNullOrEmpty(member.User?.Email))
                                            {
                                                <span class="text-muted" style="font-size: 0.75rem; line-height:1.2;">@member.User.Email</span>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="p-3 text-center text-muted small">Chưa có học viên nào đã chia nhóm.</div>
                            }
                        </div>
                    </div>

                    <p class="text-muted small mb-3">Nhập số lượng nhóm bạn muốn tạo cho lớp học này:</p>
                    <div class="mb-3">
                        <label for="NumberOfGroupsToCreate" class="form-label fw-medium">Số lượng nhóm</label>
                        <input type="number" asp-for="NumberOfGroupsToCreate" class="form-control shadow-sm" min="1" max="6" required style="border-radius: 8px; border-color: #ced4da;" />
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0 pb-4 px-4 gap-2">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm" style="background-color: #1a73e8; border: none;">Xác Nhận Tạo</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const studentSearchInput = document.getElementById('studentSearchInput');
            if (studentSearchInput) {
                studentSearchInput.addEventListener('keyup', function() {
                    const filter = this.value.toLowerCase();
                    const options = document.querySelectorAll('.student-option');

                    options.forEach(function(item) {
                        const text = item.textContent.toLowerCase();
                        if (text.includes(filter)) {
                            item.classList.remove('d-none');
                            item.classList.add('d-flex');
                        } else {
                            item.classList.remove('d-flex');
                            item.classList.add('d-none');
                        }
                    });
                });
            }

            // Tab persistence functionality
            const tabButtons = document.querySelectorAll('[data-bs-toggle="tab"]');
            const activeTabKey = 'classroomActiveTab_' + window.location.pathname;

            // Restore active tab on page load
            const savedTab = localStorage.getItem(activeTabKey);
            if (savedTab) {
                const tabButton = document.getElementById(savedTab);
                if (tabButton) {
                    const tab = new bootstrap.Tab(tabButton);
                    tab.show();
                }
            }

            // Save active tab when changed
            tabButtons.forEach(button => {
                button.addEventListener('shown.bs.tab', function(e) {
                    localStorage.setItem(activeTabKey, this.id);
                    
                    // Update underline styling
                    tabButtons.forEach(btn => {
                        if (btn.id === 'qa-tab') {
                            if (btn.classList.contains('active')) {
                                btn.style.color = '#1a73e8';
                                btn.style.borderBottom = '3px solid #1a73e8';
                            } else {
                                btn.style.color = '#5f6368';
                                btn.style.borderBottom = 'none';
                            }
                        } else if (btn.id === 'students-tab') {
                            if (btn.classList.contains('active')) {
                                btn.style.color = '#1a73e8';
                                btn.style.borderBottom = '3px solid #1a73e8';
                            } else {
                                btn.style.color = '#5f6368';
                                btn.style.borderBottom = 'none';
                            }
                        }
                    });
                });
            });
        });
    </script>
}
