@page
@model Flipped_Classroom.Pages.Classrooms.DetailsModel

@{
    ViewData["Title"] = "Classroom Details";
}

<div class="container py-5 manager-details-container">
    <div class="row justify-content-center">
        <div class="col-lg-12">
            
            <!-- Breadcrumbs and Action Buttons -->
            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                <!-- Breadcrumbs -->
                <div class="d-flex align-items-center gap-2 text-secondary small mb-0">
                    <a asp-page="./Index" class="text-secondary text-decoration-none hover-text-primary">Quản lý lớp học</a>
                    <span class="material-symbols-outlined" style="font-size:16px;">chevron_right</span>
                    <span class="text-dark fw-medium">Chi tiết lớp học</span>
                </div>
                
                <!-- Action Links -->
                <div class="d-flex gap-2">
                    <a asp-page="./Index" class="btn btn-premium-outline rounded-pill px-3 py-1.5 d-inline-flex align-items-center gap-1.5" style="font-size: 0.85rem;">
                        <span class="material-symbols-outlined text-[18px]">arrow_back</span> Trở lại
                    </a>
                    <a href="/Schedules/Details?classId=@Model.Class?.Id" class="btn btn-premium-outline rounded-pill px-3 py-1.5 d-inline-flex align-items-center gap-1.5" style="font-size: 0.85rem;">
                        <span class="material-symbols-outlined text-[18px]">calendar_month</span> Lịch học
                    </a>
                    <a asp-page="./Edit" asp-route-id="@Model.Class?.Id" class="btn btn-premium-primary rounded-pill px-3 py-1.5 d-inline-flex align-items-center gap-1.5" style="font-size: 0.85rem;">
                        <span class="material-symbols-outlined text-[18px]">edit</span> Chỉnh sửa
                    </a>
                </div>
            </div>

            <!-- Hero Class Header Section -->
            <div class="hero-header-banner p-4 p-md-5 mb-4 rounded-3 d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-4">
                <div class="hero-header-decor"></div>
                <div class="relative z-1">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge bg-white text-primary rounded-pill px-3 py-1.5 shadow-sm small fw-bold">@Html.DisplayFor(model => model.Class.Status)</span>
                    </div>
                    <h2 class="fw-bold mb-2 text-white" style="font-size: 2rem;">@Html.DisplayFor(model => model.Class.ClassName)</h2>
                    <p class="mb-0 text-white-50" style="max-width: 600px;">
                        @(string.IsNullOrEmpty(Model.Class.Description) ? "Chưa có mô tả cho lớp học này." : Model.Class.Description)
                    </p>
                </div>
                <div class="glass-card-premium shrink-0 relative z-1">
                    <span class="text-white-50 small text-uppercase tracking-wider">Mã Tham Gia</span>
                    <div class="d-flex align-items-center justify-content-center gap-2 bg-white text-dark px-3 py-2 rounded-2 mt-2 border">
                        <strong class="font-monospace text-primary" style="font-size: 1.15rem; letter-spacing: 0.5px;">@Html.DisplayFor(model => model.Class.InviteCode)</strong>
                        <button class="btn p-0 text-secondary hover-text-primary d-flex align-items-center justify-content-center" onclick="copyInviteCodeDetails(this, '@Model.Class.InviteCode')" title="Copy mã">
                            <span class="material-symbols-outlined" style="font-size: 18px;">content_copy</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Date and Manager Info Card -->
            <div class="card card-premium p-4 mb-4">
                <div class="row g-3 align-items-center">
                    <div class="col-md-4">
                        <div class="d-flex align-items-center p-3 rounded" style="background-color: var(--color-surface-container-low);">
                            <span class="material-symbols-outlined text-primary fs-3 me-3">calendar_today</span>
                            <div>
                                <div class="text-muted small">Ngày Bắt Đầu</div>
                                <div class="fw-bold text-dark">@Model.Class.StartDate?.ToString("dd/MM/yyyy")</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="d-flex align-items-center p-3 rounded" style="background-color: var(--color-surface-container-low);">
                            <span class="material-symbols-outlined text-primary fs-3 me-3">event</span>
                            <div>
                                <div class="text-muted small">Ngày Kết Thúc</div>
                                <div class="fw-bold text-dark">@Model.Class.EndDate?.ToString("dd/MM/yyyy")</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="d-flex align-items-center p-3 rounded" style="background-color: var(--color-surface-container-low);">
                            @{
                                var managerInitials = Model.Class.Manager?.Username?.FirstOrDefault() ?? '?';
                            }
                            <div class="avatar-initials-circle bg-primary me-3 text-white">
                                @managerInitials
                            </div>
                            <div>
                                <div class="text-muted small">Người Quản Lý</div>
                                <div class="fw-bold text-dark">@Html.DisplayFor(model => model.Class.Manager.Username)</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sticky Menu Tabs Navigation -->
            <ul class="nav nav-tabs nav-tabs-premium mb-4" id="classroomTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="students-tab" data-bs-toggle="tab" data-bs-target="#students-content" type="button" role="tab" aria-controls="students-content" aria-selected="true">
                        <span class="material-symbols-outlined">group</span> Học Viên (@(Model.Class.ClassMembers?.Count ?? 0))
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="qa-tab" data-bs-toggle="tab" data-bs-target="#qa-content" type="button" role="tab" aria-controls="qa-content" aria-selected="false">
                        <span class="material-symbols-outlined">forum</span> Hỏi & Đáp Lớp Học
                    </button>
                </li>
            </ul>

            <!-- Tab Content -->
            <div class="tab-content" id="classroomTabContent">
                <!-- Students Tab -->
                <div class="tab-pane fade show active" id="students-content" role="tabpanel" aria-labelledby="students-tab">
                    <div class="card card-premium">
                        <div class="card-premium-header d-flex justify-content-between align-items-center flex-wrap gap-3">
                            <h4 class="fw-bold mb-0 text-primary d-flex align-items-center gap-2">
                                <span class="material-symbols-outlined">group</span> Danh Sách Học Viên
                            </h4>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-premium-outline px-3 send-email-btn shadow-sm text-nowrap" data-class-id="@Model.Class.Id" data-class-name="@Model.Class.ClassName">
                                    <span class="material-symbols-outlined text-[20px] align-middle me-1">mail</span> Gửi Email
                                </button>
                                <button type="button" class="btn btn-premium-outline px-3 shadow-sm text-nowrap" data-bs-toggle="modal" data-bs-target="#createGroupModal">
                                    <span class="material-symbols-outlined text-[20px] align-middle me-1">groups</span> Chia Nhóm (@(Model.Class.Groups?.Count ?? 0))
                                </button>
                                <button type="button" class="btn btn-premium-primary px-3 shadow-sm text-nowrap" data-bs-toggle="modal" data-bs-target="#addStudentModal">
                                    <span class="material-symbols-outlined text-[20px] align-middle me-1">person_add</span> Thêm Học Viên
                                </button>
                            </div>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table align-middle table-hover mb-0">
                                    <thead class="bg-light text-muted uppercase">
                                        <tr>
                                            <th class="ps-4 py-3" style="width: 250px;">Học Viên</th>
                                            <th class="py-3">Email</th>
                                            <th class="py-3" style="width: 200px;">Nhóm</th>
                                            <th class="text-center py-3" style="width: 150px;">Support Team</th>
                                            <th class="pe-4 text-end py-3" style="width: 150px;">Thao Tác</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y">
                                        @if (Model.Class.ClassMembers != null && Model.Class.ClassMembers.Any())
                                        {
                                            var colors = new[] { "avatar-bg-blue", "avatar-bg-pink", "avatar-bg-purple" };
                                            foreach (var member in Model.Class.ClassMembers)
                                            {
                                                var colorClass = colors[member.UserId % colors.Length];
                                                <tr class="align-middle">
                                                    <td class="ps-4 py-3">
                                                        <div class="d-flex align-items-center">
                                                            <div class="avatar-initials-circle @colorClass me-3 text-white">
                                                                @(member.User?.Username?.FirstOrDefault() ?? '?')
                                                            </div>
                                                            <div class="fw-semibold text-dark">@(member.User?.Username ?? "Unknown")</div>
                                                        </div>
                                                    </td>
                                                    <td class="py-3 text-secondary">@(member.User?.Email ?? "-")</td>
                                                    <td class="py-3">
                                                        @{
                                                            var assignedGroup = Model.Class.Groups?.FirstOrDefault(g => g.GroupMembers.Any(gm => gm.StudentId == member.UserId));
                                                        }
                                                        <form method="post" asp-page-handler="AssignGroup" asp-route-id="@Model.Class.Id" class="m-0">
                                                            <input type="hidden" name="studentId" value="@member.UserId" />
                                                            <select name="groupId" class="form-select form-select-sm shadow-sm" style="border-radius: 8px; max-width: 180px;" onchange="this.form.submit()">
                                                                <option value="">Chưa có nhóm</option>
                                                                @if (Model.Class.Groups != null)
                                                                {
                                                                    foreach (var group in Model.Class.Groups)
                                                                    {
                                                                        if (assignedGroup?.Id == group.Id)
                                                                        {
                                                                            <option value="@group.Id" selected>@group.GroupName</option>
                                                                        }
                                                                        else
                                                                        {
                                                                            <option value="@group.Id">@group.GroupName</option>
                                                                        }
                                                                    }
                                                                }
                                                            </select>
                                                        </form>
                                                    </td>
                                                    <td class="text-center py-3">
                                                        @if (member.IsSupportTeam == true)
                                                        {
                                                            <span class="badge bg-success bg-opacity-10 text-success px-3 py-1.5 rounded-pill" style="font-size: 11px;">Có</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-secondary bg-opacity-10 text-secondary px-3 py-1.5 rounded-pill" style="font-size: 11px;">Không</span>
                                                        }
                                                    </td>
                                                    <td class="pe-4 text-end py-3">
                                                        <form method="post" asp-page-handler="RemoveStudent" asp-route-id="@Model.Class.Id" class="m-0">
                                                            <input type="hidden" name="memberUserId" value="@member.UserId" />
                                                            <button type="submit" class="btn btn-premium-danger-outline btn-sm d-inline-flex align-items-center" onclick="return confirm('Bạn có chắc chắn muốn xóa @(member.User?.Username) khỏi lớp?');">
                                                                <span class="material-symbols-outlined text-[16px] me-1">delete</span> Xóa
                                                            </button>
                                                        </form>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="5" class="text-center py-5">
                                                    <div class="d-flex flex-column align-items-center justify-content-center py-4 text-muted">
                                                        <span class="material-symbols-outlined text-muted fs-1 mb-2 opacity-50">group_off</span>
                                                        <h6 class="text-muted fw-bold">Chưa có học viên nào trong lớp</h6>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Q&A Tab -->
                <div class="tab-pane fade" id="qa-content" role="tabpanel" aria-labelledby="qa-tab">
                    <div class="card card-premium">
                        <div class="card-premium-header">
                            <h4 class="fw-bold mb-0 text-primary d-flex align-items-center gap-2">
                                <span class="material-symbols-outlined">forum</span> Hỏi & Đáp Lớp Học
                            </h4>
                        </div>
                        <div class="card-body p-5 text-center text-muted">
                            <span class="material-symbols-outlined text-muted mb-3 opacity-50" style="font-size: 64px;">forum</span>
                            <h6 class="text-muted fw-bold">Q&A sẽ sớm được cập nhật</h6>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Student Modal -->
<div class="modal fade" id="addStudentModal" tabindex="-1" aria-labelledby="addStudentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow" style="border-radius: 24px;">
            <form method="post" asp-page-handler="AddStudents" asp-route-id="@Model.Class.Id">
                <div class="modal-header border-bottom-0 pb-0 pt-4 px-4">
                    <h5 class="modal-title fw-bold text-primary d-flex align-items-center gap-1.5" id="addStudentModalLabel">
                        <span class="material-symbols-outlined">person_add</span> Thêm Học Viên Mới
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-muted small mb-3">Chọn các học viên bạn muốn thêm vào lớp học này:</p>
                    @if (Model.AvailableUsers != null && Model.AvailableUsers.Any())
                    {
                        <div class="mb-3 position-relative">
                            <input type="text" class="form-control" id="studentSearchInput" placeholder="Tìm kiếm học viên..." autocomplete="off" style="border-radius: 12px; border-color: var(--color-outline-variant); background-image: url('data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 16 16%22><path fill=%22none%22 stroke=%22%23737686%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22 stroke-width=%222%22 d=%22M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z%22/></svg>'); background-repeat: no-repeat; background-position: right .75rem center; background-size: 16px 16px; padding-right: 2.5rem;" />
                        </div>
                        <div class="list-group list-group-flush border rounded-3" id="studentListGroup" style="max-height: 350px; overflow-y: auto;">
                            @{
                                var modalColors = new[] { "avatar-bg-blue", "avatar-bg-pink", "avatar-bg-purple" };
                            }
                            @foreach (var user in Model.AvailableUsers)
                            {
                                var modalColorClass = modalColors[user.Id % modalColors.Length];
                                <label class="list-group-item d-flex gap-3 align-items-center p-3 list-group-item-action student-option" style="cursor: pointer;">
                                    <input class="form-check-input flex-shrink-0" type="checkbox" name="SelectedStudentIds" value="@user.Id" style="font-size: 1.2em; border-radius: 6px;">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-initials-circle @modalColorClass me-3 text-white">
                                            @(user.Username?.FirstOrDefault() ?? '?')
                                        </div>
                                        <div>
                                            <h6 class="mb-0 fw-medium">@user.Username</h6>
                                            @if (!string.IsNullOrEmpty(user.Email))
                                            {
                                                <small class="text-muted">@user.Email</small>
                                            }
                                        </div>
                                    </div>
                                </label>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 bg-light rounded-3">
                            <p class="text-muted mb-0">Không có học viên nào khả dụng để thêm.</p>
                        </div>
                    }
                </div>
                <div class="modal-footer border-top-0 pt-0 pb-4 px-4 gap-2">
                    <button type="button" class="btn btn-premium-outline rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-premium-primary rounded-pill px-4 shadow-sm">Xác Nhận Thêm</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Create Group Modal -->
<div class="modal fade" id="createGroupModal" tabindex="-1" aria-labelledby="createGroupModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius: 24px;">
            <form method="post" asp-page-handler="CreateGroups" asp-route-id="@Model.Class.Id">
                <div class="modal-header border-bottom-0 pb-0 pt-4 px-4">
                    <h5 class="modal-title fw-bold text-primary d-flex align-items-center gap-1.5" id="createGroupModalLabel">
                        <span class="material-symbols-outlined">groups</span> Tạo Nhóm Mới
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-4">
                        <label class="form-label fw-bold text-dark">Danh Sách Học Viên Hiện Tại (@(Model.Class.ClassMembers?.Count ?? 0))</label>
                        <div class="list-group list-group-flush border rounded-3" style="max-height: 200px; overflow-y: auto;">
                            @if (Model.Class.ClassMembers != null && Model.Class.ClassMembers.Any())
                            {
                                var grpColors = new[] { "avatar-bg-blue", "avatar-bg-pink", "avatar-bg-purple" };
                                foreach (var member in Model.Class.ClassMembers)
                                {
                                    var grpColorClass = grpColors[member.UserId % grpColors.Length];
                                    <div class="list-group-item d-flex align-items-center gap-3 px-3 py-2 bg-light">
                                        <div class="avatar-initials-circle @grpColorClass text-white" style="width: 30px; height: 30px; font-size: 13px;">
                                            @(member.User?.Username?.FirstOrDefault() ?? '?')
                                        </div>
                                        <div class="d-flex flex-column">
                                            <span class="fw-medium small text-dark mb-0" style="line-height:1.2;">@member.User?.Username</span>
                                            @if (!string.IsNullOrEmpty(member.User?.Email))
                                            {
                                                <span class="text-muted" style="font-size: 0.75rem; line-height:1.2;">@member.User.Email</span>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="p-3 text-center text-muted small">Chưa có học viên nào để chia nhóm.</div>
                            }
                        </div>
                    </div>

                    <p class="text-muted small mb-3">Nhập số lượng nhóm bạn muốn tạo cho lớp học này:</p>
                    <div class="mb-3">
                        <label for="NumberOfGroupsToCreate" class="form-label fw-medium">Số lượng nhóm</label>
                        <input type="number" asp-for="NumberOfGroupsToCreate" class="form-control shadow-sm" min="1" max="6" required style="border-radius: 12px; border-color: var(--color-outline-variant);" />
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0 pb-4 px-4 gap-2">
                    <button type="button" class="btn btn-premium-outline rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-premium-primary rounded-pill px-4 shadow-sm">Xác Nhận Tạo</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function copyInviteCodeDetails(btn, code) {
            navigator.clipboard.writeText(code).then(function() {
                var originalHtml = btn.innerHTML;
                btn.innerHTML = '<span class="material-symbols-outlined" style="color: #34a853; font-size: 18px;">check</span>';
                setTimeout(function() {
                    btn.innerHTML = originalHtml;
                }, 2000);
            }, function(err) {
                console.error('Lỗi khi copy mã: ', err);
            });
        }

        document.addEventListener('DOMContentLoaded', function() {
            const studentSearchInput = document.getElementById('studentSearchInput');
            if (studentSearchInput) {
                studentSearchInput.addEventListener('keyup', function() {
                    const filter = this.value.toLowerCase();
                    const options = document.querySelectorAll('.student-option');

                    options.forEach(function(item) {
                        const text = item.textContent.toLowerCase();
                        if (text.includes(filter)) {
                            item.classList.remove('d-none');
                            item.classList.add('d-flex');
                        } else {
                            item.classList.remove('d-flex');
                            item.classList.add('d-none');
                        }
                    });
                });
            }

            // Tab persistence functionality
            const tabButtons = document.querySelectorAll('[data-bs-toggle="tab"]');
            const activeTabKey = 'classroomActiveTab_' + window.location.pathname;

            // Restore active tab on page load
            const savedTab = localStorage.getItem(activeTabKey);
            if (savedTab) {
                const tabButton = document.getElementById(savedTab);
                if (tabButton) {
                    const tab = new bootstrap.Tab(tabButton);
                    tab.show();
                }
            }

            // Save active tab when changed
            tabButtons.forEach(button => {
                button.addEventListener('shown.bs.tab', function(e) {
                    localStorage.setItem(activeTabKey, this.id);
                });
            });
        });
    </script>

    <!-- Email Notification Modal -->
    <div class="modal fade" id="emailNotificationModal" tabindex="-1" aria-labelledby="emailNotificationModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 12px; background: var(--color-surface-container);">
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold d-flex align-items-center gap-2" id="emailNotificationModalLabel" style="color: var(--color-on-background);">
                        <span class="material-symbols-outlined text-primary">mail</span>
                        Gửi Email Thông Báo - <span id="modalClassName" class="text-primary"></span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body py-4">
                    <form id="emailNotificationForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" id="emailClassId" name="classId" />

                        <!-- Recipient Selection -->
                        <div class="mb-3">
                            <label class="form-label fw-bold small text-uppercase tracking-wider text-muted">Người nhận</label>
                            <div class="d-flex gap-3 mb-2">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="recipientType" id="recipientAll" value="all" checked>
                                    <label class="form-check-label fw-medium" for="recipientAll">
                                        Tất cả học viên
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="recipientType" id="recipientSelect" value="select">
                                    <label class="form-check-label fw-medium" for="recipientSelect">
                                        Chọn học viên cụ thể
                                    </label>
                                </div>
                            </div>

                            <!-- Student List (Hidden by default, shown when recipientSelect is active) -->
                            <div id="studentSelectionContainer" class="border rounded p-3 bg-light" style="display: none; max-height: 200px; overflow-y: auto;">
                                <div class="form-check mb-2 pb-2 border-bottom">
                                    <input class="form-check-input" type="checkbox" id="selectAllStudents">
                                    <label class="form-check-label fw-bold text-dark" for="selectAllStudents">
                                        Chọn tất cả
                                    </label>
                                </div>
                                <div id="studentListContainer">
                                    <!-- Populated via AJAX -->
                                </div>
                            </div>
                        </div>

                        <!-- Subject -->
                        <div class="mb-3">
                            <label for="emailSubject" class="form-label fw-bold small text-uppercase tracking-wider text-muted">Tiêu đề (Subject)</label>
                            <input type="text" class="form-control rounded-3" id="emailSubject" name="subject" placeholder="Nhập tiêu đề thông báo..." required>
                        </div>

                        <!-- Body -->
                        <div class="mb-3">
                            <label for="emailBody" class="form-label fw-bold small text-uppercase tracking-wider text-muted">Nội dung thông báo (Body)</label>
                            <textarea class="form-control rounded-3" id="emailBody" name="body" rows="6" placeholder="Nhập nội dung chi tiết..." required></textarea>
                        </div>
                    </form>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-premium-outline" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" class="btn btn-premium-primary" id="btnSendEmail">
                        <span class="d-flex align-items-center gap-1">
                            <span class="material-symbols-outlined" style="font-size: 18px;">send</span> Gửi Email
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const modal = new bootstrap.Modal(document.getElementById('emailNotificationModal'));
            const modalClassName = document.getElementById('modalClassName');
            const emailClassId = document.getElementById('emailClassId');
            const studentSelectionContainer = document.getElementById('studentSelectionContainer');
            const studentListContainer = document.getElementById('studentListContainer');
            const selectAllStudents = document.getElementById('selectAllStudents');
            const btnSendEmail = document.getElementById('btnSendEmail');
            const form = document.getElementById('emailNotificationForm');

            // Toggle recipient selector list
            document.querySelectorAll('input[name="recipientType"]').forEach(radio => {
                radio.addEventListener('change', function () {
                    if (this.value === 'select') {
                        studentSelectionContainer.style.display = 'block';
                    } else {
                        studentSelectionContainer.style.display = 'none';
                    }
                });
            });

            // Select/Deselect all students checkbox
            selectAllStudents.addEventListener('change', function () {
                document.querySelectorAll('.student-checkbox').forEach(cb => {
                    cb.checked = this.checked;
                });
            });

            // Click "Gửi Email" button
            document.querySelectorAll('.send-email-btn').forEach(btn => {
                btn.addEventListener('click', async function () {
                    const classId = this.dataset.classId;
                    const className = this.dataset.className;

                    modalClassName.textContent = className;
                    emailClassId.value = classId;
                    studentListContainer.innerHTML = '<div class="text-center py-2"><span class="spinner-border spinner-border-sm text-primary"></span> Đang tải...</div>';
                    
                    // Reset form fields
                    document.getElementById('emailSubject').value = '';
                    document.getElementById('emailBody').value = '';
                    document.getElementById('recipientAll').checked = true;
                    studentSelectionContainer.style.display = 'none';
                    selectAllStudents.checked = false;

                    modal.show();

                    try {
                        const res = await fetch(`/Classrooms/Details?handler=ClassMembers&classId=${classId}`);
                        if (!res.ok) throw new Error('HTTP ' + res.status);
                        const students = await res.json();
                        
                        studentListContainer.innerHTML = '';
                        if (!students || students.length === 0) {
                            studentListContainer.innerHTML = '<p class="text-muted small mb-0">Không có học viên nào trong lớp.</p>';
                        } else {
                            students.forEach(student => {
                                const div = document.createElement('div');
                                div.className = 'form-check py-1';
                                div.innerHTML = `
                                    <input class="form-check-input student-checkbox" type="checkbox" value="${student.id}" id="student-${student.id}">
                                    <label class="form-check-label text-dark" for="student-${student.id}">
                                        ${student.username} (${student.email || 'N/A'})
                                    </label>
                                `;
                                studentListContainer.appendChild(div);
                            });
                            
                            // Bind change events to student checkboxes to sync "Select All" status
                            document.querySelectorAll('.student-checkbox').forEach(cb => {
                                cb.addEventListener('change', function () {
                                    const allCbs = document.querySelectorAll('.student-checkbox');
                                    const checkedCbs = document.querySelectorAll('.student-checkbox:checked');
                                    selectAllStudents.checked = allCbs.length === checkedCbs.length;
                                });
                            });
                        }
                    } catch (err) {
                        studentListContainer.innerHTML = '<p class="text-danger small mb-0">Lỗi khi tải danh sách học viên.</p>';
                    }
                });
            });

            // Click "Gửi" button inside modal
            btnSendEmail.addEventListener('click', async function () {
                const classId = emailClassId.value;
                const subject = document.getElementById('emailSubject').value.trim();
                const body = document.getElementById('emailBody').value.trim();
                const isSelect = document.getElementById('recipientSelect').checked;

                if (!subject || !body) {
                    alert('Vui lòng điền đầy đủ tiêu đề và nội dung.');
                    return;
                }

                const selectedStudentIds = [];
                if (isSelect) {
                    document.querySelectorAll('.student-checkbox:checked').forEach(cb => {
                        selectedStudentIds.push(parseInt(cb.value));
                    });
                    if (selectedStudentIds.length === 0) {
                        alert('Vui lòng chọn ít nhất một học viên.');
                        return;
                    }
                }

                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                
                const originalHtml = btnSendEmail.innerHTML;
                btnSendEmail.disabled = true;
                btnSendEmail.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Đang gửi...';

                try {
                    const formData = new FormData();
                    formData.append('classId', classId);
                    formData.append('subject', subject);
                    formData.append('body', body);
                    selectedStudentIds.forEach(id => {
                        formData.append('selectedStudentIds', id);
                    });
                    formData.append('__RequestVerificationToken', token);

                    const res = await fetch('/Classrooms/Details?handler=SendNotification', {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': token
                        },
                        body: formData
                    });

                    if (!res.ok) throw new Error('HTTP ' + res.status);
                    const data = await res.json();
                    
                    if (data.success) {
                        alert(data.message || 'Gửi email thành công!');
                        modal.hide();
                    } else {
                        alert('Gửi email thất bại: ' + (data.message || 'Lỗi không xác định'));
                    }
                } catch (err) {
                    alert('Có lỗi xảy ra: ' + err.message);
                } finally {
                    btnSendEmail.disabled = false;
                    btnSendEmail.innerHTML = originalHtml;
                }
            });
        });
    </script>
}
