@page
@model Flipped_Classroom.Pages.Classrooms.DeleteModel

@{
    ViewData["Title"] = "Delete Classroom";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm" style="border-radius: 15px;">
                <div class="card-header text-white p-4" style="background: linear-gradient(135deg, #ea4335 0%, #d32f2f 100%); border-radius: 15px 15px 0 0;">
                    <h3 class="fw-bold mb-0">Xóa Lớp Học</h3>
                </div>

                <div class="card-body p-5">
                    <h4 class="text-danger mb-4">Bạn có chắc chắn muốn xóa lớp học này không?</h4>
                    <dl class="row mb-5">
                        <dt class="col-sm-3 text-muted">Tên Lớp Học</dt>
                        <dd class="col-sm-9 fw-bold">@Html.DisplayFor(model => model.Class.ClassName)</dd>

                        <dt class="col-sm-3 text-muted">Người Quản Lý</dt>
                        <dd class="col-sm-9">@(Model.Class.Manager?.Username ?? "-")</dd>

                        <dt class="col-sm-3 text-muted">Trạng Thái</dt>
                        <dd class="col-sm-9"><span class="badge bg-light text-primary rounded-pill px-3">@Html.DisplayFor(model => model.Class.Status)</span></dd>
                    </dl>

                    <form method="post">
                        <input type="hidden" asp-for="Class.Id" />
                        <div class="d-flex justify-content-end gap-3 pt-3 border-top">
                            <a asp-page="./Index" class="btn btn-outline-secondary px-4 rounded-pill">Hủy</a>
                            <button type="submit" class="btn btn-danger px-4 rounded-pill shadow-sm" style="border: none;">Xác Nhận Xóa</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
