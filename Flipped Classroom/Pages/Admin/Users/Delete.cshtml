@page "{id:int}"
@model Flipped_Classroom.Pages.Admin.Users.DeleteModel
@{
    ViewData["Title"] = "Xóa tài khoản";
}

<div class="mb-4">
    <a href="/Admin/Users" class="text-decoration-none text-muted d-inline-flex align-items-center gap-1 small fw-medium">
        <i class="bi bi-arrow-left"></i> Quay lại danh sách
    </a>
    <h2 class="fw-bold mt-2 text-danger">Xóa Tài Khoản Hệ Thống</h2>
    <p class="text-muted">Hành động này không thể hoàn tác. Vui lòng kiểm tra kỹ thông tin trước khi thực hiện.</p>
</div>

<div class="row justify-content-start">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-3 overflow-hidden mb-4">
            <div class="bg-danger bg-opacity-10 p-4 border-bottom border-danger border-opacity-10 d-flex align-items-center gap-3">
                <i class="bi bi-exclamation-triangle-fill text-danger fs-3"></i>
                <div>
                    <h5 class="fw-bold text-danger mb-0">Xác nhận xóa người dùng?</h5>
                    <p class="text-muted small mb-0">Tài khoản và các liên kết dữ liệu trực thuộc có thể bị ảnh hưởng.</p>
                </div>
            </div>

            <div class="p-4 bg-white">
                <table class="table table-sm table-borderless my-2">
                    <tbody>
                        <tr>
                            <td class="text-muted fw-semibold py-2" style="width: 150px;">Mã số (ID):</td>
                            <td class="text-dark fw-bold py-2">#@Model.UserToDelete.Id</td>
                        </tr>
                        <tr>
                            <td class="text-muted fw-semibold py-2">Tên tài khoản:</td>
                            <td class="text-dark fw-bold py-2">@Model.UserToDelete.Username</td>
                        </tr>
                        <tr>
                            <td class="text-muted fw-semibold py-2">Họ và tên:</td>
                            <td class="text-dark py-2">@Model.UserToDelete.FirstName @Model.UserToDelete.LastName</td>
                        </tr>
                        <tr>
                            <td class="text-muted fw-semibold py-2">Email:</td>
                            <td class="text-dark py-2">@Model.UserToDelete.Email</td>
                        </tr>
                        <tr>
                            <td class="text-muted fw-semibold py-2">Vai trò:</td>
                            <td class="py-2">
                                <span class="badge bg-secondary bg-opacity-10 text-secondary fw-semibold px-2 py-1">
                                    @Model.UserToDelete.Role
                                </span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="bg-light p-3 d-flex gap-2 justify-content-end border-top">
                <form method="post">
                    <input type="hidden" asp-for="UserToDelete.Id" />
                    <a href="/Admin/Users" class="btn btn-outline-secondary px-4">Hủy bỏ</a>
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="bi bi-trash3-fill"></i> Xác nhận xóa viễn vĩnh
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>