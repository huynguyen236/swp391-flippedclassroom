@page
@model Flipped_Classroom.Pages.Quizzes.DailyReviewModel
@{
    ViewData["Title"] = "Daily Review";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-0 text-dark">Daily Review</h2>
        <p class="text-muted mb-0">Ôn lại các câu bạn hay sai nhất, đến hạn luyện tập hôm nay.</p>
    </div>
    <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2">5 câu / ngày</span>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-check-circle-fill text-success fs-5"></i>
        <div>@TempData["SuccessMessage"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
        <div>@TempData["ErrorMessage"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (Model.ReviewItems.Any())
{
    <form method="post">
        <div class="d-flex flex-column gap-3">
            @{
                var order = 1;
            }
            @foreach (var item in Model.ReviewItems)
            {
                var question = item.Question;
                <div class="card-custom p-4">
                    <div class="d-flex justify-content-between gap-3 mb-3">
                        <div>
                            <h5 class="fw-bold text-dark mb-1">Câu @order</h5>
                            <div class="text-muted small">@question.Node.Class.ClassName - @question.Node.Title</div>
                        </div>
                        <div class="text-end">
                            <span class="badge bg-danger bg-opacity-10 text-danger d-block mb-1">Sai @item.ErrorCount lần</span>
                            <span class="badge bg-info bg-opacity-10 text-info">@question.Category</span>
                        </div>
                    </div>

                    <p class="fw-semibold mb-3">@question.Content</p>

                    @foreach (var option in question.QuestionOptions.OrderBy(o => o.Id))
                    {
                        <label class="d-flex align-items-start gap-2 border rounded-3 p-3 mb-2 bg-light" style="cursor: pointer;">
                            <input class="form-check-input mt-1" type="radio" name="SelectedOptions[@question.Id]" value="@option.Id" required />
                            <span>@option.OptionContent</span>
                        </label>
                    }
                </div>
                order++;
            }
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">
            <a asp-page="/Quizzes/Available" class="btn btn-outline-secondary px-4">Quay lại</a>
            <button type="submit" class="btn btn-custom-primary px-4">
                <i class="bi bi-check2-circle me-1"></i> Nộp Daily Review
            </button>
        </div>
    </form>
}
else
{
    <div class="card-custom text-center py-5 text-muted">
        <i class="bi bi-calendar-check fs-1 d-block mb-2 text-secondary opacity-50"></i>
        Hôm nay chưa có câu nào cần ôn lại.
    </div>
}
