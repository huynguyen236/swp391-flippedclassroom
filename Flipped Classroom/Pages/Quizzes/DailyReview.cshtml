@page
@model Flipped_Classroom.Pages.Quizzes.DailyReviewModel
@{
    ViewData["Title"] = "Daily Review";
}

<div class="container py-5 daily-review-container">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom flex-wrap gap-3">
        <div>
            <h2 class="fw-bold d-flex align-items-center gap-2 mb-1" style="color: var(--color-on-background);">
                <span class="material-symbols-outlined text-primary fs-3">history</span> Daily Review
            </h2>
            <p class="text-muted mb-0 small">Ôn tập các câu hỏi bạn thường làm sai để củng cố kiến thức.</p>
        </div>
        <span class="badge bg-primary-subtle text-primary px-3 py-2 fw-semibold rounded-pill">5 câu / ngày</span>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-check-circle-fill text-success fs-5"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model.ReviewItems.Any())
    {
        <form method="post" id="reviewForm">
            @Html.AntiForgeryToken()
            <div class="d-flex flex-column gap-4">
                @{
                    var order = 1;
                }
                @foreach (var item in Model.ReviewItems)
                {
                    var question = item.Question;
                    <div class="card card-premium p-4 shadow-sm">
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-3 border-bottom pb-2">
                            <div>
                                <h5 class="fw-bold text-primary mb-1">Câu @order</h5>
                                <div class="text-muted small">@question.Node?.Title</div>
                            </div>
                            <div class="text-end d-flex gap-2">
                                <span class="badge bg-danger-subtle text-danger px-2.5 py-1.5 fw-bold rounded-pill">Sai @item.ErrorCount lần</span>
                                <span class="badge bg-info-subtle text-info border px-2.5 py-1.5 fw-bold rounded-pill">@question.Category</span>
                            </div>
                        </div>

                        <p class="fw-bold mb-4 text-dark" style="font-size: 1.05rem;">@question.Content</p>

                        @if (string.Equals(question.QuestionType, "MCQ", StringComparison.OrdinalIgnoreCase))
                        {
                            <div class="d-flex flex-column gap-2">
                                @{
                                    var optionIndex = 0;
                                }
                                @foreach (var option in question.QuestionOptions.OrderBy(o => o.Id))
                                {
                                    var labelCode = char.ConvertFromUtf32(65 + optionIndex);
                                    <label class="d-flex align-items-start gap-2 border rounded-3 p-3 option-label bg-light" style="cursor: pointer; transition: all 0.2s;">
                                        <input class="form-check-input mt-1 option-radio" type="radio" name="SelectedOptions[@question.Id]" value="@option.Id" required />
                                        <span class="fw-bold text-muted me-1">@labelCode.</span>
                                        <span class="text-dark">@option.OptionContent</span>
                                    </label>
                                    optionIndex++;
                                }
                            </div>
                        }
                        else
                        {
                            <input type="text" name="TextAnswers[@question.Id]" class="form-control bg-light option-text-input" placeholder="Nhập câu trả lời của bạn..." required />
                        }
                    </div>
                    order++;
                }
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a asp-page="/Quizzes/Available" class="btn btn-outline-secondary px-4 py-2">Quay lại</a>
                <button type="submit" class="btn btn-primary px-4 py-2 d-flex align-items-center gap-1">
                    <span class="material-symbols-outlined" style="font-size: 20px;">check_circle</span> Nộp Daily Review
                </button>
            </div>
        </form>
    }
    else
    {
        <div class="card card-premium text-center py-5">
            <div class="card-body">
                <span class="material-symbols-outlined text-muted fs-1 mb-2 opacity-50">check_circle</span>
                <h5 class="text-muted fw-bold">Hôm nay chưa có câu nào cần ôn lại</h5>
                <p class="text-muted small">Hãy tiếp tục phát huy kết quả học tập tốt nhé!</p>
            </div>
        </div>
    }
</div>

@section Styles {
    <style>
        .option-label:hover {
            background-color: var(--color-surface-container-high) !important;
            border-color: var(--color-primary) !important;
            transform: translateY(-2px);
        }
        .option-label.checked {
            background-color: var(--color-primary-fixed) !important;
            border-color: var(--color-primary) !important;
            box-shadow: 0 2px 6px rgba(0, 74, 198, 0.1);
        }
    </style>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // MCQ radio checks highlight styling
            const radios = document.querySelectorAll('.option-radio');
            radios.forEach(radio => {
                radio.addEventListener('change', function() {
                    const name = this.getAttribute('name');
                    document.querySelectorAll(`input[name="${name}"]`).forEach(r => {
                        r.closest('.option-label').classList.remove('checked');
                    });
                    this.closest('.option-label').classList.add('checked');
                });
            });
        });
    </script>
}
