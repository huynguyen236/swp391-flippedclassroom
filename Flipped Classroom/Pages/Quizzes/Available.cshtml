@page
@model Flipped_Classroom.Pages.Quizzes.AvailableModel
@{
    ViewData["Title"] = "Bài test của tôi";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-0 text-dark">Bài Test Của Tôi</h2>
        <p class="text-muted mb-0">Các bài test đã được phát hành cho lớp bạn đang tham gia.</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-check-circle-fill text-success fs-5"></i>
        <div>@TempData["SuccessMessage"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-3">
    @if (Model.Quizzes.Any())
    {
        foreach (var quiz in Model.Quizzes)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card card-flat rounded-4 p-4 h-100">
                    <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                        <div>
                            <h5 class="fw-bold text-dark mb-1">@quiz.Title</h5>
                            <div class="text-muted small">@(quiz.Class?.ClassName ?? quiz.Node?.Class?.ClassName) - @quiz.Node?.Title</div>
                        </div>
                        <span class="badge bg-success bg-opacity-10 text-success fw-semibold px-2 py-1">Published</span>
                    </div>

                    <div class="d-flex gap-3 text-muted small mb-3">
                        <span><i class="bi bi-list-check me-1"></i>@quiz.QuizQuestions.Count câu</span>
                        <span><i class="bi bi-clock me-1"></i>@quiz.DurationMinutes phút</span>
                    </div>

                    <a asp-page="/Quizzes/Take" asp-route-id="@quiz.Id" class="btn btn-outline-primary w-100">
                        <i class="bi bi-play-circle me-1"></i> Làm bài
                    </a>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="card card-flat rounded-4 text-center py-5 text-muted">
                <i class="bi bi-journal-x fs-1 d-block mb-2 text-secondary opacity-50"></i>
                Chưa có bài test nào được phát hành.
            </div>
        </div>
    }
</div>
