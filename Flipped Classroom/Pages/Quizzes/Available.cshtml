@page
@model Flipped_Classroom.Pages.Quizzes.AvailableModel
@{
    ViewData["Title"] = "Bài test của tôi";
}

<div class="container py-5 student-quizzes-container">
    <!-- Title Area -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom flex-wrap gap-3">
        <div>
            <h2 class="fw-bold d-flex align-items-center gap-2 mb-1" style="color: var(--color-on-background);">
                <span class="material-symbols-outlined text-primary fs-3">assignment</span> Bài Test Của Tôi
            </h2>
            <p class="text-muted mb-0 small">Các bài test đã được phát hành cho lớp bạn đang tham gia.</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-2" role="alert" style="background-color: rgba(40, 167, 69, 0.08); border: 1px solid rgba(40, 167, 69, 0.15);">
            <span class="material-symbols-outlined text-success">check_circle</span>
            <div class="text-success-emphasis fw-medium">@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-2" role="alert" style="background-color: rgba(186, 26, 26, 0.08); border: 1px solid rgba(186, 26, 26, 0.15);">
            <span class="material-symbols-outlined text-danger">warning</span>
            <div class="text-danger-emphasis fw-medium">@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        @if (Model.Quizzes.Any())
        {
            foreach (var quiz in Model.Quizzes)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="card card-premium h-100 d-flex flex-column justify-content-between">
                        <div class="p-4">
                            <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                                <div>
                                    <h5 class="fw-bold text-dark mb-1">@quiz.Title</h5>
                                    <div class="text-muted small">@(quiz.Class?.ClassName ?? quiz.Node?.Class?.ClassName) - @quiz.Node?.Title</div>
                                </div>
                                <span class="badge bg-success-subtle text-success fw-bold px-2.5 py-1.5 rounded-pill" style="font-size: 0.75rem;">Đã mở</span>
                            </div>

                            <div class="d-flex gap-3 text-muted small mb-0 pt-2 border-top" style="font-size: 0.8rem;">
                                <span class="d-flex align-items-center gap-1">
                                    <span class="material-symbols-outlined text-muted" style="font-size: 16px;">list_alt</span> @quiz.QuizQuestions.Count câu
                                </span>
                                <span class="d-flex align-items-center gap-1">
                                    <span class="material-symbols-outlined text-muted" style="font-size: 16px;">schedule</span> @quiz.DurationMinutes phút
                                </span>
                            </div>
                        </div>

                        <div class="px-4 pb-4 pt-0">
                            <a asp-page="/Quizzes/Take" asp-route-id="@quiz.Id" class="btn btn-primary w-100 d-flex align-items-center justify-content-center gap-1 py-2">
                                <span class="material-symbols-outlined" style="font-size: 18px;">play_arrow</span> Làm bài test
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <h5 class="text-muted fw-bold">Chưa có bài test nào được phát hành</h5>
                <p class="text-muted small">Bài test cho các lớp của bạn sẽ xuất hiện tại đây khi giảng viên phát hành.</p>
            </div>
        }
    </div>
</div>
