@page
@model Flipped_Classroom.Pages.Quizzes.RandomizeModel
@{
    ViewData["Title"] = "Tạo bài test ngẫu nhiên";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-0 text-dark">Tạo Bài Test Ngẫu Nhiên</h2>
        <p class="text-muted mb-0">Chọn bài học, phân loại kiến thức và số câu để hệ thống tự trộn đề từ ngân hàng câu hỏi.</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-check-circle-fill text-success fs-5"></i>
        <div>@TempData["SuccessMessage"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
        <div>@TempData["ErrorMessage"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card-custom p-4">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Input.Title" class="form-label fw-semibold">Tên bài test</label>
                    <input asp-for="Input.Title" class="form-control bg-light" maxlength="200" placeholder="VD: Grammar N5 - Mini test 01" required />
                    <span asp-validation-for="Input.Title" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    @if (User.IsInRole("Teacher"))
                    {
                        <label asp-for="Input.ClassId" class="form-label fw-semibold">Lớp học</label>
                        <select asp-for="Input.ClassId" asp-items="Model.ClassOptions" class="form-select bg-light" required>
                            <option value="">Chọn lớp học</option>
                        </select>
                    }
                    else
                    {
                        <label asp-for="Input.ClassId" class="form-label fw-semibold">Lớp học (để trống nếu tạo Template)</label>
                        <select asp-for="Input.ClassId" asp-items="Model.ClassOptions" class="form-select bg-light">
                            <option value="">Chọn lớp học</option>
                        </select>
                    }
                    <span asp-validation-for="Input.ClassId" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.NodeId" class="form-label fw-semibold">Bài học</label>
                    <select asp-for="Input.NodeId" asp-items="Model.NodeOptions" class="form-select bg-light" id="nodeSelect" required>
                        <option value="">Chọn bài học</option>
                    </select>
                    <span asp-validation-for="Input.NodeId" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Category" class="form-label fw-semibold">Phân loại kiến thức</label>
                    <select asp-for="Input.Category" class="form-select bg-light" id="categorySelect" required>
                        <option value="">Chọn phân loại</option>
                        <option value="All">Tất cả (All)</option>
                        <option value="Vocabulary">Từ vựng (Vocabulary)</option>
                        <option value="Grammar">Ngữ pháp (Grammar)</option>
                        <option value="Kanji">Chữ Hán (Kanji)</option>
                        <option value="Keigo">Kính ngữ (Keigo)</option>
                    </select>
                    <span asp-validation-for="Input.Category" class="text-danger small"></span>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Input.QuestionCount" class="form-label fw-semibold">Số lượng câu</label>
                        <input asp-for="Input.QuestionCount" class="form-control bg-light" type="number" min="1" max="100" required />
                        <span asp-validation-for="Input.QuestionCount" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Input.DurationMinutes" class="form-label fw-semibold">Thời gian (phút)</label>
                        <input asp-for="Input.DurationMinutes" class="form-control bg-light" type="number" min="1" max="300" required />
                        <span asp-validation-for="Input.DurationMinutes" class="text-danger small"></span>
                    </div>
                </div>

                <div class="alert alert-info border-0 rounded-3 mt-3 mb-3 py-2 d-flex align-items-center gap-2">
                    <i class="bi bi-database-check"></i>
                    <span>Hiện có <strong id="availableCount">@(Model.AvailableQuestionCount?.ToString() ?? "-")</strong> câu phù hợp.</span>
                </div>

                <div class="form-check form-switch mb-4">
                    <input asp-for="Input.PublishNow" class="form-check-input" type="checkbox" role="switch" />
                    <label asp-for="Input.PublishNow" class="form-check-label fw-semibold">Phát hành ngay cho học viên trong lớp</label>
                </div>
                <input type="hidden" asp-for="IsStrictMode" />

                <button type="submit" class="btn btn-custom-primary w-100 d-flex align-items-center justify-content-center gap-2">
                    <i class="bi bi-shuffle"></i>
                    Tạo bài test
                </button>
            </form>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card-custom overflow-hidden">
            <div class="p-4 border-bottom">
                <h5 class="fw-bold mb-0">Bài test gần đây</h5>
            </div>
            <div class="table-responsive">
                <table class="table align-middle table-hover mb-0">
                    <thead class="table-light text-muted fw-semibold" style="font-size: 0.85rem;">
                        <tr>
                            <th class="ps-4">Tên bài test</th>
                            <th>Bài học</th>
                            <th class="text-center">Câu</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentQuizzes.Any())
                        {
                            foreach (var quiz in Model.RecentQuizzes)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-semibold text-dark">@quiz.Title</div>
                                        <div class="text-muted small">@quiz.DurationMinutes phút</div>
                                    </td>
                                    <td>
                                        <div class="text-dark">@quiz.Node?.Title</div>
                                        <div class="text-muted small">@quiz.Node?.Class?.ClassName</div>
                                    </td>
                                    <td class="text-center fw-semibold">@quiz.QuizQuestions.Count</td>
                                    <td>
                                        @if (quiz.Status == "Published")
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success fw-semibold px-2 py-1">Published</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary fw-semibold px-2 py-1">Draft</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5 text-muted">
                                    <i class="bi bi-journal-x fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                    Chưa có bài test nào.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const nodeSelect = document.getElementById('nodeSelect');
        const categorySelect = document.getElementById('categorySelect');
        const availableCount = document.getElementById('availableCount');

        async function updateAvailability() {
            const nodeId = nodeSelect.value;
            const category = categorySelect.value;

            if (!nodeId || !category) {
                availableCount.textContent = '-';
                return;
            }

            const response = await fetch(`?handler=Availability&nodeId=${encodeURIComponent(nodeId)}&category=${encodeURIComponent(category)}`);
            const data = await response.json();
            availableCount.textContent = data.count;
        }

        nodeSelect.addEventListener('change', updateAvailability);
        categorySelect.addEventListener('change', updateAvailability);
        updateAvailability();
    </script>
}

