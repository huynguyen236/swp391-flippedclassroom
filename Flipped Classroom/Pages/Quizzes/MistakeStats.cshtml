@page
@model Flipped_Classroom.Pages.Quizzes.MistakeStatsModel
@{
    ViewData["Title"] = "Thống kê lỗi sai";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-0 text-dark">Thống Kê Lỗi Sai</h2>
        <p class="text-muted mb-0">Tổng hợp các câu học viên làm sai nhiều nhất theo lớp.</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-check-circle-fill text-success fs-5"></i>
        <div>@TempData["SuccessMessage"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card-custom p-4 mb-4">
    <form method="get" class="row g-3 align-items-end">
        <div class="col-md-6 col-lg-4">
            <label asp-for="ClassId" class="form-label fw-semibold">Lớp học</label>
            <select asp-for="ClassId" asp-items="Model.ClassOptions" class="form-select bg-light">
                <option value="">Tất cả lớp</option>
            </select>
        </div>
        <div class="col-md-auto">
            <button type="submit" class="btn btn-outline-primary px-4">
                <i class="bi bi-filter me-1"></i> Lọc
            </button>
        </div>
    </form>
</div>

<div class="card-custom overflow-hidden">
    <div class="table-responsive">
        <table class="table align-middle table-hover mb-0">
            <thead class="table-light text-muted fw-semibold" style="font-size: 0.85rem;">
                <tr>
                    <th class="ps-4">Câu hỏi</th>
                    <th>Lớp / Bài học</th>
                    <th>Phân loại</th>
                    <th class="text-center">Học viên sai</th>
                    <th class="text-center">Tổng lượt sai</th>
                    <th class="text-center">Tỷ lệ</th>
                    <th class="text-end pe-4" style="width: 80px;"></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Statistics.Any())
                {
                    foreach (var item in Model.Statistics)
                    {
                        <tr class="cursor-pointer" style="cursor: pointer;"
                            onclick="window.location='@Url.Page("/Quizzes/MistakeDetail", new { questionId = item.QuestionId, returnClassId = Model.ClassId })'">
                            <td class="ps-4">
                                <div class="fw-semibold text-dark text-truncate" style="max-width: 420px;" title="@item.QuestionContent">
                                    #@item.QuestionId - @item.QuestionContent
                                </div>
                            </td>
                            <td>
                                <div class="text-dark">@item.ClassName</div>
                                <div class="text-muted small">@item.NodeTitle</div>
                            </td>
                            <td><span class="badge bg-info bg-opacity-10 text-info">@item.Category</span></td>
                            <td class="text-center fw-semibold">@item.WrongStudentCount / @item.ClassStudentCount</td>
                            <td class="text-center fw-semibold">@item.TotalMistakeCount</td>
                            <td class="text-center">
                                <span class="badge bg-danger bg-opacity-10 text-danger px-2 py-1">@item.WrongStudentPercent%</span>
                            </td>
                            <td class="text-end pe-4 text-muted">
                                <i class="bi bi-chevron-right"></i>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-clipboard-data fs-1 d-block mb-2 text-secondary opacity-50"></i>
                            Chưa có dữ liệu lỗi sai.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
