@page
@model Flipped_Classroom.Pages.Quizzes.MistakeStatsModel
@{
    ViewData["Title"] = "Thống kê lỗi sai";
}

<div class="container py-5 mistake-stats-container">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom flex-wrap gap-3">
        <div>
            <h2 class="fw-bold d-flex align-items-center gap-2 mb-1" style="color: var(--color-on-background);">
                <span class="material-symbols-outlined text-primary fs-3">bar_chart</span> Thống Kê Lỗi Sai
            </h2>
            <p class="text-muted mb-0 small">Tổng hợp các câu học viên làm sai nhiều nhất theo lớp.</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-check-circle-fill text-success fs-5"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filter Card -->
    <div class="card card-premium p-4 mb-4">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-6 col-lg-4">
                <label asp-for="ClassId" class="form-label fw-semibold text-secondary small">Lớp học</label>
                <select asp-for="ClassId" asp-items="Model.ClassOptions" class="form-select bg-light" style="height: 45px;">
                </select>
            </div>
            <div class="col-md-auto">
                <button type="submit" class="btn btn-outline-primary px-4 d-flex align-items-center justify-content-center gap-1" style="height: 45px;">
                    <span class="material-symbols-outlined" style="font-size: 18px;">filter_alt</span> Lọc kết quả
                </button>
            </div>
        </form>
    </div>

    <!-- Table Stats -->
    <div class="card card-premium overflow-hidden">
        <div class="table-responsive">
            <table class="table align-middle table-hover mb-0">
                <thead>
                    <tr class="table-light text-muted fw-semibold" style="font-size: 0.85rem;">
                        <th class="ps-4 py-3 border-0">Câu hỏi</th>
                        <th class="py-3 border-0">Lớp / Bài học</th>
                        <th class="py-3 border-0">Phân loại</th>
                        <th class="py-3 border-0 text-center">Học viên sai</th>
                        <th class="py-3 border-0 text-center">Tổng lượt sai</th>
                        <th class="py-3 border-0 text-center">Tỷ lệ</th>
                        <th class="pe-4 py-3 border-0 text-end" style="width: 80px;"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Statistics.Any())
                    {
                        foreach (var item in Model.Statistics)
                        {
                            <tr class="cursor-pointer border-bottom" style="cursor: pointer;"
                                onclick="window.location='@Url.Page("/Quizzes/MistakeDetail", new { questionId = item.QuestionId, returnClassId = Model.ClassId })'">
                                <td class="ps-4 py-3">
                                    <div class="fw-bold text-dark text-truncate" style="max-width: 420px;" title="@item.QuestionContent">
                                        #@item.QuestionId - @item.QuestionContent
                                    </div>
                                </td>
                                <td class="py-3">
                                    <div class="fw-semibold text-dark">@item.ClassName</div>
                                    <div class="text-muted small">@item.NodeTitle</div>
                                </td>
                                <td class="py-3"><span class="badge bg-info-subtle text-info border px-2.5 py-1.5 rounded-pill">@item.Category</span></td>
                                <td class="text-center fw-bold py-3">@item.WrongStudentCount / @item.ClassStudentCount</td>
                                <td class="text-center fw-bold py-3 text-danger">@item.TotalMistakeCount</td>
                                <td class="text-center py-3">
                                    <span class="badge bg-danger-subtle text-danger px-2.5 py-1.5 rounded-pill fw-bold">@item.WrongStudentPercent%</span>
                                </td>
                                <td class="text-end pe-4 py-3 text-muted">
                                    <span class="material-symbols-outlined align-middle" style="font-size: 18px;">chevron_right</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <span class="material-symbols-outlined text-muted fs-1 mb-2 opacity-50">data_exploration</span>
                                <h6 class="text-muted fw-bold">Chưa có dữ liệu lỗi sai.</h6>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
